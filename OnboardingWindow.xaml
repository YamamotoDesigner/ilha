<Window x:Class="Ilha.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Ilha"
        Title="Ilha" Width="820" Height="580" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WinBg}" Foreground="{DynamicResource WinFg}"
        FontFamily="{DynamicResource UiFont}" FontSize="13.5"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Grayscale" TextOptions.TextHintingMode="Fixed">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" GlassFrameThickness="0" ResizeBorderThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Cartão de escolha (idioma, tema, estilo) -->
        <Style x:Key="Pick" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource WinFg}"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value><ScaleTransform/></Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="Frame" CornerRadius="14" Background="{DynamicResource CardBg}"
                                    BorderBrush="{DynamicResource Line}" BorderThickness="1.5" Padding="12">
                                <ContentPresenter/>
                            </Border>
                            <Border x:Name="Check" Width="20" Height="20" CornerRadius="6" Background="{DynamicResource Accent}"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,9,9,0" Opacity="0">
                                <local:Glyph Data="{StaticResource IcoCheck}" Size="14" Thickness="3" Foreground="#111111"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Text3}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="Check" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Recurso liga/desliga -->
        <Style x:Key="Feature" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource WinFg}"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Frame" CornerRadius="12" Background="{DynamicResource CardBg}"
                                BorderBrush="{DynamicResource Line}" BorderThickness="1.5" Padding="12,10">
                            <DockPanel>
                                <Border x:Name="Box" DockPanel.Dock="Right" Width="20" Height="20" CornerRadius="6"
                                        BorderBrush="{DynamicResource Text3}" BorderThickness="1.5" VerticalAlignment="Center">
                                    <local:Glyph x:Name="Tick" Data="{StaticResource IcoCheck}" Size="14" Thickness="3"
                                                 Foreground="#111111" Opacity="0"/>
                                </Border>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="Tick" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PickTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="2,10,0,0"/>
        </Style>
        <Style x:Key="PickHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource Text2}"/>
            <Setter Property="Margin" Value="2,2,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <!-- Mini "tela" das prévias -->
        <Style x:Key="Mini" TargetType="Border">
            <Setter Property="Height" Value="74"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#3B4C8C" Offset="0"/>
                        <GradientStop Color="#7A4A9C" Offset="0.6"/>
                        <GradientStop Color="#2E7A8C" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="200"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Palco: uma "tela" com a ilha animada ── -->
        <Border ClipToBounds="True">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop x:Name="StageA" Color="#26335F" Offset="0"/>
                    <GradientStop x:Name="StageB" Color="#5B3A7E" Offset="0.55"/>
                    <GradientStop x:Name="StageC" Color="#1F5C6B" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <!-- Bolhas de cor flutuando devagar -->
                <Canvas IsHitTestVisible="False">
                    <Ellipse x:Name="BlobA" Width="260" Height="260" Canvas.Left="60" Canvas.Top="-40" Opacity="0.45">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#FF8FB1" Offset="0"/>
                                <GradientStop Color="#00FF8FB1" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                        <Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse x:Name="BlobB" Width="300" Height="300" Canvas.Left="480" Canvas.Top="-20" Opacity="0.4">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#7CE3A1" Offset="0"/>
                                <GradientStop Color="#007CE3A1" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                        <Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform>
                    </Ellipse>
                </Canvas>

                <!-- A ilha de demonstração -->
                <Border x:Name="DemoIsland" Width="130" Height="30" VerticalAlignment="Top" HorizontalAlignment="Center"
                        CornerRadius="0,0,12,12" Background="#000000" ClipToBounds="True">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.35"/>
                    </Border.Effect>
                    <Grid>
                        <!-- Recolhida: capa + barrinhas -->
                        <Grid x:Name="DemoMini" Height="30" VerticalAlignment="Top" Margin="10,0">
                            <Border Width="18" Height="18" CornerRadius="5" HorizontalAlignment="Left">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FF8FB1" Offset="0"/>
                                        <GradientStop Color="#7A5CFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <StackPanel x:Name="DemoBars" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <!-- Prévia ao vivo no passo "O que você quer na ilha?": abas escolhidas + conteúdo -->
                        <Grid x:Name="DemoPreview" Opacity="0" Margin="16,8,16,12" IsHitTestVisible="False">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="26"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="PreviewClock" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"
                                       HorizontalAlignment="Left"/>
                            <Border x:Name="PreviewTabsHost" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    CornerRadius="9" Padding="2">
                                <StackPanel x:Name="PreviewTabs" Orientation="Horizontal"/>
                            </Border>
                            <Border x:Name="PreviewBody" Grid.Row="1" Margin="0,10,0,0"/>
                        </Grid>
                        <!-- Aberta: música + mini agenda -->
                        <Grid x:Name="DemoFull" Opacity="0" Margin="16,14,16,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="62" Height="62" CornerRadius="12" VerticalAlignment="Top">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FF8FB1" Offset="0"/>
                                        <GradientStop Color="#7A5CFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,4,12,0">
                                <TextBlock x:Name="DemoSong" Text="Sunset Drive" FontWeight="SemiBold" FontSize="13.5" Foreground="#FFFFFF"/>
                                <TextBlock x:Name="DemoArtist" Text="Ilha FM" FontSize="12" Foreground="#A6FFFFFF" Margin="0,2,0,0"/>
                                <Grid Margin="0,14,0,0" Height="4">
                                    <Border CornerRadius="2" Background="#33FFFFFF"/>
                                    <Border x:Name="DemoProgress" CornerRadius="2" Background="#FFFFFF" HorizontalAlignment="Left" Width="40"/>
                                </Grid>
                            </StackPanel>
                            <Border Grid.Column="2" Width="86" CornerRadius="10" Background="#14FFFFFF" Padding="8,6">
                                <StackPanel>
                                    <TextBlock x:Name="DemoDay" Text="SEG" FontSize="10" FontWeight="SemiBold" Foreground="#7CE3A1"/>
                                    <TextBlock Text="15" FontSize="26" FontWeight="Light" Foreground="#FFFFFF" Margin="0,-2,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <Button Style="{StaticResource CloseButton}" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,10,10,0" Foreground="#CCFFFFFF" Click="Skip_Click">
                    <local:Glyph Data="{StaticResource IcoClose}" Size="13"/>
                </Button>
            </Grid>
        </Border>

        <!-- ── Passos ── -->
        <Grid x:Name="StepHost" Grid.Row="1" Margin="40,24,40,0">

            <!-- 0: boas-vindas + idioma -->
            <StackPanel x:Name="Step0">
                <TextBlock x:Name="WelcomeTitle" FontSize="26" FontWeight="SemiBold"/>
                <TextBlock x:Name="WelcomeText" FontSize="14" Foreground="{DynamicResource Text2}" Margin="0,6,0,18" TextWrapping="Wrap"/>
                <UniformGrid Columns="2" Margin="-6,0">
                    <RadioButton x:Name="PickPt" Style="{StaticResource Pick}" GroupName="Lang" Checked="Lang_Checked">
                        <DockPanel>
                            <Border Width="38" Height="28" CornerRadius="7" Background="#14A04A" Margin="0,0,12,0">
                                <TextBlock Text="BR" Foreground="White" FontWeight="Bold" FontSize="12"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Português" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="Brasil" Style="{StaticResource PickHint}"/>
                            </StackPanel>
                        </DockPanel>
                    </RadioButton>
                    <RadioButton x:Name="PickEn" Style="{StaticResource Pick}" GroupName="Lang" Checked="Lang_Checked">
                        <DockPanel>
                            <Border Width="38" Height="28" CornerRadius="7" Background="#2D5BD3" Margin="0,0,12,0">
                                <TextBlock Text="US" Foreground="White" FontWeight="Bold" FontSize="12"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="English" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="United States" Style="{StaticResource PickHint}"/>
                            </StackPanel>
                        </DockPanel>
                    </RadioButton>
                </UniformGrid>
            </StackPanel>

            <!-- 1: claro ou escuro -->
            <StackPanel x:Name="Step1" Visibility="Collapsed">
                <TextBlock x:Name="ThemeTitle" FontSize="26" FontWeight="SemiBold"/>
                <TextBlock x:Name="ThemeText" FontSize="14" Foreground="{DynamicResource Text2}" Margin="0,6,0,18" TextWrapping="Wrap"/>
                <UniformGrid Columns="2" Margin="-6,0">
                    <RadioButton x:Name="PickDark" Style="{StaticResource Pick}" GroupName="Theme" Checked="Theme_Checked">
                        <StackPanel>
                            <Border Style="{StaticResource Mini}">
                                <Border Width="140" Height="30" CornerRadius="0,0,10,10" VerticalAlignment="Top" Background="#000000">
                                    <Border Width="44" Height="5" CornerRadius="2.5" Background="#7CE3A1"/>
                                </Border>
                            </Border>
                            <TextBlock x:Name="DarkTitle" Style="{StaticResource PickTitle}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="PickLight" Style="{StaticResource Pick}" GroupName="Theme" Checked="Theme_Checked">
                        <StackPanel>
                            <Border Style="{StaticResource Mini}">
                                <Border Width="140" Height="30" CornerRadius="0,0,10,10" VerticalAlignment="Top" Background="#F7F7FA">
                                    <Border Width="44" Height="5" CornerRadius="2.5" Background="#2B2B30"/>
                                </Border>
                            </Border>
                            <TextBlock x:Name="LightTitle" Style="{StaticResource PickTitle}"/>
                        </StackPanel>
                    </RadioButton>
                </UniformGrid>
            </StackPanel>

            <!-- 2: estilo da ilha -->
            <StackPanel x:Name="Step2" Visibility="Collapsed">
                <TextBlock x:Name="StyleTitle" FontSize="26" FontWeight="SemiBold"/>
                <TextBlock x:Name="StyleText" FontSize="14" Foreground="{DynamicResource Text2}" Margin="0,6,0,18" TextWrapping="Wrap"/>
                <UniformGrid Columns="3" Margin="-6,0">
                    <RadioButton x:Name="PickAttached" Style="{StaticResource Pick}" GroupName="Style" Checked="Style_Checked">
                        <StackPanel>
                            <Border Style="{StaticResource Mini}">
                                <Border Width="100" Height="24" CornerRadius="0,0,9,9" VerticalAlignment="Top" Background="#000000"/>
                            </Border>
                            <TextBlock x:Name="AttachedTitle" Style="{StaticResource PickTitle}"/>
                            <TextBlock x:Name="AttachedHint" Style="{StaticResource PickHint}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="PickTop" Style="{StaticResource Pick}" GroupName="Style" Checked="Style_Checked">
                        <StackPanel>
                            <Border Style="{StaticResource Mini}">
                                <Border Width="100" Height="24" CornerRadius="9" Margin="0,9,0,0" VerticalAlignment="Top" Background="#000000"/>
                            </Border>
                            <TextBlock x:Name="TopTitle" Style="{StaticResource PickTitle}"/>
                            <TextBlock x:Name="TopHint" Style="{StaticResource PickHint}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="PickFree" Style="{StaticResource Pick}" GroupName="Style" Checked="Style_Checked">
                        <StackPanel>
                            <Border Style="{StaticResource Mini}">
                                <Border Width="100" Height="24" CornerRadius="9" Margin="22,30,0,0" HorizontalAlignment="Left"
                                        VerticalAlignment="Top" Background="#000000"/>
                            </Border>
                            <TextBlock x:Name="FreeTitle" Style="{StaticResource PickTitle}"/>
                            <TextBlock x:Name="FreeHint" Style="{StaticResource PickHint}"/>
                        </StackPanel>
                    </RadioButton>
                </UniformGrid>
            </StackPanel>

            <!-- 3: recursos -->
            <StackPanel x:Name="Step3" Visibility="Collapsed">
                <TextBlock x:Name="FeaturesTitle" FontSize="26" FontWeight="SemiBold"/>
                <TextBlock x:Name="FeaturesText" FontSize="14" Foreground="{DynamicResource Text2}" Margin="0,6,0,14" TextWrapping="Wrap"/>
                <UniformGrid x:Name="FeatureGrid" Columns="4" Margin="-5,0"/>
            </StackPanel>

            <!-- 4: pronto -->
            <StackPanel x:Name="Step4" Visibility="Collapsed">
                <TextBlock x:Name="DoneTitle" FontSize="26" FontWeight="SemiBold"/>
                <TextBlock x:Name="DoneText" FontSize="14" Foreground="{DynamicResource Text2}" Margin="0,6,0,18" TextWrapping="Wrap"/>
                <StackPanel x:Name="Tips"/>
            </StackPanel>
        </Grid>

        <!-- ── Rodapé: progresso e botões ── -->
        <DockPanel Grid.Row="2" Margin="40,0,40,28">
            <Button x:Name="NextButton" DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Padding="22,9"
                    Click="Next_Click" MinWidth="120"/>
            <Button x:Name="BackButton" DockPanel.Dock="Right" Style="{StaticResource SoftButton}" Padding="18,9"
                    Margin="0,0,10,0" Click="Back_Click"/>
            <StackPanel x:Name="Dots" Orientation="Horizontal" VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</Window>
