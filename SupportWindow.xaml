<Window x:Class="Ilha.SupportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Ilha"
        Title="{local:T 'Apoie o Ilha'}" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WinBg}" Foreground="{DynamicResource WinFg}"
        FontFamily="{DynamicResource UiFont}" FontSize="13.5"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Grayscale" TextOptions.TextHintingMode="Fixed">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" GlassFrameThickness="0" ResizeBorderThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Linha de uma lista agrupada: ícone discreto, texto e seta -->
        <Style x:Key="ListRow" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource WinFg}"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Border x:Name="Hover" Background="{DynamicResource Ink_FF}" Opacity="0" Margin="4,3"
                                    CornerRadius="8" IsHitTestVisible="False"/>
                            <DockPanel Margin="14,0,12,0" Height="42">
                                <local:Glyph DockPanel.Dock="Right" Data="{StaticResource IcoChevronRight}" Size="13"
                                             Foreground="{DynamicResource Text3}" VerticalAlignment="Center"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </DockPanel>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="0.05"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="0.09"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RowIcon" TargetType="local:Glyph">
            <Setter Property="Size" Value="16"/>
            <Setter Property="Foreground" Value="{DynamicResource Text2}"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="RowDivider" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="42,0,0,0"/>
            <Setter Property="Background" Value="{DynamicResource Line}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Button Style="{StaticResource CloseButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,12,0"
                Click="Close_Click" ToolTip="{local:T 'Fechar'}" WindowChrome.IsHitTestVisibleInChrome="True">
            <local:Glyph Data="{StaticResource IcoClose}" Size="14"/>
        </Button>

        <StackPanel Margin="32,40,32,28">
            <TextBlock Text="{local:T 'Apoie o Ilha'}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <TextBlock Foreground="{DynamicResource Text2}" Margin="0,8,0,0" TextWrapping="Wrap" TextAlignment="Center"
                       Text="{local:T 'O Ilha é gratuito e feito por uma pessoa só. Se ele ajuda no seu dia, um Pix de qualquer valor mantém o projeto andando.'}"/>

            <!-- Pix -->
            <StackPanel x:Name="PixCard" Margin="0,24,0,0">
                <Border Background="White" CornerRadius="14" Padding="12" HorizontalAlignment="Center">
                    <Image x:Name="QrImage" Width="168" Height="168" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                </Border>
                <TextBlock x:Name="ReceiverText" HorizontalAlignment="Center" Margin="0,12,0,0"
                           Foreground="{DynamicResource Text3}" FontSize="12"/>
                <Button x:Name="CopyButton" Style="{StaticResource AccentButton}" Margin="0,16,0,0" Padding="0,9"
                        HorizontalAlignment="Stretch" Click="Copy_Click">
                    <TextBlock x:Name="CopyText" Text="{local:T 'Copiar código Pix'}"/>
                </Button>
                <TextBox x:Name="CodeBox" IsReadOnly="True" TextWrapping="NoWrap" FontSize="11" Margin="0,8,0,0"
                         FontFamily="Cascadia Mono, Consolas" Visibility="Collapsed"/>
            </StackPanel>

            <!-- Outras formas de ajudar: uma lista simples -->
            <Border Margin="0,24,0,0" CornerRadius="12" Background="{DynamicResource CardBg}"
                    BorderBrush="{DynamicResource Line}" BorderThickness="1">
                <StackPanel>
                    <Button Style="{StaticResource ListRow}" Tag="https://github.com/YamamotoDesigner/ilha" Click="Link_Click">
                        <StackPanel Orientation="Horizontal">
                            <local:Glyph Style="{StaticResource RowIcon}" Data="{StaticResource IcoStar}"/>
                            <TextBlock Text="{local:T 'Dar uma estrela no GitHub'}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Border Style="{StaticResource RowDivider}"/>
                    <Button x:Name="ShareButton" Style="{StaticResource ListRow}" Click="Share_Click">
                        <StackPanel Orientation="Horizontal">
                            <local:Glyph Style="{StaticResource RowIcon}" Data="{StaticResource IcoShare}"/>
                            <TextBlock x:Name="ShareText" Text="{local:T 'Indicar para um amigo'}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Border Style="{StaticResource RowDivider}"/>
                    <Button Style="{StaticResource ListRow}" Tag="https://github.com/YamamotoDesigner/ilha/issues/new?title=Problema%3A%20"
                            Click="Link_Click">
                        <StackPanel Orientation="Horizontal">
                            <local:Glyph Style="{StaticResource RowIcon}" Data="{StaticResource IcoBug}"/>
                            <TextBlock Text="{local:T 'Relatar um problema'}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Border Style="{StaticResource RowDivider}"/>
                    <Button Style="{StaticResource ListRow}" Tag="https://github.com/YamamotoDesigner/ilha/issues/new?title=Ideia%3A%20"
                            Click="Link_Click">
                        <StackPanel Orientation="Horizontal">
                            <local:Glyph Style="{StaticResource RowIcon}" Data="{StaticResource IcoBulb}"/>
                            <TextBlock Text="{local:T 'Sugerir uma ideia'}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Border Style="{StaticResource RowDivider}"/>
                    <Button Style="{StaticResource ListRow}" Tag="https://yamamotodesigner.github.io/ilha/" Click="Link_Click">
                        <StackPanel Orientation="Horizontal">
                            <local:Glyph Style="{StaticResource RowIcon}" Data="{StaticResource IcoGlobe}"/>
                            <TextBlock Text="{local:T 'Conhecer o site'}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Window>
