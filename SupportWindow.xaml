<Window x:Class="Ilha.SupportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Apoiar o Ilha" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" ThemeMode="System"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <StackPanel Margin="32,24,32,28">
        <TextBlock Text="&#xEB51;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="30"
                   Foreground="#F472B6" HorizontalAlignment="Center"/>
        <TextBlock Text="Ajude o Ilha a continuar" FontSize="22" FontWeight="SemiBold"
                   HorizontalAlignment="Center" Margin="0,10,0,6"/>
        <TextBlock TextWrapping="Wrap" TextAlignment="Center" Opacity="0.75" FontSize="14">
            O Ilha é gratuito e feito por uma pessoa só. Se ele facilita o seu dia,
            qualquer valor via Pix ajuda a manter o projeto e a trazer novos recursos. Obrigado! 💚
        </TextBlock>

        <Border Background="White" CornerRadius="16" Padding="14" Margin="0,22,0,0"
                HorizontalAlignment="Center">
            <Image x:Name="QrImage" Width="220" Height="220" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
        </Border>
        <TextBlock x:Name="ReceiverText" HorizontalAlignment="Center" Margin="0,10,0,0" Opacity="0.7" FontSize="13"/>
        <TextBlock Text="Abra o app do seu banco → Pix → Ler QR code" HorizontalAlignment="Center"
                   Opacity="0.55" FontSize="12" Margin="0,2,0,0"/>

        <TextBlock Text="Ou use o Pix copia e cola:" Margin="0,20,0,6" FontSize="13"/>
        <TextBox x:Name="CodeBox" IsReadOnly="True" TextWrapping="NoWrap" FontSize="12"
                 FontFamily="Cascadia Mono, Consolas"/>
        <Button x:Name="CopyButton" Content="Copiar código Pix" Click="Copy_Click" Margin="0,10,0,0"
                HorizontalAlignment="Stretch" Padding="0,9" Style="{StaticResource AccentButtonStyle}"/>

        <TextBlock HorizontalAlignment="Center" Margin="0,18,0,0" FontSize="13" Opacity="0.75">
            Sem grana? Uma estrela no
            <Hyperlink NavigateUri="https://github.com/YamamotoDesigner/ilha" RequestNavigate="Link_Navigate">GitHub</Hyperlink>
            também ajuda muito.
        </TextBlock>
    </StackPanel>
</Window>
