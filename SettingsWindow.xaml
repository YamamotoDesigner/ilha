<Window x:Class="Ilha.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Ilha"
        Title="Configurações do Ilha" Width="860" Height="620" MinWidth="720" MinHeight="460"
        WindowStartupLocation="CenterScreen" ThemeMode="Dark"
        Background="#121214" Foreground="#F5F5F7"
        FontFamily="{DynamicResource UiFont}" FontSize="13.5"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Grayscale">

    <!-- Sem a barra de título do Windows: a janela inteira é desenhada pelo Ilha -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" GlassFrameThickness="0" ResizeBorderThickness="6"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#7CE3A1"/>

        <!-- Título de grupo -->
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Text3}"/>
            <Setter Property="Margin" Value="4,22,0,8"/>
        </Style>

        <Style x:Key="Group" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
        </Style>

        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="16,0,0,0"/>
            <Setter Property="Background" Value="{StaticResource Line}"/>
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource Text3}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="4,8,4,0"/>
        </Style>

        <!-- Item da barra lateral -->
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="GroupName" Value="Nav"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource Text2}"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="Sel" CornerRadius="9" Background="{DynamicResource Accent}" Opacity="0"/>
                            <Border x:Name="Hover" CornerRadius="9" Background="White" Opacity="0"/>
                            <DockPanel Margin="10,0">
                                <Border x:Name="IconBox" Width="22" Height="22" CornerRadius="6" Background="#26FFFFFF"
                                        VerticalAlignment="Center">
                                    <local:Glyph Data="{TemplateBinding Tag}" Size="14"/>
                                </Border>
                                <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="0.05"/>
                                <Setter Property="Foreground" Value="#F5F5F7"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Sel" Property="Opacity" Value="0.16"/>
                                <Setter TargetName="IconBox" Property="Background" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="IconBox" Property="TextElement.Foreground" Value="#111111"/>
                                <Setter Property="Foreground" Value="#F5F5F7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Linha com interruptor à direita -->
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#F5F5F7"/>
            <Setter Property="Padding" Value="16,11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <DockPanel>
                                <Border x:Name="Track" DockPanel.Dock="Right" Width="40" Height="23" CornerRadius="7"
                                        Background="#3A3A40" Margin="12,0,0,0">
                                    <Border x:Name="Knob" Width="19" Height="19" CornerRadius="5" Background="White"
                                            HorizontalAlignment="Left" Margin="2,0,0,0">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="5" ShadowDepth="1" Direction="270" Opacity="0.35"/>
                                        </Border.Effect>
                                        <Border.RenderTransform>
                                            <TranslateTransform/>
                                        </Border.RenderTransform>
                                    </Border>
                                </Border>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource Accent}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Knob" Duration="0:0:0.22"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                             To="17">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase EasingMode="EaseOut" Amplitude="0.25"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Knob" Duration="0:0:0.22"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                             To="0">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase EasingMode="EaseOut" Amplitude="0.25"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cartão de escolha com prévia desenhada (Vidro/Sólido, Colada/Flutuante, Lateral/Topo) -->
        <Style x:Key="ChoiceCard" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#F5F5F7"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="Width" Value="170"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="Frame" CornerRadius="13" Background="{StaticResource CardBg}"
                                    BorderBrush="{StaticResource Line}" BorderThickness="1.5" Padding="8,8,8,10">
                                <ContentPresenter/>
                            </Border>
                            <Border x:Name="Hover" CornerRadius="13" Background="White" Opacity="0" IsHitTestVisible="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="0.03"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Preview" TargetType="Border">
            <Setter Property="Height" Value="70"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#2B3A67" Offset="0"/>
                        <GradientStop Color="#4B2E6B" Offset="0.55"/>
                        <GradientStop Color="#1E4D5C" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChoiceLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="2,9,0,0"/>
        </Style>
        <Style x:Key="ChoiceHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{StaticResource Text3}"/>
            <Setter Property="Margin" Value="2,1,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- Controle deslizante: trilho fino e puxador quadrado de cantos suaves -->
        <Style x:Key="SliderFill" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent">
                            <Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderFill}" Command="Slider.DecreaseLarge"
                                              Background="{DynamicResource Accent}"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderFill}" Command="Slider.IncreaseLarge"
                                              Background="#3A3A40"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="Knob" Width="18" Height="18" CornerRadius="5" Background="White">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="5" ShadowDepth="1" Direction="270" Opacity="0.4"/>
                                                </Border.Effect>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="Knob" Property="Width" Value="22"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SliderRow" TargetType="Grid">
            <Setter Property="Margin" Value="16,9"/>
        </Style>
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="Foreground" Value="{StaticResource Text2}"/>
            <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
        </Style>

        <Style x:Key="Swatch" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Rectangle x:Name="Ring" Stroke="#40FFFFFF" StrokeThickness="1" RadiusX="7" RadiusY="7"
                                   Fill="{TemplateBinding Background}"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="StrokeThickness" Value="2.5"/>
                                <Setter TargetName="Ring" Property="Stroke" Value="#B3FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ── Barra lateral ── -->
        <Border Background="#18181B" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,16,14,16">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,2,0,22">
                    <Image Source="pack://application:,,,/Ilha.ico" Width="34" Height="34"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Ilha" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock x:Name="VersionText" FontSize="11.5" Foreground="{StaticResource Text3}"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock DockPanel.Dock="Bottom" Text="Feito com carinho no Brasil" FontSize="11"
                           Foreground="{StaticResource Text3}" Margin="8,0,0,0"/>
                <Button DockPanel.Dock="Bottom" Style="{StaticResource SoftButton}" Margin="0,0,0,12"
                        HorizontalContentAlignment="Left" Padding="10,9" Click="Support_Click">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="22" Height="22" CornerRadius="6" Background="#33FF5C7C">
                            <local:Glyph Data="{StaticResource IcoHeart}" Filled="True" Size="13" Foreground="#FF5C7C"/>
                        </Border>
                        <TextBlock Text="Apoie o Ilha" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <StackPanel>
                    <RadioButton Style="{StaticResource NavItem}" Content="Geral" Tag="{StaticResource IcoSettings}"
                                 x:Name="NavGeneral" IsChecked="True" Checked="Nav_Checked"/>
                    <RadioButton Style="{StaticResource NavItem}" Content="Aparência" Tag="{StaticResource IcoPalette}"
                                 x:Name="NavLook" Checked="Nav_Checked"/>
                    <RadioButton Style="{StaticResource NavItem}" Content="Ilha e posição" Tag="{StaticResource IcoIsland}"
                                 x:Name="NavIsland" Checked="Nav_Checked"/>
                    <RadioButton Style="{StaticResource NavItem}" Content="Recursos" Tag="{StaticResource IcoGrid}"
                                 x:Name="NavFeatures" Checked="Nav_Checked"/>
                    <RadioButton Style="{StaticResource NavItem}" Content="Avisos" Tag="{StaticResource IcoBell}"
                                 x:Name="NavAlerts" Checked="Nav_Checked"/>
                    <RadioButton Style="{StaticResource NavItem}" Content="Atualizações" Tag="{StaticResource IcoRefresh}"
                                 x:Name="NavUpdates" Checked="Nav_Checked"/>
                    <RadioButton Style="{StaticResource NavItem}" Content="Sobre" Tag="{StaticResource IcoInfo}"
                                 x:Name="NavAbout" Checked="Nav_Checked"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ── Conteúdo ── -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel Margin="32,18,12,0">
                <Button DockPanel.Dock="Right" Style="{StaticResource CloseButton}" VerticalAlignment="Top"
                        Click="Close_Click" ToolTip="Fechar">
                    <local:Glyph Data="{StaticResource IcoClose}" Size="14"/>
                </Button>
                <StackPanel Margin="0,10,0,0">
                    <TextBlock x:Name="PageTitle" Text="Geral" FontSize="24" FontWeight="SemiBold"/>
                    <TextBlock x:Name="PageSubtitle" FontSize="13" Foreground="{StaticResource Text2}" Margin="0,3,0,0"/>
                </StackPanel>
            </DockPanel>

            <ScrollViewer x:Name="PageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                <Grid Margin="32,0,32,32" MaxWidth="640">

                    <!-- ═══ Geral ═══ -->
                    <StackPanel x:Name="PageGeneral" Tag="Como a ilha se comporta no dia a dia.">
                        <TextBlock Text="ABRIR E FECHAR" Style="{StaticResource Section}"/>
                        <Border Style="{StaticResource Group}">
                            <StackPanel>
                                <Grid Style="{StaticResource SliderRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Atraso para abrir" Style="{StaticResource RowLabel}"/>
                                    <Slider x:Name="HoverSlider" Grid.Column="1" Minimum="0" Maximum="1000" TickFrequency="50"
                                            IsSnapToTickEnabled="True" Value="{Binding HoverDelayMs}"/>
                                    <TextBlock Grid.Column="2" Style="{StaticResource Value}"
                                               Text="{Binding Value, ElementName=HoverSlider, StringFormat={}{0:0} ms}"/>
                                </Grid>
                                <Border Style="{StaticResource Divider}"/>
                                <Grid Style="{StaticResource SliderRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Atraso para fechar" Style="{StaticResource RowLabel}"/>
                                    <Slider x:Name="CollapseSlider" Grid.Column="1" Minimum="100" Maximum="2000" TickFrequency="50"
                                            IsSnapToTickEnabled="True" Value="{Binding CollapseDelayMs}"/>
                                    <TextBlock Grid.Column="2" Style="{StaticResource Value}"
                                               Text="{Binding Value, ElementName=CollapseSlider, StringFormat={}{0:0} ms}"/>
                                </Grid>
                                <Border Style="{StaticResource Divider}"/>
                                <CheckBox Style="{StaticResource Switch}" Content="Atalho Ctrl + Alt + N abre e fecha" IsChecked="{Binding HotkeyEnabled}"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="TELA" Style="{StaticResource Section}"/>
                        <Border Style="{StaticResource Group}">
                            <StackPanel>
                                <DockPanel Margin="16,9">
                                    <TextBlock Text="Monitor" Width="180" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="MonitorCombo" DisplayMemberPath="Label" SelectedValuePath="Device"
                                              SelectedValue="{Binding MonitorDevice}"/>
                                </DockPanel>
                                <Border Style="{StaticResource Divider}"/>
                                <CheckBox Style="{StaticResource Switch}" Content="Esconder com app em tela cheia" IsChecked="{Binding HideOnFullscreen}"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource Hint}" Text="Com a ilha flutuante, ela fica no monitor para onde você arrastar."/>

                        <TextBlock Text="RELÓGIO" Style="{StaticResource Section}"/>
                        <Border Style="{StaticResource Group}">
                            <StackPanel>
                                <CheckBox Style="{StaticResource Switch}" Content="Formato de 24 horas" IsChecked="{Binding Use24h}"/>
                                <Border Style="{StaticResource Divider}"/>
                                <CheckBox Style="{StaticResource Switch}" Content="Mostrar segundos" IsChecked="{Binding ShowSeconds}"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="SISTEMA" Style="{StaticResource Section}"/>
                        <Border Style="{StaticResource Group}">
                            <CheckBox x:Name="StartupCheck" Style="{StaticResource Switch}" Content="Abrir o Ilha ao ligar o computador"
                                      Click="StartupCheck_Click"/>
                        </Border>
                    </StackPanel>

                    <!-- ═══ Aparência ═══ -->
                    <StackPanel x:Name="PageLook" Visibility="Collapsed" Tag="Material, cores e sombra da ilha.">
                        <TextBlock Text="MATERIAL" Style="{StaticResource Section}"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="GlassRadio" Style="{StaticResource ChoiceCard}" GroupName="Material"
                                         Checked="Material_Checked">
                                <StackPanel>
                                    <Border Style="{StaticResource Preview}">
                                        <Grid>
                                            <Ellipse Width="60" Height="60" Fill="#E0607A" Margin="-60,-20,0,0" Opacity="0.8"/>
                                            <Ellipse Width="50" Height="50" Fill="#F2B34A" Margin="70,30,0,0" Opacity="0.8"/>
                                            <Border Width="110" Height="26" CornerRadius="0,0,9,9" VerticalAlignment="Top"
                                                    Background="#66101014" BorderBrush="#40FFFFFF" BorderThickness="1,0,1,1"/>
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="Vidro" Style="{StaticResource ChoiceLabel}"/>
                                    <TextBlock Text="Desfoca o que está atrás" Style="{StaticResource ChoiceHint}"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="SolidRadio" Style="{StaticResource ChoiceCard}" GroupName="Material"
                                         Checked="Material_Checked">
                                <StackPanel>
                                    <Border Style="{StaticResource Preview}">
                                        <Grid>
                                            <Ellipse Width="60" Height="60" Fill="#E0607A" Margin="-60,-20,0,0" Opacity="0.8"/>
                                            <Ellipse Width="50" Height="50" Fill="#F2B34A" Margin="70,30,0,0" Opacity="0.8"/>
                                            <Border Width="110" Height="26" CornerRadius="0,0,9,9" VerticalAlignment="Top"
                                                    Background="#0A0A0C"/>
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="Sólido" Style="{StaticResource ChoiceLabel}"/>
                                    <TextBlock Text="Cor cheia, sem transparência" Style="{StaticResource ChoiceHint}"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                        <Border Style="{StaticResource Group}" Margin="0,12,0,0">
                            <Grid Style="{StaticResource SliderRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Intensidade da cor" Style="{StaticResource RowLabel}"/>
                                <Slider x:Name="TintSlider" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="1"
                                        IsSnapToTickEnabled="True" Value="{Binding GlassTint}"/>
                                <TextBlock Grid.Column="2" Style="{StaticResource Value}"
                                           Text="{Binding Value, ElementName=TintSlider, StringFormat={}{0:0}%}"/>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="MaterialHint" Style="{StaticResource Hint}"/>

                        <TextBlock Text="CORES" Style="{StaticResource Section}"/>
                        <Border Style="{StaticResource Group}">
                            <StackPanel>
                                <DockPanel Margin="16,10">
                                    <TextBlock Text="Ilha" Width="110" VerticalAlignment="Center"/>
                                    <TextBox x:Name="IslandColorBox" DockPanel.Dock="Right" Width="92"
                                             Text="{Binding IslandColor, UpdateSourceTrigger=PropertyChanged}"/>
                                    <StackPanel x:Name="IslandSwatches" Orientation="Horizontal" VerticalAlignment="Center"/>
                                </DockPanel>
                                <Border Style="{StaticResource Divider}"/>
                                <DockPanel Margin="16,10">
                                    <TextBlock Text="Destaque" Width="110" VerticalAlignment="Center"/>
                                    <TextBox x:Name="AccentColorBox" DockPanel.Dock="Right" Width="92"
                                             Text="{Binding AccentColor, UpdateSourceTrigger=PropertyChanged}"/>
                                    <StackPanel x:Name="AccentSwatches" Orientation="Horizontal" VerticalAlignment="Center"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="DETALHES" Style="{StaticResource Section}"/>
                        <Border Style="{StaticResource Group}">
                            <StackPanel>
                                <CheckBox Style="{StaticResource Switch}" Content="Sombra (modo sólido e ilha flutuante)" IsChecked="{Binding ShowShadow}"/>
                                <Border Style="{StaticResource Divider}"/>
                                <CheckBox Style="{StaticResource Switch}" Content="Animação com efeito de mola" IsChecked="{Binding SpringAnimation}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ═══ Ilha e posição ═══ -->
                    <StackPanel x:Name="PageIsland" Visibility="Collapsed" Tag="Onde a ilha fica, onde ficam as abas e o tamanho dela.">
                        <TextBlock Text="ESTILO" Style="{StaticResource Section}"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="AttachedRadio" Style="{StaticResource ChoiceCard}" GroupName="IslandStyle"
                                         Checked="IslandStyle_Checked">
                                <StackPanel>
                                    <Border Style="{StaticResource Preview}">
                                        <Border Width="96" Height="22" CornerRadius="0,0,8,8" VerticalAlignment="Top"
                                                Background="#0A0A0C"/>
                                    </Border>
                                    <TextBlock Text="Colada no topo" Style="{StaticResource ChoiceLabel}"/>
                                    <TextBlock Text="Presa na borda da tela" Style="{StaticResource ChoiceHint}"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="FloatingRadio" Style="{StaticResource ChoiceCard}" GroupName="IslandStyle"
                                         Checked="IslandStyle_Checked">
                                <StackPanel>
                                    <Border Style="{StaticResource Preview}">
                                        <Border Width="96" Height="22" CornerRadius="8" Margin="18,20,0,0"
                                                HorizontalAlignment="Left" VerticalAlignment="Top" Background="#0A0A0C">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="10" ShadowDepth="3" Direction="270" Opacity="0.5"/>
                                            </Border.Effect>
                                        </Border>
                                    </Border>
                                    <TextBlock Text="Flutuante" Style="{StaticResource ChoiceLabel}"/>
                                    <TextBlock Text="Solta, arraste para onde quiser" Style="{StaticResource ChoiceHint}"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                        <Border x:Name="FloatOptions" Style="{StaticResource Group}" Margin="0,12,0,0">
                            <StackPanel>
                                <CheckBox x:Name="FloatLockCheck" Style="{StaticResource Switch}" Content="Fixar posição (não deixa arrastar)"
                                          IsChecked="{Binding FloatLocked}"/>
                                <Border Style="{StaticResource Divider}"/>
                                <DockPanel Margin="16,9">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource SoftButton}" Padding="12,5"
                                            Content="Centralizar" Click="CenterIsland_Click"/>
                                    <TextBlock Text="Voltar para o centro, no topo da tela" VerticalAlignment="Center"/>
                                </DockPanel>
                                <Border Style="{StaticResource Divider}"/>
                                <DockPanel Margin="16,9">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource SoftButton}" Padding="12,5"
                                            Content="Restaurar" Click="DefaultSize_Click"/>
                                    <TextBlock Text="Tamanho padrão da ilha aberta" VerticalAlignment="Center"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="FloatHint" Style="{StaticResource Hint}"
                                   Text="Para mover: segure a ilha pelo cabeçalho (onde fica o relógio) e arraste. Para mudar o tamanho: arraste o cantinho de baixo, à direita. O alfinete na ilha fixa e solta."/>

                        <TextBlock Text="ABAS" Style="{StaticResource Section}"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="SideTabsRadio" Style="{StaticResource ChoiceCard}" GroupName="Tabs"
                                         Checked="Tabs_Checked">
                                <StackPanel>
                                    <Border Style="{StaticResource Preview}">
                                        <Border Width="120" Height="52" CornerRadius="9" Background="#0A0A0C" Padding="7">
                                            <StackPanel HorizontalAlignment="Left">
                                                <Border Width="9" Height="7" CornerRadius="2" Background="{DynamicResource Accent}" Margin="0,0,0,3"/>
                                                <Border Width="9" Height="7" CornerRadius="2" Background="#4DFFFFFF" Margin="0,0,0,3"/>
                                                <Border Width="9" Height="7" CornerRadius="2" Background="#4DFFFFFF" Margin="0,0,0,3"/>
                                                <Border Width="9" Height="7" CornerRadius="2" Background="#4DFFFFFF"/>
                                            </StackPanel>
                                        </Border>
                                    </Border>
                                    <TextBlock Text="Na lateral" Style="{StaticResource ChoiceLabel}"/>
                                    <TextBlock Text="Coluna de ícones à esquerda" Style="{StaticResource ChoiceHint}"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="TopTabsRadio" Style="{StaticResource ChoiceCard}" GroupName="Tabs"
                                         Checked="Tabs_Checked">
                                <StackPanel>
                                    <Border Style="{StaticResource Preview}">
                                        <Border Width="120" Height="52" CornerRadius="9" Background="#0A0A0C" Padding="7">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top">
                                                <Border Width="10" Height="7" CornerRadius="2" Background="{DynamicResource Accent}" Margin="0,0,3,0"/>
                                                <Border Width="10" Height="7" CornerRadius="2" Background="#4DFFFFFF" Margin="0,0,3,0"/>
                                                <Border Width="10" Height="7" CornerRadius="2" Background="#4DFFFFFF" Margin="0,0,3,0"/>
                                                <Border Width="10" Height="7" CornerRadius="2" Background="#4DFFFFFF"/>
                                            </StackPanel>
                                        </Border>
                                    </Border>
                                    <TextBlock Text="No topo" Style="{StaticResource ChoiceLabel}"/>
                                    <TextBlock Text="Barra de ícones no cabeçalho" Style="{StaticResource ChoiceHint}"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>

                        <TextBlock Text="FORMA E TAMANHO" Style="{StaticResource Section}"/>
                        <Border Style="{StaticResource Group}">
                            <StackPanel>
                                <Grid Style="{StaticResource SliderRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Tamanho geral" Style="{StaticResource RowLabel}"/>
                                    <Slider x:Name="ScaleSlider" Grid.Column="1" Minimum="0.7" Maximum="1.5" TickFrequency="0.05"
                                            IsSnapToTickEnabled="True" Value="{Binding Scale}"/>
                                    <TextBlock Grid.Column="2" Style="{StaticResource Value}"
                                               Text="{Binding Value, ElementName=ScaleSlider, StringFormat={}{0:P0}}"/>
                                </Grid>
                                <Border Style="{StaticResource Divider}"/>
                                <Grid Style="{StaticResource SliderRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Arredondamento" Style="{StaticResource RowLabel}"/>
                                    <Slider x:Name="RadiusSlider" Grid.Column="1" Minimum="0" Maximum="36" TickFrequency="1"
                                            IsSnapToTickEnabled="True" Value="{Binding CornerRadius}"/>
                                    <TextBlock Grid.Column="2" Style="{StaticResource Value}"
                                               Text="{Binding Value, ElementName=RadiusSlider, StringFormat={}{0:0} px}"/>
                                </Grid>
                                <Border Style="{StaticResource Divider}"/>
                                <Grid Style="{StaticResource SliderRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Largura recolhida" Style="{StaticResource RowLabel}"/>
                                    <Slider x:Name="CWidthSlider" Grid.Column="1" Minimum="100" Maximum="360" TickFrequency="5"
                                            IsSnapToTickEnabled="True" Value="{Binding CollapsedWidth}"/>
                                    <TextBlock Grid.Column="2" Style="{StaticResource Value}"
                                               Text="{Binding Value, ElementName=CWidthSlider, StringFormat={}{0:0} px}"/>
                                </Grid>
                                <Border Style="{StaticResource Divider}"/>
                                <Grid Style="{StaticResource SliderRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Altura recolhida" Style="{StaticResource RowLabel}"/>
                                    <Slider x:Name="CHeightSlider" Grid.Column="1" Minimum="20" Maximum="48" TickFrequency="1"
                                            IsSnapToTickEnabled="True" Value="{Binding CollapsedHeight}"/>
                                    <TextBlock Grid.Column="2" Style="{StaticResource Value}"
                                               Text="{Binding Value, ElementName=CHeightSlider, StringFormat={}{0:0} px}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ═══ Recursos ═══ -->
                    <StackPanel x:Name="PageFeatures" Visibility="Collapsed" Tag="Escolha o que aparece dentro da ilha.">
                        <TextBlock Text="INÍCIO" Style="{StaticResource Section}"/>
                        <Border Style="{StaticResource Group}">
                            <StackPanel>
                                <CheckBox Style="{StaticResource Switch}" Content="Controles de mídia" IsChecked="{Binding ShowMedia}"/>
                                <Border Style="{StaticResource Divider}"/>
                                <CheckBox Style="{StaticResource Switch}" Content="Monitor do sistema (CPU e memória)" IsChecked="{Binding ShowStats}"/>
                                <Border Style="{StaticResource Divider}"/>
                                <CheckBox Style="{StaticResource Switch}" Content="Prateleira de arquivos" IsChecked="{Binding ShowShelf}"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="PRODUTIVIDADE" Style="{StaticResource Section}"/>
                        <Border Style="{StaticResource Group}">
                            <StackPanel>
                                <CheckBox Style="{StaticResource Switch}" Content="Agenda e tarefas" IsChecked="{Binding ShowCalendar}"/>
                                <Border Style="{StaticResource Divider}"/>
                                <CheckBox Style="{StaticResource Switch}" Content="Notas" IsChecked="{Binding ShowNotes}"/>
                                <Border Style="{StaticResource Divider}"/>
                                <CheckBox Style="{StaticResource Switch}" Content="Foco (timer)" IsChecked="{Binding ShowTimer}"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="FERRAMENTAS" Style="{StaticResource Section}"/>
                        <Border Style="{StaticResource Group}">
                            <StackPanel>
                                <CheckBox Style="{StaticResource Switch}" Content="Histórico da área de transferência" IsChecked="{Binding ShowClipboard}"/>
                                <Border Style="{StaticResource Divider}"/>
                                <Grid Style="{StaticResource SliderRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Itens no histórico" Style="{StaticResource RowLabel}"/>
                                    <Slider x:Name="ClipMaxSlider" Grid.Column="1" Minimum="5" Maximum="100" TickFrequency="5"
                                            IsSnapToTickEnabled="True" Value="{Binding ClipboardMax}"/>
                                    <TextBlock Grid.Column="2" Style="{StaticResource Value}"
                                               Text="{Binding Value, ElementName=ClipMaxSlider, StringFormat={}{0:0}}"/>
                                </Grid>
                                <Border Style="{StaticResource Divider}"/>
                                <CheckBox Style="{StaticResource Switch}" Content="Espelho (câmera)" IsChecked="{Binding ShowMirror}"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="A câmera só liga enquanto a aba Espelho está aberta, e nada é gravado. O histórico fica só na memória."/>
                    </StackPanel>

                    <!-- ═══ Avisos ═══ -->
                    <StackPanel x:Name="PageAlerts" Visibility="Collapsed" Tag="O que a ilha mostra quando está recolhida.">
                        <TextBlock Text="AVISOS RÁPIDOS" Style="{StaticResource Section}"/>
                        <Border Style="{StaticResource Group}">
                            <StackPanel>
                                <CheckBox Style="{StaticResource Switch}" Content="Volume ao mudar" IsChecked="{Binding LiveVolume}"/>
                                <Border Style="{StaticResource Divider}"/>
                                <CheckBox Style="{StaticResource Switch}" Content="Carregador conectado ou desconectado" IsChecked="{Binding LiveCharging}"/>
                                <Border Style="{StaticResource Divider}"/>
                                <CheckBox Style="{StaticResource Switch}" Content="Música nova começando" IsChecked="{Binding LiveTrack}"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource Hint}" Text="A ilha recolhida cresce por um instante para mostrar o aviso."/>

                        <TextBlock Text="ILHA RECOLHIDA" Style="{StaticResource Section}"/>
                        <Border Style="{StaticResource Group}">
                            <StackPanel>
                                <CheckBox Style="{StaticResource Switch}" Content="Capa da música tocando" IsChecked="{Binding CollapsedShowArt}"/>
                                <Border Style="{StaticResource Divider}"/>
                                <CheckBox Style="{StaticResource Switch}" Content="Equalizador animado" IsChecked="{Binding CollapsedShowEqualizer}"/>
                                <Border Style="{StaticResource Divider}"/>
                                <CheckBox Style="{StaticResource Switch}" Content="Contagem do timer" IsChecked="{Binding CollapsedShowTimer}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ═══ Atualizações ═══ -->
                    <StackPanel x:Name="PageUpdates" Visibility="Collapsed" Tag="O Ilha se atualiza sozinho, sem perder nada.">
                        <TextBlock Text="VERSÕES" Style="{StaticResource Section}"/>
                        <Border Style="{StaticResource Group}">
                            <StackPanel>
                                <CheckBox Style="{StaticResource Switch}" Content="Verificar automaticamente" IsChecked="{Binding AutoCheckUpdates}"/>
                                <Border Style="{StaticResource Divider}"/>
                                <DockPanel Margin="16,11">
                                    <Button x:Name="CheckUpdatesButton" DockPanel.Dock="Right" Style="{StaticResource AccentButton}"
                                            Content="Verificar agora" Click="CheckUpdates_Click"/>
                                    <TextBlock x:Name="UpdateStatus" VerticalAlignment="Center" TextWrapping="Wrap"
                                               Foreground="{StaticResource Text2}" Margin="0,0,12,0"
                                               Text="Novas versões são instaladas com um clique."/>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="A única conexão com a internet é esta verificação. Configurações, notas e tarefas ficam no seu PC."/>
                    </StackPanel>

                    <!-- ═══ Sobre ═══ -->
                    <StackPanel x:Name="PageAbout" Visibility="Collapsed" Tag="O topo da sua tela, finalmente útil.">
                        <Border Style="{StaticResource Group}" Margin="0,22,0,0" Padding="20">
                            <DockPanel>
                                <Image Source="pack://application:,,,/Ilha.ico" Width="56" Height="56"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Ilha" FontSize="20" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="AboutVersion" Foreground="{StaticResource Text2}" Margin="0,2,0,0"/>
                                    <TextBlock Text="Gratuito e feito por uma pessoa só. Se ele te ajuda, considere apoiar."
                                               Foreground="{StaticResource Text3}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button x:Name="SupportButton" Style="{StaticResource AccentButton}" Click="Support_Click" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <local:Glyph Data="{StaticResource IcoHeart}" Filled="True" Size="13" Margin="0,0,7,0"/>
                                    <TextBlock Text="Apoiar o projeto"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SoftButton}" Content="Restaurar padrões" Click="Reset_Click" Margin="0,0,10,0"/>
                            <Button Style="{StaticResource SoftButton}" Content="Sair do Ilha" Click="Quit_Click"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Margin="4,14,4,0"
                                   Text="Restaurar padrões volta a aparência e o comportamento ao original, mas mantém notas, tarefas e arquivos da prateleira."/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
