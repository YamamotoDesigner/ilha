<Window x:Class="Ilha.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurações — Ilha" Width="560" Height="760" MinWidth="460" MinHeight="400"
        WindowStartupLocation="CenterScreen" ThemeMode="System"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <Window.Resources>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,22,0,10"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Width" Value="190"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="Width" Value="60"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Opacity" Value="0.7"/>
        </Style>
        <Style x:Key="Row" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,4"/>
        </Style>
        <Style x:Key="Swatch" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="14"
                                BorderBrush="#66808080" BorderThickness="1"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="B" Property="BorderBrush" Value="#FF808080"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,8,28,28">

            <!-- ── Aparência ── -->
            <TextBlock Text="Aparência" Style="{StaticResource Section}"/>

            <TextBlock Text="Cor da ilha"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,4">
                <StackPanel x:Name="IslandSwatches" Orientation="Horizontal"/>
                <TextBox x:Name="IslandColorBox" Width="110" Margin="4,0,0,0"
                         Text="{Binding IslandColor, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <TextBlock Text="Cor de destaque" Margin="0,12,0,0"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,8">
                <StackPanel x:Name="AccentSwatches" Orientation="Horizontal"/>
                <TextBox x:Name="AccentColorBox" Width="110" Margin="4,0,0,0"
                         Text="{Binding AccentColor, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <DockPanel Style="{StaticResource Row}">
                <TextBlock Text="Tamanho geral" Style="{StaticResource Label}"/>
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Value}"
                           Text="{Binding Value, ElementName=ScaleSlider, StringFormat={}{0:P0}}"/>
                <Slider x:Name="ScaleSlider" Minimum="0.7" Maximum="1.5" TickFrequency="0.05"
                        IsSnapToTickEnabled="True" Value="{Binding Scale}"/>
            </DockPanel>
            <DockPanel Style="{StaticResource Row}">
                <TextBlock Text="Arredondamento" Style="{StaticResource Label}"/>
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Value}"
                           Text="{Binding Value, ElementName=RadiusSlider, StringFormat={}{0:0} px}"/>
                <Slider x:Name="RadiusSlider" Minimum="0" Maximum="36" TickFrequency="1"
                        IsSnapToTickEnabled="True" Value="{Binding CornerRadius}"/>
            </DockPanel>
            <DockPanel Style="{StaticResource Row}">
                <TextBlock Text="Largura recolhida" Style="{StaticResource Label}"/>
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Value}"
                           Text="{Binding Value, ElementName=CWidthSlider, StringFormat={}{0:0} px}"/>
                <Slider x:Name="CWidthSlider" Minimum="100" Maximum="360" TickFrequency="5"
                        IsSnapToTickEnabled="True" Value="{Binding CollapsedWidth}"/>
            </DockPanel>
            <DockPanel Style="{StaticResource Row}">
                <TextBlock Text="Altura recolhida" Style="{StaticResource Label}"/>
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Value}"
                           Text="{Binding Value, ElementName=CHeightSlider, StringFormat={}{0:0} px}"/>
                <Slider x:Name="CHeightSlider" Minimum="20" Maximum="48" TickFrequency="1"
                        IsSnapToTickEnabled="True" Value="{Binding CollapsedHeight}"/>
            </DockPanel>
            <CheckBox Content="Sombra" IsChecked="{Binding ShowShadow}" Margin="0,8,0,0"/>
            <CheckBox Content="Animação com efeito de mola" IsChecked="{Binding SpringAnimation}" Margin="0,6,0,0"/>

            <!-- ── Ilha recolhida ── -->
            <TextBlock Text="Ilha recolhida" Style="{StaticResource Section}"/>
            <CheckBox Content="Mostrar capa da música tocando" IsChecked="{Binding CollapsedShowArt}"/>
            <CheckBox Content="Mostrar equalizador animado" IsChecked="{Binding CollapsedShowEqualizer}" Margin="0,6,0,0"/>
            <CheckBox Content="Mostrar contagem do timer" IsChecked="{Binding CollapsedShowTimer}" Margin="0,6,0,0"/>

            <!-- ── Recursos ── -->
            <TextBlock Text="Recursos" Style="{StaticResource Section}"/>
            <CheckBox Content="Controles de mídia" IsChecked="{Binding ShowMedia}"/>
            <CheckBox Content="Prateleira de arquivos" IsChecked="{Binding ShowShelf}" Margin="0,6,0,0"/>
            <CheckBox Content="Notas" IsChecked="{Binding ShowNotes}" Margin="0,6,0,0"/>
            <CheckBox Content="Timer" IsChecked="{Binding ShowTimer}" Margin="0,6,0,0"/>
            <CheckBox Content="Histórico da área de transferência" IsChecked="{Binding ShowClipboard}" Margin="0,6,0,0"/>
            <DockPanel Style="{StaticResource Row}" Margin="0,8,0,0">
                <TextBlock Text="Itens no histórico" Style="{StaticResource Label}"/>
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Value}"
                           Text="{Binding Value, ElementName=ClipMaxSlider, StringFormat={}{0:0}}"/>
                <Slider x:Name="ClipMaxSlider" Minimum="5" Maximum="100" TickFrequency="5"
                        IsSnapToTickEnabled="True" Value="{Binding ClipboardMax}"/>
            </DockPanel>

            <!-- ── Comportamento ── -->
            <TextBlock Text="Comportamento" Style="{StaticResource Section}"/>
            <DockPanel Style="{StaticResource Row}">
                <TextBlock Text="Atraso para abrir" Style="{StaticResource Label}"/>
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Value}"
                           Text="{Binding Value, ElementName=HoverSlider, StringFormat={}{0:0} ms}"/>
                <Slider x:Name="HoverSlider" Minimum="0" Maximum="1000" TickFrequency="50"
                        IsSnapToTickEnabled="True" Value="{Binding HoverDelayMs}"/>
            </DockPanel>
            <DockPanel Style="{StaticResource Row}">
                <TextBlock Text="Atraso para fechar" Style="{StaticResource Label}"/>
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Value}"
                           Text="{Binding Value, ElementName=CollapseSlider, StringFormat={}{0:0} ms}"/>
                <Slider x:Name="CollapseSlider" Minimum="100" Maximum="2000" TickFrequency="50"
                        IsSnapToTickEnabled="True" Value="{Binding CollapseDelayMs}"/>
            </DockPanel>
            <DockPanel Style="{StaticResource Row}">
                <TextBlock Text="Monitor" Style="{StaticResource Label}"/>
                <ComboBox x:Name="MonitorCombo" DisplayMemberPath="Label" SelectedValuePath="Device"
                          SelectedValue="{Binding MonitorDevice}"/>
            </DockPanel>
            <CheckBox Content="Atalho global Ctrl+Alt+N para abrir/fechar" IsChecked="{Binding HotkeyEnabled}" Margin="0,8,0,0"/>
            <CheckBox Content="Ocultar quando um app estiver em tela cheia" IsChecked="{Binding HideOnFullscreen}" Margin="0,6,0,0"/>
            <CheckBox Content="Relógio de 24 horas" IsChecked="{Binding Use24h}" Margin="0,6,0,0"/>
            <CheckBox Content="Mostrar segundos" IsChecked="{Binding ShowSeconds}" Margin="0,6,0,0"/>
            <CheckBox x:Name="StartupCheck" Content="Iniciar com o Windows" Margin="0,6,0,0"
                      Click="StartupCheck_Click"/>

            <!-- ── Atualizações ── -->
            <TextBlock Text="Atualizações" Style="{StaticResource Section}"/>
            <TextBlock x:Name="VersionText" Opacity="0.7"/>
            <CheckBox Content="Verificar atualizações automaticamente" IsChecked="{Binding AutoCheckUpdates}" Margin="0,8,0,0"/>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button x:Name="CheckUpdatesButton" Content="Verificar agora" Click="CheckUpdates_Click" Padding="14,6"/>
                <TextBlock x:Name="UpdateStatus" VerticalAlignment="Center" Margin="12,0,0,0" Opacity="0.8"
                           TextWrapping="Wrap" MaxWidth="300"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,28,0,0">
                <Button x:Name="SupportButton" Content="❤  Apoiar o projeto" Click="Support_Click" Padding="14,6"
                        Margin="0,0,10,0" Style="{StaticResource AccentButtonStyle}"/>
                <Button Content="Restaurar padrões" Click="Reset_Click" Padding="14,6"/>
                <Button Content="Sair do Ilha" Click="Quit_Click" Padding="14,6" Margin="10,0,0,0"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
