<Window x:Class="Ilha.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Ilha"
        Title="{local:T 'Configurações do Ilha'}" Width="860" Height="620" MinWidth="720" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WinBg}" Foreground="{DynamicResource WinFg}"
        FontFamily="{DynamicResource UiFont}" FontSize="13.5"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Grayscale" TextOptions.TextHintingMode="Fixed">

    <!-- Sem a barra de título do Windows: a janela inteira é desenhada pelo Ilha -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" GlassFrameThickness="0" ResizeBorderThickness="6"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#7CE3A1"/>

        <!-- Barra de rolagem fina e arredondada, sem as setinhas do Windows -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/>
            <Setter Property="MinWidth" Value="10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="0,4">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="Bar" Width="4" CornerRadius="2" HorizontalAlignment="Center"
                                                    Background="{DynamicResource Text3}" Opacity="0.45"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bar" Property="Width" Value="6"/>
                                                    <Setter TargetName="Bar" Property="Opacity" Value="0.7"/>
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="Bar" Property="Width" Value="6"/>
                                                    <Setter TargetName="Bar" Property="Opacity" Value="0.85"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Listas de escolha (monitor, som do alarme): mesmo desenho dos botões, nada do visual antigo do Windows -->
        <Style TargetType="ComboBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource WinFg}"/>
            <Setter Property="Background" Value="{DynamicResource Control}"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="MinWidth" Value="180"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Grid>
                                            <Border CornerRadius="8" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                    BorderBrush="{DynamicResource Line}" BorderThickness="1"/>
                                            <Border x:Name="Hover" CornerRadius="8" Background="{DynamicResource Ink_FF}" Opacity="0"/>
                                            <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,1,12,0"
                                                  Data="M0,0 L4,4 L8,0" Stroke="{DynamicResource Text2}" StrokeThickness="1.5"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Hover" Property="Opacity" Value="0.06"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Hover" Property="Opacity" Value="0.1"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False" Margin="12,0,32,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
                            <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="4" AllowsTransparency="True" Focusable="False"
                                   PopupAnimation="Fade" IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border Margin="8,0,8,12" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="{DynamicResource WinBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                        CornerRadius="10" Padding="4">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.25"/>
                                    </Border.Effect>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource WinFg}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Grid>
                            <Border x:Name="Bg" CornerRadius="6" Background="{DynamicResource Ink_FF}" Opacity="0"/>
                            <DockPanel Margin="10,7">
                                <Path x:Name="Check" DockPanel.Dock="Right" Margin="12,0,2,0" VerticalAlignment="Center" Visibility="Hidden"
                                      Data="M0,4 L3.5,7.5 L10,0" Stroke="{DynamicResource Accent}" StrokeThickness="1.6"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </DockPanel>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.08"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Título de grupo -->
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Text3}"/>
            <Setter Property="Margin" Value="4,22,0,8"/>
        </Style>

        <Style x:Key="Group" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
        </Style>

        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="16,0,0,0"/>
            <Setter Property="Background" Value="{DynamicResource Line}"/>
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource Text3}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="4,8,4,0"/>
        </Style>

        <!-- Item da barra lateral -->
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="GroupName" Value="Nav"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource Text2}"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="Sel" CornerRadius="9" Background="{DynamicResource Accent}" Opacity="0"/>
                            <Border x:Name="Hover" CornerRadius="9" Background="{DynamicResource Ink_FF}" Opacity="0"/>
                            <DockPanel Margin="10,0">
                                <local:Glyph x:Name="NavIcon" Data="{TemplateBinding Tag}" Size="17" Filled="True" Thickness="0"
                                             VerticalAlignment="Center"/>
                                <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="0.05"/>
                                <Setter Property="Foreground" Value="{DynamicResource WinFg}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Sel" Property="Opacity" Value="0.16"/>
                                <Setter TargetName="NavIcon" Property="Foreground" Value="{DynamicResource Accent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource WinFg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Linha com interruptor à direita -->
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource WinFg}"/>
            <Setter Property="Padding" Value="16,11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <DockPanel>
                                <Border x:Name="Track" DockPanel.Dock="Right" Width="40" Height="23" CornerRadius="7"
                                        Background="{DynamicResource ControlOff}" Margin="12,0,0,0">
                                    <Border x:Name="Knob" Width="19" Height="19" CornerRadius="5" Background="White"
                                            HorizontalAlignment="Left" Margin="2,0,0,0">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="5" ShadowDepth="1" Direction="270" Opacity="0.35"/>
                                        </Border.Effect>
                                        <Border.RenderTransform>
                                            <TranslateTransform/>
                                        </Border.RenderTransform>
                                    </Border>
                                </Border>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource Accent}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Knob" Duration="0:0:0.22"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                             To="17">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase EasingMode="EaseOut" Amplitude="0.25"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Knob" Duration="0:0:0.22"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                             To="0">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase EasingMode="EaseOut" Amplitude="0.25"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Controle segmentado (idioma) -->
        <Style x:Key="Segment" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="92"/>
            <Setter Property="Foreground" Value="{DynamicResource Text2}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" CornerRadius="7" Padding="14,5" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource CardBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource WinFg}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cartão de escolha com prévia desenhada (Vidro/Sólido, Colada/Flutuante, Lateral/Topo) -->
        <Style x:Key="ChoiceCard" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource WinFg}"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="Width" Value="170"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="Frame" CornerRadius="13" Background="{DynamicResource CardBg}"
                                    BorderBrush="{DynamicResource Line}" BorderThickness="1.5" Padding="8,8,8,10">
                                <ContentPresenter/>
                            </Border>
                            <Border x:Name="Hover" CornerRadius="13" Background="{DynamicResource Ink_FF}" Opacity="0" IsHitTestVisible="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="0.03"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Preview" TargetType="Border">
            <Setter Property="Height" Value="70"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#2B3A67" Offset="0"/>
                        <GradientStop Color="#4B2E6B" Offset="0.55"/>
                        <GradientStop Color="#1E4D5C" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChoiceLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="2,9,0,0"/>
        </Style>
        <Style x:Key="ChoiceHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{DynamicResource Text3}"/>
            <Setter Property="Margin" Value="2,1,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- Controle deslizante: trilho fino e puxador quadrado de cantos suaves -->
        <Style x:Key="SliderFill" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent">
                            <Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderFill}" Command="Slider.DecreaseLarge"
                                              Background="{DynamicResource Accent}"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderFill}" Command="Slider.IncreaseLarge"
                                              Background="{DynamicResource ControlOff}"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="Knob" Width="18" Height="18" CornerRadius="5" Background="White">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="5" ShadowDepth="1" Direction="270" Opacity="0.4"/>
                                                </Border.Effect>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="Knob" Property="Width" Value="22"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SliderRow" TargetType="Grid">
            <Setter Property="Margin" Value="16,9"/>
        </Style>
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="Foreground" Value="{DynamicResource Text2}"/>
            <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
        </Style>

        <!-- Caixa do código da cor (#RRGGBB): discreta, no mesmo tom dos outros controles -->
        <Style x:Key="HexBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource WinFg}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource WinFg}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CharacterCasing" Value="Upper"/>
            <Setter Property="MaxLength" Value="9"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bg" CornerRadius="8" Background="{DynamicResource Control}"
                                BorderBrush="Transparent" BorderThickness="1" Padding="9,0">
                            <ScrollViewer x:Name="PART_ContentHost" Background="Transparent" Focusable="False"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Swatch" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Rectangle x:Name="Ring" Stroke="{DynamicResource Ink_40}" StrokeThickness="1" RadiusX="7" RadiusY="7"
                                   Fill="{TemplateBinding Background}"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="StrokeThickness" Value="2.5"/>
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Ink_B3}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ── Barra lateral ── -->
        <Border Background="{DynamicResource SideBg}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,16,14,16">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,2,0,22">
                    <Image Source="pack://application:,,,/Assets/icon.png" Width="34" Height="34"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{local:T 'Ilha'}" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock x:Name="VersionText" FontSize="11.5" Foreground="{DynamicResource Text3}"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock DockPanel.Dock="Bottom" Text="{local:T 'Feito com carinho no Brasil'}" FontSize="11"
                           Foreground="{DynamicResource Text3}" Margin="8,0,0,0"/>
                <Button DockPanel.Dock="Bottom" Style="{StaticResource SoftButton}" Margin="0,0,0,12"
                        HorizontalContentAlignment="Left" Padding="10,9" Click="Support_Click">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="22" Height="22" CornerRadius="6" Background="#33FF5C7C">
                            <local:Glyph Data="{StaticResource IcoHeart}" Filled="True" Size="13" Foreground="#FF5C7C"/>
                        </Border>
                        <TextBlock Text="{local:T 'Apoie o Ilha'}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <StackPanel>
                    <RadioButton Style="{StaticResource NavItem}" Content="{local:T 'Geral'}" Tag="{StaticResource FillSettings}"
                                 x:Name="NavGeneral" IsChecked="True" Checked="Nav_Checked"/>
                    <RadioButton Style="{StaticResource NavItem}" Content="{local:T 'Aparência'}" Tag="{StaticResource FillPalette}"
                                 x:Name="NavLook" Checked="Nav_Checked"/>
                    <RadioButton Style="{StaticResource NavItem}" Content="{local:T 'Ilha e posição'}" Tag="{StaticResource FillIsland}"
                                 x:Name="NavIsland" Checked="Nav_Checked"/>
                    <RadioButton Style="{StaticResource NavItem}" Content="{local:T 'Recursos'}" Tag="{StaticResource FillGrid}"
                                 x:Name="NavFeatures" Checked="Nav_Checked"/>
                    <RadioButton Style="{StaticResource NavItem}" Content="{local:T 'Avisos'}" Tag="{StaticResource FillBell}"
                                 x:Name="NavAlerts" Checked="Nav_Checked"/>
                    <RadioButton Style="{StaticResource NavItem}" Content="{local:T 'Atualizações'}" Tag="{StaticResource FillRefresh}"
                                 x:Name="NavUpdates" Checked="Nav_Checked"/>
                    <RadioButton Style="{StaticResource NavItem}" Content="{local:T 'Sobre'}" Tag="{StaticResource FillInfo}"
                                 x:Name="NavAbout" Checked="Nav_Checked"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ── Conteúdo ── -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel Margin="32,18,12,0">
                <Button DockPanel.Dock="Right" Style="{StaticResource CloseButton}" VerticalAlignment="Top"
                        Click="Close_Click" ToolTip="{local:T 'Fechar'}">
                    <local:Glyph Data="{StaticResource IcoClose}" Size="14"/>
                </Button>
                <StackPanel Margin="0,10,0,0">
                    <TextBlock x:Name="PageTitle" Text="{local:T 'Geral'}" FontSize="24" FontWeight="SemiBold"/>
                    <TextBlock x:Name="PageSubtitle" FontSize="13" Foreground="{DynamicResource Text2}" Margin="0,3,0,0"/>
                </StackPanel>
            </DockPanel>

            <ScrollViewer x:Name="PageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                <Grid Margin="32,0,32,32" MaxWidth="640">

                    <!-- ═══ Geral ═══ -->
                    <StackPanel x:Name="PageGeneral" Tag="{local:T 'Como a ilha se comporta no dia a dia.'}">
                        <TextBlock Text="{local:T 'IDIOMA'}" Style="{StaticResource Section}"/>
                        <Border Style="{StaticResource Group}">
                            <StackPanel>
                                <DockPanel Margin="16,10">
                                    <Border DockPanel.Dock="Right" CornerRadius="9" Padding="2" Background="{DynamicResource Control}">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="LangPt" Style="{StaticResource Segment}" GroupName="Lang"
                                                         Content="Português" Checked="Lang_Checked"/>
                                            <RadioButton x:Name="LangEn" Style="{StaticResource Segment}" GroupName="Lang"
                                                         Content="English" Checked="Lang_Checked"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="{local:T 'Idioma do app'}" VerticalAlignment="Center"/>
                                </DockPanel>
                                <DockPanel x:Name="RestartRow" Margin="16,0,16,10" Visibility="Collapsed">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Padding="12,5"
                                            Content="{local:T 'Reiniciar agora'}" Click="Restart_Click"/>
                                    <TextBlock Text="{local:T 'O Ilha reinicia para trocar o idioma.'}" Foreground="{DynamicResource Text2}"
                                               VerticalAlignment="Center" TextWrapping="Wrap"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{local:T 'ABRIR E FECHAR'}" Style="{StaticResource Section}"/>
                        <Border Style="{StaticResource Group}">
                            <StackPanel>
                                <Grid Style="{StaticResource SliderRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{local:T 'Atraso para abrir'}" Style="{StaticResource RowLabel}"/>
                                    <Slider x:Name="HoverSlider" Grid.Column="1" Minimum="0" Maximum="1000" TickFrequency="50"
                                            IsSnapToTickEnabled="True" Value="{Binding HoverDelayMs}"/>
                                    <TextBlock Grid.Column="2" Style="{StaticResource Value}"
                                               Text="{Binding Value, ElementName=HoverSlider, StringFormat={}{0:0} ms}"/>
                                </Grid>
                                <Border Style="{StaticResource Divider}"/>
                                <Grid Style="{StaticResource SliderRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{local:T 'Atraso para fechar'}" Style="{StaticResource RowLabel}"/>
                                    <Slider x:Name="CollapseSlider" Grid.Column="1" Minimum="100" Maximum="2000" TickFrequency="50"
                                            IsSnapToTickEnabled="True" Value="{Binding CollapseDelayMs}"/>
                                    <TextBlock Grid.Column="2" Style="{StaticResource Value}"
                                               Text="{Binding Value, ElementName=CollapseSlider, StringFormat={}{0:0} ms}"/>
                                </Grid>
                                <Border Style="{StaticResource Divider}"/>
                                <CheckBox Style="{StaticResource Switch}" Content="{local:T 'Atalho Ctrl + Alt + N abre e fecha'}" IsChecked="{Binding HotkeyEnabled}"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{local:T 'TELA'}" Style="{StaticResource Section}"/>
                        <Border Style="{StaticResource Group}">
                            <StackPanel>
                                <DockPanel Margin="16,9">
                                    <TextBlock Text="{local:T 'Monitor'}" Width="180" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="MonitorCombo" DisplayMemberPath="Label" SelectedValuePath="Device"
                                              SelectedValue="{Binding MonitorDevice}"/>
                                </DockPanel>
                                <Border Style="{StaticResource Divider}"/>
                                <CheckBox Style="{StaticResource Switch}" Content="{local:T 'Esconder com app em tela cheia'}" IsChecked="{Binding HideOnFullscreen}"/>
                                <Border Style="{StaticResource Divider}"/>
                                <CheckBox Style="{StaticResource Switch}" Content="{local:T 'Ilha dinâmica'}" IsChecked="{Binding AutoSlim}"
                                          ToolTip="{local:T 'Quando uma janela fica embaixo da ilha, ela vira um risco para não cobrir abas e botões. Minimizou ou tirou a janela dali, ela volta ao normal.'}"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource Hint}" Text="{local:T 'Ilha dinâmica: quando um navegador ou outra janela fica embaixo da ilha, ela vira um risco para não cobrir abas e botões. Minimizou ou tirou a janela dali, ela volta ao normal. Com a ilha flutuante, ela fica no monitor para onde você arrastar.'}"/>

                        <TextBlock Text="{local:T 'RELÓGIO'}" Style="{StaticResource Section}"/>
                        <Border Style="{StaticResource Group}">
                            <StackPanel>
                                <CheckBox Style="{StaticResource Switch}" Content="{local:T 'Formato de 24 horas'}" IsChecked="{Binding Use24h}"/>
                                <Border Style="{StaticResource Divider}"/>
                                <CheckBox Style="{StaticResource Switch}" Content="{local:T 'Mostrar segundos'}" IsChecked="{Binding ShowSeconds}"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{local:T 'SISTEMA'}" Style="{StaticResource Section}"/>
                        <Border Style="{StaticResource Group}">
                            <CheckBox x:Name="StartupCheck" Style="{StaticResource Switch}" Content="{local:T 'Abrir o Ilha ao ligar o computador'}"
                                      Click="StartupCheck_Click"/>
                        </Border>
                    </StackPanel>

                    <!-- ═══ Aparência ═══ -->
                    <StackPanel x:Name="PageLook" Visibility="Collapsed" Tag="{local:T 'Material, cores e sombra da ilha.'}">
                        <TextBlock Text="{local:T 'MODO'}" Style="{StaticResource Section}"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="DarkRadio" Style="{StaticResource ChoiceCard}" GroupName="Theme" Checked="Theme_Checked">
                                <StackPanel>
                                    <Border Style="{StaticResource Preview}" Background="#1A1A1F">
                                        <Border Width="110" Height="26" CornerRadius="0,0,9,9" VerticalAlignment="Top" Background="#000000">
                                            <Border Width="40" Height="5" CornerRadius="2.5" Background="#7CE3A1" Margin="0,0,0,2"/>
                                        </Border>
                                    </Border>
                                    <TextBlock Text="{local:T 'Escuro'}" Style="{StaticResource ChoiceLabel}"/>
                                    <TextBlock Text="{local:T 'Ilha preta, textos claros'}" Style="{StaticResource ChoiceHint}"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="LightRadio" Style="{StaticResource ChoiceCard}" GroupName="Theme" Checked="Theme_Checked">
                                <StackPanel>
                                    <Border Style="{StaticResource Preview}" Background="#DCDCE3">
                                        <Border Width="110" Height="26" CornerRadius="0,0,9,9" VerticalAlignment="Top" Background="#F7F7FA">
                                            <Border Width="40" Height="5" CornerRadius="2.5" Background="#2B2B30" Margin="0,0,0,2"/>
                                        </Border>
                                    </Border>
                                    <TextBlock Text="{local:T 'Claro'}" Style="{StaticResource ChoiceLabel}"/>
                                    <TextBlock Text="{local:T 'Ilha clara, textos escuros'}" Style="{StaticResource ChoiceHint}"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>

                        <TextBlock Text="{local:T 'MATERIAL'}" Style="{StaticResource Section}"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="GlassRadio" Style="{StaticResource ChoiceCard}" GroupName="Material"
                                         Checked="Material_Checked">
                                <StackPanel>
                                    <Border Style="{StaticResource Preview}">
                                        <Grid>
                                            <Ellipse Width="60" Height="60" Fill="#E0607A" Margin="-60,-20,0,0" Opacity="0.8"/>
                                            <Ellipse Width="50" Height="50" Fill="#F2B34A" Margin="70,30,0,0" Opacity="0.8"/>
                                            <Border Width="110" Height="26" CornerRadius="0,0,9,9" VerticalAlignment="Top"
                                                    Background="#66101014" BorderBrush="{DynamicResource Ink_40}" BorderThickness="1,0,1,1"/>
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="{local:T 'Vidro'}" Style="{StaticResource ChoiceLabel}"/>
                                    <TextBlock Text="{local:T 'Desfoca o que está atrás'}" Style="{StaticResource ChoiceHint}"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="SolidRadio" Style="{StaticResource ChoiceCard}" GroupName="Material"
                                         Checked="Material_Checked">
                                <StackPanel>
                                    <Border Style="{StaticResource Preview}">
                                        <Grid>
                                            <Ellipse Width="60" Height="60" Fill="#E0607A" Margin="-60,-20,0,0" Opacity="0.8"/>
                                            <Ellipse Width="50" Height="50" Fill="#F2B34A" Margin="70,30,0,0" Opacity="0.8"/>
                                            <Border Width="110" Height="26" CornerRadius="0,0,9,9" VerticalAlignment="Top"
                                                    Background="#0A0A0C"/>
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="{local:T 'Sólido'}" Style="{StaticResource ChoiceLabel}"/>
                                    <TextBlock Text="{local:T 'Cor cheia, sem transparência'}" Style="{StaticResource ChoiceHint}"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                        <Border x:Name="TintGroup" Style="{StaticResource Group}" Margin="0,12,0,0">
                            <Grid Style="{StaticResource SliderRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{local:T 'Intensidade da cor'}" Style="{StaticResource RowLabel}"/>
                                <Slider x:Name="TintSlider" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="1"
                                        IsSnapToTickEnabled="True" Value="{Binding GlassTint}"/>
                                <TextBlock Grid.Column="2" Style="{StaticResource Value}"
                                           Text="{Binding Value, ElementName=TintSlider, StringFormat={}{0:0}%}"/>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="MaterialHint" Style="{StaticResource Hint}"/>

                        <TextBlock Text="{local:T 'CORES'}" Style="{StaticResource Section}"/>
                        <Border Style="{StaticResource Group}">
                            <StackPanel>
                                <DockPanel Margin="16,10">
                                    <TextBlock Text="{local:T 'Ilha'}" Width="110" VerticalAlignment="Center"/>
                                    <TextBox x:Name="IslandColorBox" Style="{StaticResource HexBox}" DockPanel.Dock="Right" Width="92"
                                             Text="{Binding IslandColor, UpdateSourceTrigger=PropertyChanged}"/>
                                    <StackPanel x:Name="IslandSwatches" Orientation="Horizontal" VerticalAlignment="Center"/>
                                </DockPanel>
                                <Border Style="{StaticResource Divider}"/>
                                <DockPanel Margin="16,10">
                                    <TextBlock Text="{local:T 'Destaque'}" Width="110" VerticalAlignment="Center"/>
                                    <TextBox x:Name="AccentColorBox" Style="{StaticResource HexBox}" DockPanel.Dock="Right" Width="92"
                                             Text="{Binding AccentColor, UpdateSourceTrigger=PropertyChanged}"/>
                                    <StackPanel x:Name="AccentSwatches" Orientation="Horizontal" VerticalAlignment="Center"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{local:T 'DETALHES'}" Style="{StaticResource Section}"/>
                        <Border Style="{StaticResource Group}">
                            <StackPanel>
                                <CheckBox Style="{StaticResource Switch}" Content="{local:T 'Luz ambiente da capa da música (modo vidro)'}" IsChecked="{Binding AmbientArt}"/>
                                <Border Style="{StaticResource Divider}"/>
                                <CheckBox Style="{StaticResource Switch}" Content="{local:T 'Sombra (modo sólido e ilha flutuante)'}" IsChecked="{Binding ShowShadow}"/>
                                <Border Style="{StaticResource Divider}"/>
                                <CheckBox Style="{StaticResource Switch}" Content="{local:T 'Animação com efeito de mola'}" IsChecked="{Binding SpringAnimation}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ═══ Ilha e posição ═══ -->
                    <StackPanel x:Name="PageIsland" Visibility="Collapsed" Tag="{local:T 'Onde a ilha fica, onde ficam as abas e o tamanho dela.'}">
                        <TextBlock Text="{local:T 'ESTILO'}" Style="{StaticResource Section}"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="AttachedRadio" Style="{StaticResource ChoiceCard}" GroupName="IslandStyle"
                                         Checked="IslandStyle_Checked">
                                <StackPanel>
                                    <Border Style="{StaticResource Preview}">
                                        <Border Width="96" Height="22" CornerRadius="0,0,8,8" VerticalAlignment="Top"
                                                Background="#0A0A0C"/>
                                    </Border>
                                    <TextBlock Text="{local:T 'Colada no topo'}" Style="{StaticResource ChoiceLabel}"/>
                                    <TextBlock Text="{local:T 'Presa na borda da tela'}" Style="{StaticResource ChoiceHint}"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="TopFloatRadio" Style="{StaticResource ChoiceCard}" GroupName="IslandStyle"
                                         Checked="IslandStyle_Checked">
                                <StackPanel>
                                    <Border Style="{StaticResource Preview}">
                                        <Border Width="96" Height="22" CornerRadius="8" Margin="0,8,0,0"
                                                VerticalAlignment="Top" Background="#0A0A0C">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="10" ShadowDepth="3" Direction="270" Opacity="0.5"/>
                                            </Border.Effect>
                                        </Border>
                                    </Border>
                                    <TextBlock Text="{local:T 'Solta no topo'}" Style="{StaticResource ChoiceLabel}"/>
                                    <TextBlock Text="{local:T 'Centralizada, com um respiro'}" Style="{StaticResource ChoiceHint}"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="FloatingRadio" Style="{StaticResource ChoiceCard}" GroupName="IslandStyle"
                                         Checked="IslandStyle_Checked">
                                <StackPanel>
                                    <Border Style="{StaticResource Preview}">
                                        <Border Width="96" Height="22" CornerRadius="8" Margin="18,20,0,0"
                                                HorizontalAlignment="Left" VerticalAlignment="Top" Background="#0A0A0C">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="10" ShadowDepth="3" Direction="270" Opacity="0.5"/>
                                            </Border.Effect>
                                        </Border>
                                    </Border>
                                    <TextBlock Text="{local:T 'Livre'}" Style="{StaticResource ChoiceLabel}"/>
                                    <TextBlock Text="{local:T 'Solta, arraste para onde quiser'}" Style="{StaticResource ChoiceHint}"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                        <Border x:Name="FloatOptions" Style="{StaticResource Group}" Margin="0,12,0,0">
                            <StackPanel>
                                <CheckBox x:Name="FloatLockCheck" Style="{StaticResource Switch}" Content="{local:T 'Fixar posição (não deixa arrastar)'}"
                                          IsChecked="{Binding FloatLocked}"/>
                                <Border Style="{StaticResource Divider}"/>
                                <DockPanel Margin="16,9">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource SoftButton}" Padding="12,5"
                                            Content="{local:T 'Centralizar'}" Click="CenterIsland_Click"/>
                                    <TextBlock Text="{local:T 'Voltar para o centro, no topo da tela'}" VerticalAlignment="Center"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="FloatHint" Style="{StaticResource Hint}"
                                   Text="{local:T 'Para mover: segure a ilha pelo cabeçalho (onde fica o relógio) e arraste. Para mudar o tamanho: arraste o cantinho de baixo, à direita. O alfinete na ilha fixa e solta.'}"/>

                        <!-- 1.10: ilha aberta em abas (um recurso por vez) ou completa (tudo lado a lado) -->
                        <TextBlock Text="{local:T 'ILHA ABERTA'}" Style="{StaticResource Section}"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="TabsLayoutRadio" Style="{StaticResource ChoiceCard}" GroupName="OpenLayout"
                                         Checked="Layout_Checked">
                                <StackPanel>
                                    <Border Style="{StaticResource Preview}">
                                        <Border Width="84" Height="52" CornerRadius="9" Background="#0A0A0C" Padding="7">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <Border Width="8" Height="6" CornerRadius="2" Background="{DynamicResource Accent}" Margin="0,0,3,0"/>
                                                    <Border Width="8" Height="6" CornerRadius="2" Background="{DynamicResource Ink_4D}" Margin="0,0,3,0"/>
                                                    <Border Width="8" Height="6" CornerRadius="2" Background="{DynamicResource Ink_4D}" Margin="0,0,3,0"/>
                                                    <Border Width="8" Height="6" CornerRadius="2" Background="{DynamicResource Ink_4D}"/>
                                                </StackPanel>
                                                <Border Height="24" CornerRadius="4" Background="{DynamicResource Ink_26}" Margin="0,5,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </Border>
                                    <TextBlock Text="{local:T 'Separada por abas'}" Style="{StaticResource ChoiceLabel}"/>
                                    <TextBlock Text="{local:T 'Um recurso por vez, ilha menor'}" Style="{StaticResource ChoiceHint}"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="FullLayoutRadio" Style="{StaticResource ChoiceCard}" GroupName="OpenLayout"
                                         Checked="Layout_Checked">
                                <StackPanel>
                                    <Border Style="{StaticResource Preview}">
                                        <Border Width="140" Height="40" CornerRadius="9" Background="#0A0A0C" Padding="6">
                                            <UniformGrid Rows="1" Columns="5">
                                                <Border CornerRadius="3" Background="{DynamicResource Accent}" Opacity="0.85" Margin="0,0,3,0"/>
                                                <Border CornerRadius="3" Background="{DynamicResource Ink_26}" Margin="0,0,3,0"/>
                                                <Border CornerRadius="3" Background="{DynamicResource Ink_26}" Margin="0,0,3,0"/>
                                                <Border CornerRadius="3" Background="{DynamicResource Ink_26}" Margin="0,0,3,0"/>
                                                <Border CornerRadius="3" Background="{DynamicResource Ink_26}"/>
                                            </UniformGrid>
                                        </Border>
                                    </Border>
                                    <TextBlock Text="{local:T 'Completa'}" Style="{StaticResource ChoiceLabel}"/>
                                    <TextBlock Text="{local:T 'Música, agenda, tarefas, notas e timer juntos'}" Style="{StaticResource ChoiceHint}"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                        <!-- As abas ficam sempre no topo (1.9.2): escolha escondida -->
                        <StackPanel Visibility="Collapsed">
                            <RadioButton x:Name="SideTabsRadio" GroupName="Tabs" Checked="Tabs_Checked"/>
                            <RadioButton x:Name="TopTabsRadio" GroupName="Tabs" Checked="Tabs_Checked"/>
                        </StackPanel>
                        <TextBlock Text="{local:T 'TAMANHO'}" Style="{StaticResource Section}"/>
                        <Border Style="{StaticResource Group}">
                            <StackPanel>
                                <!-- Prévia: topo da tela com a ilha fechada e o contorno de até onde ela abre -->
                                <Border Margin="12,12,12,4" Height="150" CornerRadius="10" ClipToBounds="True"
                                        Background="{DynamicResource Ink_08}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                                    <Canvas x:Name="SizeCanvas" ClipToBounds="True"/>
                                </Border>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,8">
                                    <Border Width="10" Height="10" CornerRadius="3" Background="{DynamicResource Accent}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="SizeClosedText" FontSize="12" Foreground="{DynamicResource Text2}" Margin="6,0,18,0"/>
                                    <Border Width="10" Height="10" CornerRadius="3" BorderThickness="1.5"
                                            BorderBrush="{DynamicResource Text2}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="SizeOpenText" FontSize="12" Foreground="{DynamicResource Text2}" Margin="6,0,0,0"/>
                                </StackPanel>
                                <Border Style="{StaticResource Divider}"/>
                                <Grid Style="{StaticResource SliderRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{local:T 'Largura fechada'}" Style="{StaticResource RowLabel}"/>
                                    <Slider x:Name="CWidthSlider" Grid.Column="1" Minimum="80" Maximum="360" TickFrequency="5"
                                            IsSnapToTickEnabled="True" Value="{Binding CollapsedWidth}"/>
                                    <TextBlock Grid.Column="2" Style="{StaticResource Value}"
                                               Text="{Binding Value, ElementName=CWidthSlider, StringFormat={}{0:0} px}"/>
                                </Grid>
                                <Border Style="{StaticResource Divider}"/>
                                <Grid Style="{StaticResource SliderRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{local:T 'Altura fechada'}" Style="{StaticResource RowLabel}"/>
                                    <Slider x:Name="CHeightSlider" Grid.Column="1" Minimum="20" Maximum="48" TickFrequency="1"
                                            IsSnapToTickEnabled="True" Value="{Binding CollapsedHeight}"/>
                                    <TextBlock Grid.Column="2" Style="{StaticResource Value}"
                                               Text="{Binding Value, ElementName=CHeightSlider, StringFormat={}{0:0} px}"/>
                                </Grid>
                                <Border Style="{StaticResource Divider}"/>
                                <Grid Style="{StaticResource SliderRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{local:T 'Largura aberta'}" Style="{StaticResource RowLabel}"/>
                                    <Slider x:Name="OWidthSlider" Grid.Column="1" Minimum="340" Maximum="1040" TickFrequency="10"
                                            IsSnapToTickEnabled="True" Value="{Binding OpenWidth}"/>
                                    <TextBlock Grid.Column="2" Style="{StaticResource Value}"
                                               Text="{Binding Value, ElementName=OWidthSlider, StringFormat={}{0:0} px}"/>
                                </Grid>
                                <Border Style="{StaticResource Divider}"/>
                                <Grid Style="{StaticResource SliderRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{local:T 'Altura aberta'}" Style="{StaticResource RowLabel}"/>
                                    <Slider x:Name="OHeightSlider" Grid.Column="1" Minimum="130" Maximum="460" TickFrequency="5"
                                            IsSnapToTickEnabled="True" Value="{Binding OpenHeight}"/>
                                    <TextBlock Grid.Column="2" Style="{StaticResource Value}"
                                               Text="{Binding Value, ElementName=OHeightSlider, StringFormat={}{0:0} px}"/>
                                </Grid>
                                <Border Style="{StaticResource Divider}"/>
                                <DockPanel Margin="16,9">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource SoftButton}" Padding="12,5"
                                            Content="{local:T 'Restaurar'}" Click="DefaultSize_Click"/>
                                    <TextBlock Text="{local:T 'Tamanhos padrão'}" VerticalAlignment="Center"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="{local:T 'Quanto menor a ilha aberta, menos coisas aparecem: o que não cabe sai sozinho.'}"/>

                        <TextBlock Text="{local:T 'FORMA'}" Style="{StaticResource Section}"/>
                        <Border Style="{StaticResource Group}">
                            <StackPanel>
                                <Grid Style="{StaticResource SliderRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{local:T 'Escala geral'}" Style="{StaticResource RowLabel}"/>
                                    <Slider x:Name="ScaleSlider" Grid.Column="1" Minimum="0.7" Maximum="1.5" TickFrequency="0.05"
                                            IsSnapToTickEnabled="True" Value="{Binding Scale}"/>
                                    <TextBlock Grid.Column="2" Style="{StaticResource Value}"
                                               Text="{Binding Value, ElementName=ScaleSlider, StringFormat={}{0:P0}}"/>
                                </Grid>
                                <Border Style="{StaticResource Divider}"/>
                                <Grid Style="{StaticResource SliderRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{local:T 'Arredondamento'}" Style="{StaticResource RowLabel}"/>
                                    <Slider x:Name="RadiusSlider" Grid.Column="1" Minimum="0" Maximum="36" TickFrequency="1"
                                            IsSnapToTickEnabled="True" Value="{Binding CornerRadius}"/>
                                    <TextBlock Grid.Column="2" Style="{StaticResource Value}"
                                               Text="{Binding Value, ElementName=RadiusSlider, StringFormat={}{0:0} px}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ═══ Recursos ═══ -->
                    <StackPanel x:Name="PageFeatures" Visibility="Collapsed" Tag="{local:T 'Escolha o que aparece dentro da ilha.'}">
                        <TextBlock Text="{local:T 'INÍCIO'}" Style="{StaticResource Section}"/>
                        <Border Style="{StaticResource Group}">
                            <StackPanel>
                                <CheckBox Style="{StaticResource Switch}" Content="{local:T 'Controles de mídia'}" IsChecked="{Binding ShowMedia}"/>
                                <Border Style="{StaticResource Divider}"/>
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding EnableLike}">
                                    <StackPanel>
                                        <TextBlock Text="{local:T 'Botão de curtir no Spotify'}"/>
                                        <TextBlock Text="{local:T 'Salva a música tocando nas suas Músicas Curtidas. Clicar de novo tira a curtida.'}"
                                                   FontSize="12" Foreground="{DynamicResource Text3}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </CheckBox>
                                <Border Style="{StaticResource Divider}"/>
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ShowShuffleRepeat}">
                                    <StackPanel>
                                        <TextBlock Text="{local:T 'Aleatório e repetir'}"/>
                                        <TextBlock Text="{local:T 'Botões ao lado dos controles da música.'}"
                                                   FontSize="12" Foreground="{DynamicResource Text3}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </CheckBox>
                                <Border Style="{StaticResource Divider}"/>
                                <CheckBox Style="{StaticResource Switch}" Content="{local:T 'Monitor do sistema (CPU e memória)'}" IsChecked="{Binding ShowStats}"/>
                                <Border Style="{StaticResource Divider}"/>
                                <CheckBox Style="{StaticResource Switch}" Content="{local:T 'Prateleira de arquivos'}" IsChecked="{Binding ShowShelf}"/>
                                <Border Style="{StaticResource Divider}"/>
                                <CheckBox Style="{StaticResource Switch}" Content="{local:T 'Downloads novos vão para a prateleira'}" IsChecked="{Binding DownloadsToShelf}"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{local:T 'PRODUTIVIDADE'}" Style="{StaticResource Section}"/>
                        <Border Style="{StaticResource Group}">
                            <StackPanel>
                                <CheckBox Style="{StaticResource Switch}" Content="{local:T 'Agenda e lembretes'}" IsChecked="{Binding ShowCalendar}"/>
                                <Border Style="{StaticResource Divider}"/>
                                <CheckBox Style="{StaticResource Switch}" Content="{local:T 'Tarefas do dia'}" IsChecked="{Binding ShowTasks}"/>
                                <Border Style="{StaticResource Divider}"/>
                                <CheckBox Style="{StaticResource Switch}" Content="{local:T 'Notas'}" IsChecked="{Binding ShowNotes}"/>
                                <Border Style="{StaticResource Divider}"/>
                                <CheckBox Style="{StaticResource Switch}" Content="{local:T 'Foco (timer)'}" IsChecked="{Binding ShowTimer}"/>
                                <Border Style="{StaticResource Divider}"/>
                                <CheckBox Style="{StaticResource Switch}" Content="{local:T 'Teleprompter'}" IsChecked="{Binding ShowPrompter}"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{local:T 'FERRAMENTAS'}" Style="{StaticResource Section}"/>
                        <Border Style="{StaticResource Group}">
                            <StackPanel>
                                <CheckBox Style="{StaticResource Switch}" Content="{local:T 'Conversor de arquivos'}" IsChecked="{Binding ShowConverter}"/>
                                <Border Style="{StaticResource Divider}"/>
                                <CheckBox Style="{StaticResource Switch}" Content="{local:T 'Histórico da área de transferência'}" IsChecked="{Binding ShowClipboard}"/>
                                <Border Style="{StaticResource Divider}"/>
                                <Grid Style="{StaticResource SliderRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{local:T 'Itens no histórico'}" Style="{StaticResource RowLabel}"/>
                                    <Slider x:Name="ClipMaxSlider" Grid.Column="1" Minimum="5" Maximum="100" TickFrequency="5"
                                            IsSnapToTickEnabled="True" Value="{Binding ClipboardMax}"/>
                                    <TextBlock Grid.Column="2" Style="{StaticResource Value}"
                                               Text="{Binding Value, ElementName=ClipMaxSlider, StringFormat={}{0:0}}"/>
                                </Grid>
                                <Border Style="{StaticResource Divider}"/>
                                <CheckBox Style="{StaticResource Switch}" Content="{local:T 'Espelho (câmera)'}" IsChecked="{Binding ShowMirror}"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="{local:T 'A câmera só liga enquanto a aba Espelho está aberta, e nada é gravado. O histórico fica só na memória.'}"/>
                    </StackPanel>

                    <!-- ═══ Avisos ═══ -->
                    <StackPanel x:Name="PageAlerts" Visibility="Collapsed" Tag="{local:T 'O que a ilha mostra quando está recolhida.'}">
                        <TextBlock Text="{local:T 'AVISOS RÁPIDOS'}" Style="{StaticResource Section}"/>
                        <Border Style="{StaticResource Group}">
                            <StackPanel>
                                <CheckBox Style="{StaticResource Switch}" Content="{local:T 'Volume ao mudar'}" IsChecked="{Binding LiveVolume}"/>
                                <Border Style="{StaticResource Divider}"/>
                                <CheckBox Style="{StaticResource Switch}" Content="{local:T 'Carregador conectado ou desconectado'}" IsChecked="{Binding LiveCharging}"/>
                                <Border Style="{StaticResource Divider}"/>
                                <CheckBox Style="{StaticResource Switch}" Content="{local:T 'Música nova começando'}" IsChecked="{Binding LiveTrack}"/>
                                <Border Style="{StaticResource Divider}"/>
                                <CheckBox Style="{StaticResource Switch}" Content="{local:T 'Download concluído'}" IsChecked="{Binding LiveDownloads}"/>
                                <Border Style="{StaticResource Divider}"/>
                                <CheckBox Style="{StaticResource Switch}" Content="{local:T 'Versão nova do Ilha'}" IsChecked="{Binding LiveUpdate}"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource Hint}" Text="{local:T 'A ilha recolhida cresce por um instante para mostrar o aviso.'}"/>

                        <TextBlock Text="{local:T 'BEM-ESTAR'}" Style="{StaticResource Section}"/>
                        <Border Style="{StaticResource Group}">
                            <StackPanel>
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Greeting}">
                                    <StackPanel>
                                        <TextBlock Text="{local:T 'Saudação do dia'}"/>
                                        <TextBlock Text="{local:T 'Na primeira vez do dia que você passa o mouse, a ilha diz bom dia pelo seu nome.'}"
                                                   FontSize="12" Foreground="{DynamicResource Text3}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </CheckBox>
                                <Border Style="{StaticResource Divider}"/>
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding WellnessNudges}">
                                    <StackPanel>
                                        <TextBlock Text="{local:T 'Lembretes de bem-estar'}"/>
                                        <TextBlock Text="{local:T 'Beber água e esticar as pernas durante o dia, escovar os dentes, pôr o despertador e ir dormir quando fica tarde.'}"
                                                   FontSize="12" Foreground="{DynamicResource Text3}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </CheckBox>
                                <Border Style="{StaticResource Divider}"/>
                                <DockPanel Margin="16,10">
                                    <TextBox x:Name="UserNameBox" DockPanel.Dock="Right" Style="{StaticResource HexBox}" Width="160" CharacterCasing="Normal" MaxLength="30"
                                             Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="{local:T 'Seu nome'}" VerticalAlignment="Center"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{local:T 'HORA E ALARME'}" Style="{StaticResource Section}"/>
                        <Border Style="{StaticResource Group}">
                            <StackPanel>
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding HourChime}">
                                    <StackPanel>
                                        <TextBlock Text="{local:T 'Mostrar a hora cheia'}"/>
                                        <TextBlock Text="{local:T 'A ilha se abre um instante e mostra o horário, para você sentir o tempo passar.'}"
                                                   FontSize="12" Foreground="{DynamicResource Text3}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </CheckBox>
                                <Border Style="{StaticResource Divider}"/>
                                <DockPanel Margin="16,10">
                                    <Border DockPanel.Dock="Right" CornerRadius="9" Padding="2" Background="{DynamicResource Control}">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="Chime60" Style="{StaticResource Segment}" GroupName="Chime"
                                                         Content="{local:T 'A cada hora'}" Checked="Chime_Checked"/>
                                            <RadioButton x:Name="Chime30" Style="{StaticResource Segment}" GroupName="Chime"
                                                         Content="{local:T 'A cada 30 min'}" Checked="Chime_Checked"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="{local:T 'Com que frequência'}" VerticalAlignment="Center"/>
                                </DockPanel>
                                <Border Style="{StaticResource Divider}"/>
                                <DockPanel Margin="16,9">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource SoftButton}" Padding="12,5" Margin="10,0,0,0"
                                            Content="{local:T 'Ouvir'}" Click="AlarmPreview_Click"/>
                                    <TextBlock Text="{local:T 'Som do alarme do timer'}" Width="180" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="AlarmCombo" DisplayMemberPath="Label" SelectedValuePath="Id"
                                              SelectionChanged="AlarmCombo_SelectionChanged"/>
                                </DockPanel>
                                <TextBlock x:Name="AlarmFileText" Margin="16,0,16,10" FontSize="12" Foreground="{DynamicResource Text3}"
                                           TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>
                                <Border Style="{StaticResource Divider}"/>
                                <DockPanel Margin="16,10">
                                    <Border DockPanel.Dock="Right" CornerRadius="9" Padding="2" Background="{DynamicResource Control}">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="Repeat3" Style="{StaticResource Segment}" GroupName="AlarmRepeat"
                                                         Content="3x" Tag="3" Checked="Repeat_Checked"/>
                                            <RadioButton x:Name="Repeat6" Style="{StaticResource Segment}" GroupName="AlarmRepeat"
                                                         Content="6x" Tag="6" Checked="Repeat_Checked"/>
                                            <RadioButton x:Name="Repeat10" Style="{StaticResource Segment}" GroupName="AlarmRepeat"
                                                         Content="10x" Tag="10" Checked="Repeat_Checked"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="{local:T 'Repetir o som'}" VerticalAlignment="Center"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="{local:T 'Quando o tempo acaba, a ilha fica verde até você clicar nela.'}"/>

                        <TextBlock Text="{local:T 'ILHA RECOLHIDA'}" Style="{StaticResource Section}"/>
                        <Border Style="{StaticResource Group}">
                            <StackPanel>
                                <CheckBox Style="{StaticResource Switch}" Content="{local:T 'Capa da música tocando'}" IsChecked="{Binding CollapsedShowArt}"/>
                                <Border Style="{StaticResource Divider}"/>
                                <CheckBox Style="{StaticResource Switch}" Content="{local:T 'Equalizador animado'}" IsChecked="{Binding CollapsedShowEqualizer}"/>
                                <Border Style="{StaticResource Divider}"/>
                                <CheckBox Style="{StaticResource Switch}" Content="{local:T 'Contagem do timer'}" IsChecked="{Binding CollapsedShowTimer}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ═══ Atualizações ═══ -->
                    <StackPanel x:Name="PageUpdates" Visibility="Collapsed" Tag="{local:T 'O Ilha se atualiza sozinho, sem perder nada.'}">
                        <TextBlock Text="{local:T 'VERSÕES'}" Style="{StaticResource Section}"/>
                        <Border Style="{StaticResource Group}">
                            <StackPanel>
                                <CheckBox Style="{StaticResource Switch}" Content="{local:T 'Verificar automaticamente'}" IsChecked="{Binding AutoCheckUpdates}"/>
                                <Border Style="{StaticResource Divider}"/>
                                <DockPanel Margin="16,11">
                                    <Button x:Name="CheckUpdatesButton" DockPanel.Dock="Right" Style="{StaticResource AccentButton}"
                                            Content="{local:T 'Verificar agora'}" Click="CheckUpdates_Click"/>
                                    <TextBlock x:Name="UpdateStatus" VerticalAlignment="Center" TextWrapping="Wrap"
                                               Foreground="{DynamicResource Text2}" Margin="0,0,12,0"
                                               Text="{local:T 'Novas versões são instaladas com um clique.'}"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="{local:T 'A única conexão com a internet é esta verificação. Configurações, notas e tarefas ficam no seu PC.'}"/>
                    </StackPanel>

                    <!-- ═══ Sobre ═══ -->
                    <StackPanel x:Name="PageAbout" Visibility="Collapsed" Tag="{local:T 'O topo da sua tela, finalmente útil.'}">
                        <Border Style="{StaticResource Group}" Margin="0,22,0,0" Padding="20">
                            <DockPanel>
                                <Image Source="pack://application:,,,/Assets/icon.png" Width="56" Height="56"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{local:T 'Ilha'}" FontSize="20" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="AboutVersion" Foreground="{DynamicResource Text2}" Margin="0,2,0,0"/>
                                    <TextBlock Text="{local:T 'Gratuito e feito por uma pessoa só. Se ele te ajuda, considere apoiar.'}"
                                               Foreground="{DynamicResource Text3}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button x:Name="SupportButton" Style="{StaticResource AccentButton}" Click="Support_Click" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <local:Glyph Data="{StaticResource IcoHeart}" Filled="True" Size="13" Margin="0,0,7,0"/>
                                    <TextBlock Text="{local:T 'Apoiar o projeto'}"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SoftButton}" Content="{local:T 'Restaurar padrões'}" Click="Reset_Click" Margin="0,0,10,0"/>
                            <Button Style="{StaticResource SoftButton}" Content="{local:T 'Sair do Ilha'}" Click="Quit_Click"/>
                        </StackPanel>
                        <Button Style="{StaticResource SoftButton}" HorizontalAlignment="Left" Margin="0,10,0,0"
                                Content="{local:T 'Ver a apresentação de novo'}" Click="Onboarding_Click"/>
                        <Button Style="{StaticResource SoftButton}" HorizontalAlignment="Left" Margin="0,8,0,0"
                                Content="{local:T 'Ver as novidades desta versão'}" Click="WhatsNew_Click"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="4,14,4,0"
                                   Text="{local:T 'Restaurar padrões volta a aparência e o comportamento ao original, mas mantém notas, tarefas e arquivos da prateleira.'}"/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
