<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Ilha</AssemblyName>
    <RootNamespace>Ilha</RootNamespace>
    <Version>1.12.0</Version>
    <ApplicationIcon>Ilha.ico</ApplicationIcon>
    <!-- O DPI Ã© definido pelo manifesto (correto para WPF); WinForms sÃ³ fornece o Ã­cone da bandeja. -->
    <NoWarn>$(NoWarn);WFO0003;WPF0001</NoWarn>
  </PropertyGroup>

  <!-- Empacotamento: "dotnet publish -c Release -o publish" gera um Ãºnico Ilha.exe.
       IncludeNativeLibrariesForSelfExtract Ã© obrigatÃ³rio: sem ele as DLLs nativas do WPF
       (wpfgfx_cor3, PresentationNative_cor3...) ficam soltas e o exe instalado nÃ£o abre. -->
  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- Inter (SIL Open Font License, ver Fonts\Inter-LICENSE.txt) -->
    <Resource Include="Fonts\*.ttf" />
    <Resource Include="Ilha.ico" />
    <Resource Include="Assets\icon.png" />
  </ItemGroup>

</Project>
