<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Ilha</AssemblyName>
    <RootNamespace>Ilha</RootNamespace>
    <Version>1.1.0</Version>
    <ApplicationIcon>Ilha.ico</ApplicationIcon>
    <!-- O DPI é definido pelo manifesto (correto para WPF); WinForms só fornece o ícone da bandeja. -->
    <NoWarn>$(NoWarn);WFO0003;WPF0001</NoWarn>
  </PropertyGroup>

</Project>
