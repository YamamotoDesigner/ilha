<Window x:Class="Ilha.PipWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Ilha"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Ilha — Picture in picture" Width="480" Height="302" MinWidth="260" MinHeight="176"
        Topmost="True" ShowInTaskbar="False" WindowStartupLocation="Manual"
        Background="#0B0B0D" Foreground="#F5F5F7"
        FontFamily="{DynamicResource UiFont}" FontSize="13"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Grayscale">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" GlassFrameThickness="0" ResizeBorderThickness="6"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="BarButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Foreground" Value="{StaticResource Text2}"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="7" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#26FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Barra: arraste por aqui; o vídeo fica livre embaixo -->
        <DockPanel Background="#141416" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,4,0" VerticalAlignment="Center">
                <Button x:Name="LinkButton" Style="{StaticResource BarButton}" Click="NewLink_Click"
                        ToolTip="Abrir outro vídeo (cole um link)">
                    <local:Glyph Data="{StaticResource IcoPlus}" Size="14"/>
                </Button>
                <Button x:Name="YouTubeButton" Style="{StaticResource BarButton}" Click="OpenYouTube_Click"
                        ToolTip="Abrir no YouTube">
                    <local:Glyph Data="{StaticResource IcoGlobe}" Size="14"/>
                </Button>
                <Button Style="{StaticResource BarButton}" Click="Close_Click" ToolTip="Fechar">
                    <local:Glyph Data="{StaticResource IcoClose}" Size="13"/>
                </Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                <local:Glyph Data="{StaticResource IcoPip}" Size="14" Foreground="{DynamicResource Accent}"/>
                <TextBlock x:Name="TitleText" Text="Picture in picture" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource Text2}" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </DockPanel>

        <!-- Vídeo -->
        <wv2:WebView2 x:Name="Web" Grid.Row="1" DefaultBackgroundColor="Black" Visibility="Collapsed"/>

        <!-- Sem vídeo: colar um link -->
        <StackPanel x:Name="PastePanel" Grid.Row="1" VerticalAlignment="Center" Margin="24,0">
            <TextBlock x:Name="PasteTitle" Text="Qual vídeo você quer assistir?" FontSize="15" FontWeight="SemiBold"
                       HorizontalAlignment="Center"/>
            <TextBlock x:Name="PasteHint" Foreground="{StaticResource Text2}" FontSize="12" TextWrapping="Wrap"
                       TextAlignment="Center" Margin="0,4,0,12"
                       Text="Não encontrei um vídeo do YouTube aberto no navegador. Cole o link aqui:"/>
            <Border CornerRadius="9" Background="#1C1C20" BorderBrush="{StaticResource Line}" BorderThickness="1"
                    Padding="10,0,4,0" Height="34">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Padding="12,3"
                            Content="Assistir" Click="PasteGo_Click" VerticalAlignment="Center"/>
                    <TextBox x:Name="LinkBox" VerticalAlignment="Center" Background="Transparent" BorderThickness="0"
                             Foreground="White" CaretBrush="White" FontSize="12.5" KeyDown="LinkBox_KeyDown"/>
                </DockPanel>
            </Border>
        </StackPanel>
    </Grid>
</Window>
