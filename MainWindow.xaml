<Window x:Class="Ilha.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ilha" Width="640" Height="250"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        FontFamily="Segoe UI Variable Text, Segoe UI" Foreground="White"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <SolidColorBrush x:Key="Accent" Color="#7CE3A1"/>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="999">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#26FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#45FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChipButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="#1CFFFFFF" CornerRadius="12" Padding="11,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#4DFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#B3FFFFFF"/>
            <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="GroupName" Value="Tabs"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1FFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#2EFFFFFF"/>
                                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NotesBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="AcceptsTab" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Hidden"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Background="Transparent" Focusable="False"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1"/>
        </Grid.LayoutTransform>

        <!-- A ilha: pendurada na borda superior, cresce a partir do centro -->
        <Border x:Name="Island"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                Width="190" Height="34"
                Background="Black" CornerRadius="0,0,22,22"
                AllowDrop="True"
                MouseEnter="Island_MouseEnter" MouseLeave="Island_MouseLeave"
                DragEnter="Island_DragOver" DragOver="Island_DragOver"
                DragLeave="Island_DragLeave" Drop="Island_Drop">

            <Grid ClipToBounds="True">

                <!-- Estado recolhido -->
                <Grid x:Name="CollapsedView" Height="34" VerticalAlignment="Top" Margin="14,0" Opacity="0"
                      IsHitTestVisible="False">
                    <Border x:Name="MiniArt" Width="22" Height="22" CornerRadius="6" HorizontalAlignment="Left"
                            Background="#2A2A2A">
                        <Border CornerRadius="6">
                            <Border.Background>
                                <ImageBrush x:Name="MiniArtBrush" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                    </Border>
                    <StackPanel x:Name="Bars" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Rectangle x:Name="Bar1" Width="3" Height="14" Margin="1.5,0" RadiusX="1.5" RadiusY="1.5"
                                   Fill="{DynamicResource Accent}" RenderTransformOrigin="0.5,0.5">
                            <Rectangle.RenderTransform><ScaleTransform ScaleY="0.4"/></Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle x:Name="Bar2" Width="3" Height="14" Margin="1.5,0" RadiusX="1.5" RadiusY="1.5"
                                   Fill="{DynamicResource Accent}" RenderTransformOrigin="0.5,0.5">
                            <Rectangle.RenderTransform><ScaleTransform ScaleY="0.7"/></Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle x:Name="Bar3" Width="3" Height="14" Margin="1.5,0" RadiusX="1.5" RadiusY="1.5"
                                   Fill="{DynamicResource Accent}" RenderTransformOrigin="0.5,0.5">
                            <Rectangle.RenderTransform><ScaleTransform ScaleY="0.5"/></Rectangle.RenderTransform>
                        </Rectangle>
                    </StackPanel>
                    <TextBlock x:Name="CollapsedTimerText" HorizontalAlignment="Right" VerticalAlignment="Center"
                               FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"
                               Typography.NumeralAlignment="Tabular"/>
                </Grid>

                <!-- Estado expandido (tamanho fixo; a ilha revela a partir do centro) -->
                <Grid x:Name="ExpandedView" Width="580" Height="210"
                      HorizontalAlignment="Center" VerticalAlignment="Top"
                      Opacity="0" IsHitTestVisible="False">
                    <Grid Margin="20,8,20,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Cabeçalho -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="ClockText" FontSize="15" FontWeight="SemiBold"
                                           Typography.NumeralAlignment="Tabular"/>
                                <TextBlock x:Name="DateText" FontSize="12" Opacity="0.55" Margin="8,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel x:Name="TabBar" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <RadioButton x:Name="TabHome" Style="{StaticResource TabButton}" Content="&#xE80F;"
                                             Tag="home" ToolTip="Início" IsChecked="True" Checked="Tab_Checked"/>
                                <RadioButton x:Name="TabNotes" Style="{StaticResource TabButton}" Content="&#xE70B;"
                                             Tag="notes" ToolTip="Notas" Checked="Tab_Checked"/>
                                <RadioButton x:Name="TabTimer" Style="{StaticResource TabButton}" Content="&#xE916;"
                                             Tag="timer" ToolTip="Timer" Checked="Tab_Checked"/>
                                <RadioButton x:Name="TabClipboard" Style="{StaticResource TabButton}" Content="&#xE77F;"
                                             Tag="clipboard" ToolTip="Área de transferência" Checked="Tab_Checked"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <Button x:Name="UpdateButton" Style="{StaticResource ChipButton}" Margin="0,0,8,0"
                                        Foreground="{DynamicResource Accent}" Visibility="Collapsed"
                                        Click="UpdateButton_Click" Content="Atualizar"/>
                                <StackPanel x:Name="BatteryPanel" Orientation="Horizontal" VerticalAlignment="Center"
                                            Margin="0,0,6,0">
                                    <TextBlock x:Name="ChargingIcon" Text="&#xE945;" FontFamily="{StaticResource Icons}"
                                               FontSize="11" Foreground="{DynamicResource Accent}"
                                               VerticalAlignment="Center" Margin="0,0,3,0"/>
                                    <TextBlock x:Name="BatteryText" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button Style="{StaticResource IconButton}" Content="&#xE713;" FontSize="13"
                                        Width="26" Height="26" Click="Settings_Click" ToolTip="Configurações"/>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,10,0,0">

                            <!-- ── Início: mídia + prateleira ── -->
                            <Grid x:Name="PageHome">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="HomeMediaCol" Width="*"/>
                                    <ColumnDefinition x:Name="HomeGapCol" Width="16"/>
                                    <ColumnDefinition x:Name="HomeShelfCol" Width="200"/>
                                </Grid.ColumnDefinitions>

                                <Grid x:Name="MediaArea">
                                    <Grid x:Name="MediaDetails">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Width="100" Height="100" CornerRadius="14" Background="#1E1E1E"
                                                VerticalAlignment="Center">
                                            <Grid>
                                                <TextBlock x:Name="ArtFallback" Text="&#xE8D6;"
                                                           FontFamily="{StaticResource Icons}" FontSize="34" Opacity="0.35"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Border CornerRadius="14">
                                                    <Border.Background>
                                                        <ImageBrush x:Name="ArtBrush" Stretch="UniformToFill"/>
                                                    </Border.Background>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <DockPanel Grid.Column="1" Margin="14,0,0,0" LastChildFill="False">
                                            <TextBlock x:Name="TitleText" DockPanel.Dock="Top" FontSize="15"
                                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock x:Name="ArtistText" DockPanel.Dock="Top" FontSize="13" Opacity="0.65"
                                                       TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                            <TextBlock x:Name="SourceText" DockPanel.Dock="Top" FontSize="11" Opacity="0.4"
                                                       TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>

                                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                                                        HorizontalAlignment="Center">
                                                <Button Style="{StaticResource IconButton}" Content="&#xE892;"
                                                        Click="Previous_Click" ToolTip="Anterior"/>
                                                <Button x:Name="PlayPauseButton" Style="{StaticResource IconButton}"
                                                        Content="&#xE768;" FontSize="20" Width="44" Height="44"
                                                        Margin="6,0" Click="PlayPause_Click" ToolTip="Tocar/Pausar"/>
                                                <Button Style="{StaticResource IconButton}" Content="&#xE893;"
                                                        Click="Next_Click" ToolTip="Próxima"/>
                                            </StackPanel>

                                            <Grid x:Name="ProgressRow" DockPanel.Dock="Bottom" Margin="0,0,0,2">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Border x:Name="ProgressTrack" Height="4" CornerRadius="2"
                                                        Background="#33FFFFFF"/>
                                                <Border x:Name="ProgressFill" Height="4" CornerRadius="2"
                                                        Background="{DynamicResource Accent}"
                                                        HorizontalAlignment="Left" Width="0"/>
                                                <Grid Grid.Row="1" Margin="0,3,0,0">
                                                    <TextBlock x:Name="PositionText" FontSize="10" Opacity="0.5"/>
                                                    <TextBlock x:Name="DurationText" FontSize="10" Opacity="0.5"
                                                               HorizontalAlignment="Right"/>
                                                </Grid>
                                            </Grid>
                                        </DockPanel>
                                    </Grid>

                                    <StackPanel x:Name="NoMediaPanel" VerticalAlignment="Center"
                                                HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource Icons}" FontSize="28"
                                                   Opacity="0.3" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Nada tocando" FontSize="13" Opacity="0.45" Margin="0,8,0,0"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <Border Grid.Column="2" x:Name="ShelfZone" CornerRadius="14" BorderThickness="1"
                                        BorderBrush="#30FFFFFF" Background="#0DFFFFFF">
                                    <Grid>
                                        <StackPanel x:Name="ShelfHint" VerticalAlignment="Center"
                                                    HorizontalAlignment="Center" IsHitTestVisible="False">
                                            <TextBlock Text="&#xE896;" FontFamily="{StaticResource Icons}" FontSize="22"
                                                       Opacity="0.4" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Arraste arquivos aqui" FontSize="12" Opacity="0.45"
                                                       Margin="0,8,0,0" HorizontalAlignment="Center"/>
                                        </StackPanel>

                                        <ScrollViewer VerticalScrollBarVisibility="Hidden"
                                                      HorizontalScrollBarVisibility="Disabled" Margin="4,4,4,22">
                                            <ItemsControl x:Name="ShelfItems">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid x:Name="Root" Width="60" Height="62" Margin="1"
                                                              Background="Transparent" Cursor="Hand"
                                                              ToolTip="{Binding Path}"
                                                              PreviewMouseLeftButtonDown="ShelfItem_MouseDown"
                                                              MouseMove="ShelfItem_MouseMove">
                                                            <Image Source="{Binding Icon}" Width="32" Height="32"
                                                                   VerticalAlignment="Top" Margin="0,5,0,0"/>
                                                            <TextBlock Text="{Binding Name}" FontSize="10" Opacity="0.85"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       TextAlignment="Center"
                                                                       VerticalAlignment="Bottom" Margin="2,0,2,3"/>
                                                            <Button x:Name="RemoveButton"
                                                                    Style="{StaticResource IconButton}"
                                                                    Content="&#xE711;" FontSize="8" Width="18" Height="18"
                                                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                                                    Visibility="Hidden" Click="ShelfRemove_Click"
                                                                    ToolTip="Remover da prateleira"/>
                                                        </Grid>
                                                        <DataTemplate.Triggers>
                                                            <Trigger SourceName="Root" Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="RemoveButton" Property="Visibility"
                                                                        Value="Visible"/>
                                                                <Setter TargetName="Root" Property="Background"
                                                                        Value="#14FFFFFF"/>
                                                            </Trigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>

                                        <Button x:Name="ClearShelfButton" Style="{StaticResource IconButton}"
                                                Content="&#xE74D;" FontSize="11" Width="22" Height="22" Margin="0,0,4,2"
                                                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                Click="ClearShelf_Click" ToolTip="Limpar prateleira"/>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- ── Notas ── -->
                            <Border x:Name="PageNotes" Visibility="Collapsed" CornerRadius="14" Background="#0DFFFFFF"
                                    BorderBrush="#30FFFFFF" BorderThickness="1" Padding="12,8"
                                    MouseEnter="NotesArea_MouseEnter" MouseLeave="NotesArea_MouseLeave">
                                <Grid>
                                    <TextBlock x:Name="NotesPlaceholder" Text="Escreva uma anotação…" FontSize="13"
                                               Opacity="0.4" IsHitTestVisible="False" Margin="2,0,0,0"/>
                                    <TextBox x:Name="NotesBox" Style="{StaticResource NotesBox}"
                                             PreviewMouseLeftButtonDown="NotesBox_PreviewMouseDown"
                                             TextChanged="NotesBox_TextChanged"
                                             PreviewKeyDown="NotesBox_PreviewKeyDown"/>
                                </Grid>
                            </Border>

                            <!-- ── Timer ── -->
                            <Grid x:Name="PageTimer" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="230"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock x:Name="TimerDisplay" Text="5:00" FontSize="52" FontWeight="Light"
                                               HorizontalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
                                    <TextBlock x:Name="TimerStatus" Text="Pronto" FontSize="12" Opacity="0.5"
                                               HorizontalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                                        <Button x:Name="TimerStartButton" Style="{StaticResource IconButton}"
                                                Content="&#xE768;" FontSize="18" Width="42" Height="42"
                                                Click="TimerStartPause_Click" ToolTip="Iniciar/Pausar"/>
                                        <Button Style="{StaticResource IconButton}" Content="&#xE72C;" Margin="6,0,0,0"
                                                Click="TimerReset_Click" ToolTip="Reiniciar"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Início rápido" FontSize="11" Opacity="0.5" Margin="0,0,0,8"/>
                                    <WrapPanel>
                                        <Button Style="{StaticResource ChipButton}" Content="1 min" Tag="1" Click="TimerPreset_Click"/>
                                        <Button Style="{StaticResource ChipButton}" Content="5 min" Tag="5" Click="TimerPreset_Click"/>
                                        <Button Style="{StaticResource ChipButton}" Content="10 min" Tag="10" Click="TimerPreset_Click"/>
                                        <Button Style="{StaticResource ChipButton}" Content="15 min" Tag="15" Click="TimerPreset_Click"/>
                                        <Button Style="{StaticResource ChipButton}" Content="25 min" Tag="25" Click="TimerPreset_Click"/>
                                        <Button Style="{StaticResource ChipButton}" Content="45 min" Tag="45" Click="TimerPreset_Click"/>
                                        <Button Style="{StaticResource ChipButton}" Content="1 h" Tag="60" Click="TimerPreset_Click"/>
                                    </WrapPanel>
                                    <WrapPanel Margin="0,4,0,0">
                                        <Button Style="{StaticResource ChipButton}" Content="+1 min" Tag="1" Click="TimerAdd_Click"/>
                                        <Button Style="{StaticResource ChipButton}" Content="+5 min" Tag="5" Click="TimerAdd_Click"/>
                                        <Button Style="{StaticResource ChipButton}" Content="−1 min" Tag="-1" Click="TimerAdd_Click"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Grid>

                            <!-- ── Área de transferência ── -->
                            <Grid x:Name="PageClipboard" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock x:Name="ClipboardStatus" Text="Clique em um item para copiar de novo"
                                               FontSize="11" Opacity="0.5" VerticalAlignment="Center"/>
                                    <Button Style="{StaticResource ChipButton}" Content="Limpar" Margin="0"
                                            HorizontalAlignment="Right" Click="ClipboardClear_Click"/>
                                </Grid>
                                <TextBlock x:Name="ClipboardEmpty" Grid.Row="1" Text="Nada copiado ainda" FontSize="13"
                                           Opacity="0.4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                                    <ItemsControl x:Name="ClipboardItems">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="Row" CornerRadius="8" Background="#0DFFFFFF"
                                                        Padding="10,5" Margin="0,0,0,4" Cursor="Hand"
                                                        ToolTip="{Binding Text}"
                                                        MouseLeftButtonUp="ClipItem_Click">
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Time}"
                                                                   FontSize="10" Opacity="0.4" Margin="8,0,0,0"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Preview}" FontSize="12"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </DockPanel>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Row" Property="Background" Value="#26FFFFFF"/>
                                                    </Trigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
