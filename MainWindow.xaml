<Window x:Class="Ilha.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Ilha"
        Title="Ilha" Width="700" Height="300"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        FontFamily="{DynamicResource UiFont}" FontSize="13" Foreground="White"
        UseLayoutRounding="False"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Grayscale">

    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#7CE3A1"/>
        <SolidColorBrush x:Key="Secondary" Color="#B8FFFFFF"/>
        <SolidColorBrush x:Key="Tertiary" Color="#80FFFFFF"/>

        <!-- Cartão de vidro dentro da ilha -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#12FFFFFF"/>
            <Setter Property="BorderBrush" Value="#1FFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
        </Style>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value><ScaleTransform/></Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="999">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1FFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#38FFFFFF"/>
                                <Setter Property="RenderTransform">
                                    <Setter.Value><ScaleTransform ScaleX="0.92" ScaleY="0.92"/></Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChipButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Background" Value="#1AFFFFFF"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="999"
                                    Padding="{TemplateBinding Padding}" BorderBrush="#14FFFFFF" BorderThickness="1">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border x:Name="Hover" CornerRadius="999" Background="White" Opacity="0"
                                    IsHitTestVisible="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="0.08"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="0.18"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Abas em controle segmentado -->
        <Style x:Key="TabButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#8CFFFFFF"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="GroupName" Value="Tabs"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#D9FFFFFF"/>
                                <Setter TargetName="Bg" Property="Background" Value="#0FFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#2EFFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NotesBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="AcceptsTab" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Hidden"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Background="Transparent" Focusable="False"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1"/>
        </Grid.LayoutTransform>

        <!-- A ilha: pendurada na borda superior, cresce a partir do centro -->
        <Border x:Name="Island"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                Width="190" Height="34" Background="Transparent" CornerRadius="0,0,22,22"
                AllowDrop="True"
                MouseEnter="Island_MouseEnter" MouseLeave="Island_MouseLeave"
                DragEnter="Island_DragOver" DragOver="Island_DragOver"
                DragLeave="Island_DragLeave" Drop="Island_Drop">
            <Grid>
                <!-- Material: cor (sólida ou translúcida sobre o desfoque), brilho e borda de luz -->
                <Border x:Name="IslandFill" CornerRadius="{Binding CornerRadius, ElementName=Island}" Background="Black"/>
                <Border x:Name="IslandSheen" CornerRadius="{Binding CornerRadius, ElementName=Island}"
                        IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#1AFFFFFF" Offset="0"/>
                            <GradientStop Color="#05FFFFFF" Offset="0.45"/>
                            <GradientStop Color="#00FFFFFF" Offset="0.7"/>
                            <GradientStop Color="#0CFFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Border x:Name="IslandRim" CornerRadius="{Binding CornerRadius, ElementName=Island}"
                        BorderThickness="1,0,1,1" IsHitTestVisible="False">
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0.3,1">
                            <GradientStop Color="#00FFFFFF" Offset="0"/>
                            <GradientStop Color="#26FFFFFF" Offset="0.55"/>
                            <GradientStop Color="#59FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                </Border>

                <Grid ClipToBounds="True">

                    <!-- Estado recolhido -->
                    <Grid x:Name="CollapsedView" Height="34" VerticalAlignment="Top" Margin="14,0" Opacity="0"
                          IsHitTestVisible="False">
                        <Border x:Name="MiniArt" Width="22" Height="22" CornerRadius="6" HorizontalAlignment="Left"
                                Background="#2A2A2A">
                            <Border CornerRadius="6">
                                <Border.Background>
                                    <ImageBrush x:Name="MiniArtBrush" Stretch="UniformToFill"/>
                                </Border.Background>
                            </Border>
                        </Border>
                        <StackPanel x:Name="Bars" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Rectangle x:Name="Bar1" Width="3" Height="14" Margin="1.5,0" RadiusX="1.5" RadiusY="1.5"
                                       Fill="{DynamicResource Accent}" RenderTransformOrigin="0.5,0.5">
                                <Rectangle.RenderTransform><ScaleTransform ScaleY="0.4"/></Rectangle.RenderTransform>
                            </Rectangle>
                            <Rectangle x:Name="Bar2" Width="3" Height="14" Margin="1.5,0" RadiusX="1.5" RadiusY="1.5"
                                       Fill="{DynamicResource Accent}" RenderTransformOrigin="0.5,0.5">
                                <Rectangle.RenderTransform><ScaleTransform ScaleY="0.7"/></Rectangle.RenderTransform>
                            </Rectangle>
                            <Rectangle x:Name="Bar3" Width="3" Height="14" Margin="1.5,0" RadiusX="1.5" RadiusY="1.5"
                                       Fill="{DynamicResource Accent}" RenderTransformOrigin="0.5,0.5">
                                <Rectangle.RenderTransform><ScaleTransform ScaleY="0.5"/></Rectangle.RenderTransform>
                            </Rectangle>
                            <Rectangle x:Name="Bar4" Width="3" Height="14" Margin="1.5,0" RadiusX="1.5" RadiusY="1.5"
                                       Fill="{DynamicResource Accent}" RenderTransformOrigin="0.5,0.5">
                                <Rectangle.RenderTransform><ScaleTransform ScaleY="0.6"/></Rectangle.RenderTransform>
                            </Rectangle>
                        </StackPanel>
                        <TextBlock x:Name="CollapsedTimerText" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"
                                   Typography.NumeralAlignment="Tabular"/>
                    </Grid>

                    <!-- Aviso rápido (volume, carregando, nova música) -->
                    <DockPanel x:Name="PeekView" Height="34" VerticalAlignment="Top" Margin="14,0" Opacity="0"
                               IsHitTestVisible="False" LastChildFill="True">
                        <Grid DockPanel.Dock="Left" Width="22" VerticalAlignment="Center">
                            <local:Glyph x:Name="PeekGlyph" Size="16" Filled="True"/>
                            <local:Glyph x:Name="PeekGlyph2" Size="16"/>
                            <Border x:Name="PeekArt" Width="22" Height="22" CornerRadius="6" Visibility="Collapsed">
                                <Border.Background>
                                    <ImageBrush x:Name="PeekArtBrush" Stretch="UniformToFill"/>
                                </Border.Background>
                            </Border>
                        </Grid>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid x:Name="PeekBar" Width="70" Height="5" VerticalAlignment="Center">
                                <Border CornerRadius="2.5" Background="#33FFFFFF"/>
                                <Border x:Name="PeekBarFill" CornerRadius="2.5" Background="White"
                                        HorizontalAlignment="Left" Width="35"/>
                            </Grid>
                            <TextBlock x:Name="PeekValue" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0"
                                       Typography.NumeralAlignment="Tabular" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="PeekText" FontSize="12.5" FontWeight="Medium" Margin="10,0,10,0"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>

                    <!-- Estado expandido (tamanho fixo; a ilha revela a partir do centro) -->
                    <Grid x:Name="ExpandedView" Width="620" Height="228"
                          HorizontalAlignment="Center" VerticalAlignment="Top"
                          Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="0.5,0">
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="ExpandedScale" ScaleX="0.97" ScaleY="0.97"/>
                                <TranslateTransform x:Name="ExpandedShift" Y="-6"/>
                            </TransformGroup>
                        </Grid.RenderTransform>
                        <Grid Margin="22,10,22,18">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Cabeçalho -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="ClockText" FontSize="15" FontWeight="SemiBold"
                                               Typography.NumeralAlignment="Tabular"/>
                                    <TextBlock x:Name="DateText" FontSize="12" Foreground="{StaticResource Tertiary}"
                                               Margin="8,1,0,0" VerticalAlignment="Center"/>
                                </StackPanel>

                                <Border x:Name="TabBar" Grid.Column="1" CornerRadius="10" Background="#14FFFFFF"
                                        BorderBrush="#14FFFFFF" BorderThickness="1" Padding="2" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="TabHome" Style="{StaticResource TabButton}" Tag="home"
                                                     ToolTip="Início" IsChecked="True" Checked="Tab_Checked">
                                            <local:Glyph Data="{StaticResource IcoHome}" Size="15"/>
                                        </RadioButton>
                                        <RadioButton x:Name="TabNotes" Style="{StaticResource TabButton}" Tag="notes"
                                                     ToolTip="Notas" Checked="Tab_Checked">
                                            <local:Glyph Data="{StaticResource IcoNotes}" Size="15"/>
                                        </RadioButton>
                                        <RadioButton x:Name="TabTimer" Style="{StaticResource TabButton}" Tag="timer"
                                                     ToolTip="Timer" Checked="Tab_Checked">
                                            <local:Glyph Data="{StaticResource IcoTimer}" Size="15"/>
                                        </RadioButton>
                                        <RadioButton x:Name="TabClipboard" Style="{StaticResource TabButton}" Tag="clipboard"
                                                     ToolTip="Área de transferência" Checked="Tab_Checked">
                                            <local:Glyph Data="{StaticResource IcoClipboard}" Size="15"/>
                                        </RadioButton>
                                        <RadioButton x:Name="TabMirror" Style="{StaticResource TabButton}" Tag="mirror"
                                                     ToolTip="Espelho (câmera)" Checked="Tab_Checked">
                                            <local:Glyph Data="{StaticResource IcoMirror}" Size="15"/>
                                        </RadioButton>
                                    </StackPanel>
                                </Border>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                    <Button x:Name="UpdateButton" Style="{StaticResource ChipButton}" Margin="0,0,10,0"
                                            Padding="10,3" Foreground="{DynamicResource Accent}" Visibility="Collapsed"
                                            Click="UpdateButton_Click" Content="Atualizar"/>
                                    <StackPanel x:Name="BatteryPanel" Orientation="Horizontal" VerticalAlignment="Center"
                                                Margin="0,0,8,0">
                                        <TextBlock x:Name="BatteryText" FontSize="12" Foreground="{StaticResource Secondary}"
                                                   VerticalAlignment="Center" Margin="0,0,6,0"
                                                   Typography.NumeralAlignment="Tabular"/>
                                        <Grid Width="25" Height="12" VerticalAlignment="Center">
                                            <Border Width="22" HorizontalAlignment="Left" CornerRadius="3.5"
                                                    BorderBrush="#73FFFFFF" BorderThickness="1"/>
                                            <Border x:Name="BatteryFill" Width="18" HorizontalAlignment="Left"
                                                    Margin="2,2,0,2" CornerRadius="1.6" Background="White"/>
                                            <Border Width="2" Height="4" HorizontalAlignment="Right" Margin="0,0,0.5,0"
                                                    CornerRadius="0,1,1,0" Background="#73FFFFFF"/>
                                            <local:Glyph x:Name="ChargingIcon" Data="{StaticResource IcoBolt}" Filled="True"
                                                         Size="9" HorizontalAlignment="Left" Margin="6.5,0,0,0"
                                                         Foreground="Black"/>
                                        </Grid>
                                    </StackPanel>
                                    <Button Style="{StaticResource IconButton}" Width="28" Height="28"
                                            Click="Settings_Click" ToolTip="Configurações">
                                        <local:Glyph Data="{StaticResource IcoSettings}" Size="16"/>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <Grid x:Name="Pages" Grid.Row="1" Margin="0,12,0,0">

                                <!-- ── Início: mídia + calendário + prateleira ── -->
                                <Grid x:Name="PageHome">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition x:Name="HomeMediaCol" Width="*"/>
                                        <ColumnDefinition x:Name="HomeGap1" Width="12"/>
                                        <ColumnDefinition x:Name="HomeCalCol" Width="112"/>
                                        <ColumnDefinition x:Name="HomeGap2" Width="12"/>
                                        <ColumnDefinition x:Name="HomeShelfCol" Width="168"/>
                                    </Grid.ColumnDefinitions>

                                    <Grid x:Name="MediaArea">
                                        <Grid x:Name="MediaDetails">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Width="96" Height="96" CornerRadius="16" VerticalAlignment="Center">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#33FFFFFF" Offset="0"/>
                                                        <GradientStop Color="#0DFFFFFF" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.35"/>
                                                </Border.Effect>
                                                <Grid>
                                                    <local:Glyph x:Name="ArtFallback" Data="{StaticResource IcoMusic}" Size="30"
                                                                 Foreground="#66FFFFFF"/>
                                                    <Border CornerRadius="16">
                                                        <Border.Background>
                                                            <ImageBrush x:Name="ArtBrush" Stretch="UniformToFill"/>
                                                        </Border.Background>
                                                    </Border>
                                                </Grid>
                                            </Border>

                                            <DockPanel Grid.Column="1" Margin="16,2,0,0" LastChildFill="False">
                                                <TextBlock x:Name="TitleText" DockPanel.Dock="Top" FontSize="14.5"
                                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock x:Name="ArtistText" DockPanel.Dock="Top" FontSize="12.5"
                                                           Foreground="{StaticResource Secondary}"
                                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                <TextBlock x:Name="SourceText" DockPanel.Dock="Top" FontSize="11"
                                                           Foreground="{StaticResource Tertiary}"
                                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>

                                                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                                                            HorizontalAlignment="Center">
                                                    <Button Style="{StaticResource IconButton}" Click="Previous_Click"
                                                            ToolTip="Anterior">
                                                        <local:Glyph Data="{StaticResource IcoPrev}" Filled="True" Size="17"/>
                                                    </Button>
                                                    <Button x:Name="PlayPauseButton" Style="{StaticResource IconButton}"
                                                            Width="42" Height="42" Margin="10,0" Click="PlayPause_Click"
                                                            ToolTip="Tocar/Pausar">
                                                        <local:Glyph x:Name="PlayPauseGlyph" Data="{StaticResource IcoPlay}"
                                                                     Filled="True" Size="22"/>
                                                    </Button>
                                                    <Button Style="{StaticResource IconButton}" Click="Next_Click"
                                                            ToolTip="Próxima">
                                                        <local:Glyph Data="{StaticResource IcoNext}" Filled="True" Size="17"/>
                                                    </Button>
                                                </StackPanel>

                                                <Grid x:Name="ProgressRow" DockPanel.Dock="Bottom" Margin="0,0,0,4">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid x:Name="ProgressHit" Height="12" Background="Transparent" Cursor="Hand"
                                                          MouseLeftButtonDown="Progress_MouseDown"
                                                          MouseEnter="Progress_MouseEnter" MouseLeave="Progress_MouseLeave">
                                                        <Border x:Name="ProgressTrack" Height="4" CornerRadius="2"
                                                                Background="#2EFFFFFF" VerticalAlignment="Center"/>
                                                        <Border x:Name="ProgressFill" Height="4" CornerRadius="2"
                                                                Background="#E6FFFFFF" VerticalAlignment="Center"
                                                                HorizontalAlignment="Left" Width="0"/>
                                                    </Grid>
                                                    <Grid Grid.Row="1" Margin="0,1,0,0">
                                                        <TextBlock x:Name="PositionText" FontSize="11"
                                                                   Foreground="{StaticResource Tertiary}"
                                                                   Typography.NumeralAlignment="Tabular"/>
                                                        <TextBlock x:Name="DurationText" FontSize="11"
                                                                   Foreground="{StaticResource Tertiary}"
                                                                   Typography.NumeralAlignment="Tabular"
                                                                   HorizontalAlignment="Right"/>
                                                    </Grid>
                                                </Grid>
                                            </DockPanel>
                                        </Grid>

                                        <StackPanel x:Name="NoMediaPanel" VerticalAlignment="Center"
                                                    HorizontalAlignment="Center">
                                            <local:Glyph Data="{StaticResource IcoMusic}" Size="28" Foreground="#4DFFFFFF"/>
                                            <TextBlock Text="Nada tocando" FontSize="13" Foreground="{StaticResource Tertiary}"
                                                       Margin="0,10,0,0" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Toque algo no Spotify, YouTube…" FontSize="11"
                                                       Foreground="#40FFFFFF" Margin="0,2,0,0"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Calendário -->
                                    <Border x:Name="CalendarCard" Grid.Column="2" Style="{StaticResource Card}" Padding="8,9">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock x:Name="CalMonth" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Accent}"/>
                                            <TextBlock x:Name="CalDay" Grid.Row="1" FontSize="40" FontWeight="Light"
                                                       Margin="-1,-3,0,-5"/>
                                            <TextBlock x:Name="CalWeekday" Grid.Row="2" FontSize="11.5"
                                                       Foreground="{StaticResource Secondary}"/>
                                            <UniformGrid x:Name="CalWeek" Grid.Row="4" Rows="2" Columns="7"/>
                                        </Grid>
                                    </Border>

                                    <!-- Prateleira -->
                                    <Border Grid.Column="4" x:Name="ShelfZone" Style="{StaticResource Card}">
                                        <Grid>
                                            <StackPanel x:Name="ShelfHint" VerticalAlignment="Center"
                                                        HorizontalAlignment="Center" IsHitTestVisible="False">
                                                <local:Glyph Data="{StaticResource IcoTray}" Size="24" Foreground="#73FFFFFF"/>
                                                <TextBlock Text="Solte arquivos aqui" FontSize="12"
                                                           Foreground="{StaticResource Tertiary}"
                                                           Margin="0,8,0,0" HorizontalAlignment="Center"/>
                                            </StackPanel>

                                            <ScrollViewer VerticalScrollBarVisibility="Hidden"
                                                          HorizontalScrollBarVisibility="Disabled" Margin="5,5,5,24">
                                                <ItemsControl x:Name="ShelfItems">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border x:Name="Root" Width="52" Height="60" Margin="1"
                                                                    CornerRadius="10" Background="Transparent" Cursor="Hand"
                                                                    ToolTip="{Binding Path}"
                                                                    PreviewMouseLeftButtonDown="ShelfItem_MouseDown"
                                                                    MouseMove="ShelfItem_MouseMove">
                                                                <Grid>
                                                                    <Image Source="{Binding Icon}" Width="30" Height="30"
                                                                           VerticalAlignment="Top" Margin="0,6,0,0"/>
                                                                    <TextBlock Text="{Binding Name}" FontSize="10"
                                                                               Foreground="{StaticResource Secondary}"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               TextAlignment="Center"
                                                                               VerticalAlignment="Bottom" Margin="3,0,3,4"/>
                                                                    <Button x:Name="RemoveButton"
                                                                            Style="{StaticResource IconButton}"
                                                                            Width="16" Height="16" Background="#59000000"
                                                                            HorizontalAlignment="Right" VerticalAlignment="Top"
                                                                            Margin="0,1,1,0"
                                                                            Visibility="Hidden" Click="ShelfRemove_Click"
                                                                            ToolTip="Remover da prateleira">
                                                                        <local:Glyph Data="{StaticResource IcoClose}" Size="10"
                                                                                     Thickness="3"/>
                                                                    </Button>
                                                                </Grid>
                                                            </Border>
                                                            <DataTemplate.Triggers>
                                                                <Trigger SourceName="Root" Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="RemoveButton" Property="Visibility"
                                                                            Value="Visible"/>
                                                                    <Setter TargetName="Root" Property="Background"
                                                                            Value="#17FFFFFF"/>
                                                                </Trigger>
                                                            </DataTemplate.Triggers>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>

                                            <Button x:Name="ClearShelfButton" Style="{StaticResource IconButton}"
                                                    Width="22" Height="22" Margin="0,0,5,3"
                                                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                    Click="ClearShelf_Click" ToolTip="Limpar prateleira">
                                                <local:Glyph Data="{StaticResource IcoTrash}" Size="13" Foreground="#A6FFFFFF"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <!-- ── Notas ── -->
                                <Border x:Name="PageNotes" Visibility="Collapsed" Style="{StaticResource Card}" Padding="14,10"
                                        MouseEnter="NotesArea_MouseEnter" MouseLeave="NotesArea_MouseLeave">
                                    <Grid>
                                        <TextBlock x:Name="NotesPlaceholder" Text="Escreva uma anotação…" FontSize="13.5"
                                                   Foreground="{StaticResource Tertiary}" IsHitTestVisible="False"
                                                   Margin="2,0,0,0"/>
                                        <TextBox x:Name="NotesBox" Style="{StaticResource NotesBox}"
                                                 PreviewMouseLeftButtonDown="NotesBox_PreviewMouseDown"
                                                 TextChanged="NotesBox_TextChanged"
                                                 PreviewKeyDown="NotesBox_PreviewKeyDown"/>
                                    </Grid>
                                </Border>

                                <!-- ── Timer ── -->
                                <Grid x:Name="PageTimer" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Grid Width="148" Height="148" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Ellipse Stroke="#1FFFFFFF" StrokeThickness="6" Margin="3"/>
                                        <Path x:Name="TimerRing" Stroke="{DynamicResource Accent}" StrokeThickness="6"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock x:Name="TimerDisplay" Text="5:00" FontSize="32" FontWeight="Light"
                                                       HorizontalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
                                            <TextBlock x:Name="TimerStatus" Text="Pronto" FontSize="11.5"
                                                       Foreground="{StaticResource Secondary}" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                            <Button x:Name="TimerStartButton" Style="{StaticResource ChipButton}"
                                                    Padding="16,7" Margin="0,0,8,0" Click="TimerStartPause_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <local:Glyph x:Name="TimerStartGlyph" Data="{StaticResource IcoPlay}"
                                                                 Filled="True" Size="12" Margin="0,0,7,0"/>
                                                    <TextBlock x:Name="TimerStartText" Text="Iniciar" FontSize="13"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource ChipButton}" Padding="14,7" Margin="0"
                                                    Click="TimerReset_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <local:Glyph Data="{StaticResource IcoReset}" Size="13" Margin="0,0,6,0"/>
                                                    <TextBlock Text="Zerar" FontSize="13"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                        <TextBlock Text="Início rápido" FontSize="11" Foreground="{StaticResource Tertiary}"
                                                   Margin="0,0,0,8"/>
                                        <WrapPanel>
                                            <Button Style="{StaticResource ChipButton}" Content="1 min" Tag="1" Click="TimerPreset_Click"/>
                                            <Button Style="{StaticResource ChipButton}" Content="5 min" Tag="5" Click="TimerPreset_Click"/>
                                            <Button Style="{StaticResource ChipButton}" Content="10 min" Tag="10" Click="TimerPreset_Click"/>
                                            <Button Style="{StaticResource ChipButton}" Content="15 min" Tag="15" Click="TimerPreset_Click"/>
                                            <Button Style="{StaticResource ChipButton}" Content="25 min" Tag="25" Click="TimerPreset_Click"/>
                                            <Button Style="{StaticResource ChipButton}" Content="45 min" Tag="45" Click="TimerPreset_Click"/>
                                            <Button Style="{StaticResource ChipButton}" Content="1 h" Tag="60" Click="TimerPreset_Click"/>
                                            <Button Style="{StaticResource ChipButton}" Content="+1 min" Tag="1" Click="TimerAdd_Click"/>
                                            <Button Style="{StaticResource ChipButton}" Content="+5 min" Tag="5" Click="TimerAdd_Click"/>
                                            <Button Style="{StaticResource ChipButton}" Content="−1 min" Tag="-1" Click="TimerAdd_Click"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Grid>

                                <!-- ── Área de transferência ── -->
                                <Grid x:Name="PageClipboard" Visibility="Collapsed">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock x:Name="ClipboardStatus" Text="Clique em um item para copiar de novo"
                                                   FontSize="11.5" Foreground="{StaticResource Tertiary}"
                                                   VerticalAlignment="Center"/>
                                        <Button Style="{StaticResource ChipButton}" Content="Limpar" Margin="0" Padding="11,3"
                                                HorizontalAlignment="Right" Click="ClipboardClear_Click"/>
                                    </Grid>
                                    <StackPanel x:Name="ClipboardEmpty" Grid.Row="1" HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                        <local:Glyph Data="{StaticResource IcoClipboard}" Size="26" Foreground="#4DFFFFFF"/>
                                        <TextBlock Text="Nada copiado ainda" FontSize="13" Foreground="{StaticResource Tertiary}"
                                                   Margin="0,8,0,0"/>
                                    </StackPanel>
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                                        <ItemsControl x:Name="ClipboardItems">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border x:Name="Row" CornerRadius="10" Background="#10FFFFFF"
                                                            BorderBrush="#14FFFFFF" BorderThickness="1"
                                                            Padding="12,6" Margin="0,0,0,5" Cursor="Hand"
                                                            ToolTip="{Binding Text}"
                                                            MouseLeftButtonUp="ClipItem_Click">
                                                        <DockPanel>
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Time}"
                                                                       FontSize="11" Foreground="{StaticResource Tertiary}"
                                                                       Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding Preview}" FontSize="12.5"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                        </DockPanel>
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Row" Property="Background" Value="#24FFFFFF"/>
                                                        </Trigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>

                                <!-- ── Espelho (câmera) ── -->
                                <Grid x:Name="PageMirror" Visibility="Collapsed">
                                    <Border x:Name="MirrorFrame" Width="300" Style="{StaticResource Card}"
                                            HorizontalAlignment="Center" ClipToBounds="True">
                                        <Grid>
                                            <Border x:Name="MirrorImage" CornerRadius="15" RenderTransformOrigin="0.5,0.5">
                                                <Border.RenderTransform>
                                                    <ScaleTransform ScaleX="-1"/>
                                                </Border.RenderTransform>
                                                <Border.Background>
                                                    <ImageBrush x:Name="MirrorBrush" Stretch="UniformToFill"/>
                                                </Border.Background>
                                            </Border>
                                            <StackPanel x:Name="MirrorPlaceholder" VerticalAlignment="Center"
                                                        HorizontalAlignment="Center" Margin="16,0">
                                                <local:Glyph Data="{StaticResource IcoMirror}" Size="26" Foreground="#73FFFFFF"/>
                                                <TextBlock x:Name="MirrorStatus" Text="Ligando a câmera…" FontSize="12"
                                                           Foreground="{StaticResource Secondary}" TextWrapping="Wrap"
                                                           TextAlignment="Center" Margin="0,8,0,0"/>
                                                <Button x:Name="MirrorRetry" Style="{StaticResource ChipButton}" Content="Tentar de novo"
                                                        HorizontalAlignment="Center" Margin="0,10,0,0"
                                                        Visibility="Collapsed" Click="MirrorRetry_Click"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
