<Window x:Class="Ilha.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Ilha"
        Title="{local:T 'Ilha'}" Width="720" Height="300"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        FontFamily="{DynamicResource UiFont}" FontSize="13" Foreground="{DynamicResource Ink_FF}"
        UseLayoutRounding="False"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Grayscale">

    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#7CE3A1"/>
        <!-- Cor tirada da capa da música (progresso, barrinhas, brilho); sem capa, é a cor de destaque -->
        <SolidColorBrush x:Key="MediaAccent" Color="#7CE3A1"/>
        <!-- Secondary, Tertiary, Hairline, CardFill, CardStroke e Ink_XX vêm do tema (ThemePalette) -->
        <!-- Gráficos: preenchimento que some suavemente para baixo -->
        <LinearGradientBrush x:Key="GraphFade" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FF000000" Offset="0"/>
            <GradientStop Color="#00000000" Offset="1"/>
        </LinearGradientBrush>

        <!-- Cartão: retângulo de cantos suaves, nunca pílula -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardFill}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStroke}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
        </Style>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{DynamicResource Tertiary}"/>
        </Style>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Ink_FF}"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value><ScaleTransform/></Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="9"/>
                            <Border x:Name="Hover" Background="{DynamicResource Ink_FF}" Opacity="0" CornerRadius="9"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <!-- O realce entra e sai com um fade curto, em vez de piscar -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"
                                                             To="0.11" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.22"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value><ScaleTransform ScaleX="0.9" ScaleY="0.9"/></Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botão principal (tocar/pausar): bloco claro de cantos suaves -->
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Foreground" Value="{DynamicResource InkInverse}"/>
            <Setter Property="Background" Value="{DynamicResource Ink_F2}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="12"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Ink_FF}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.8"/>
                                <Setter Property="RenderTransform">
                                    <Setter.Value><ScaleTransform ScaleX="0.93" ScaleY="0.93"/></Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChipButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Ink_FF}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Background" Value="{DynamicResource Ink_14}"/>
            <Setter Property="Padding" Value="11,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="9"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border x:Name="Hover" CornerRadius="9" Background="{DynamicResource Ink_FF}" Opacity="0"
                                    IsHitTestVisible="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="0.08"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="0.18"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bloco de modo do timer (Foco / Pausa / Longa) -->
        <Style x:Key="ModeTile" TargetType="Button" BasedOn="{StaticResource ChipButton}">
            <Setter Property="Width" Value="96"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="11"
                                    Padding="{TemplateBinding Padding}" BorderBrush="{DynamicResource Ink_12}" BorderThickness="1">
                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </Border>
                            <Border x:Name="Hover" CornerRadius="11" Background="{DynamicResource Ink_FF}" Opacity="0"
                                    IsHitTestVisible="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="0.08"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="0.18"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Abas: trilho vertical de blocos com cantos suaves -->
        <Style x:Key="TabButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Ink_8C}"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="GroupName" Value="Tabs"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="Sel" Background="{DynamicResource Accent}" CornerRadius="9" Opacity="0"/>
                            <Border x:Name="Hover" Background="{DynamicResource Ink_FF}" CornerRadius="9" Opacity="0"/>
                            <ContentPresenter x:Name="Icon" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RenderTransformOrigin="0.5,0.5">
                                <ContentPresenter.RenderTransform><ScaleTransform/></ContentPresenter.RenderTransform>
                            </ContentPresenter>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <!-- O ícone dá um pulinho com mola ao passar o mouse -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Ink_E6}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0.07" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="Icon" Duration="0:0:0.32" To="1.16"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)">
                                                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.9"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="Icon" Duration="0:0:0.32" To="1.16"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)">
                                                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.9"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22"/>
                                            <DoubleAnimation Storyboard.TargetName="Icon" Duration="0:0:0.24" To="1"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"/>
                                            <DoubleAnimation Storyboard.TargetName="Icon" Duration="0:0:0.24" To="1"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Ink_FF}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Caixa de seleção das tarefas: quadradinho de cantos suaves -->
        <Style x:Key="TodoCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Ink_FF}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <DockPanel Background="Transparent">
                            <Grid DockPanel.Dock="Left" Width="16" Height="16" VerticalAlignment="Center">
                                <Border x:Name="Box" CornerRadius="5" BorderThickness="1.5" BorderBrush="{DynamicResource Ink_73}"/>
                                <Border x:Name="Fill" CornerRadius="5" Background="{DynamicResource Accent}" Opacity="0"/>
                                <local:Glyph x:Name="Tick" Data="{StaticResource IcoCheck}" Size="13" Thickness="3"
                                             Foreground="#111111" Opacity="0"/>
                            </Grid>
                            <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center"/>
                        </DockPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Ink_BF}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Fill" Property="Opacity" Value="1"/>
                                <Setter TargetName="Tick" Property="Opacity" Value="1"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="Transparent"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NotesBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource Ink_FF}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Ink_FF}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="AcceptsTab" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Hidden"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Background="Transparent" Focusable="False"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LineBox" TargetType="TextBox" BasedOn="{StaticResource NotesBox}">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="AcceptsReturn" Value="False"/>
            <Setter Property="AcceptsTab" Value="False"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
        </Style>

        <!-- Texto das páginas das Notas (com negrito, itálico e sublinhado) -->
        <Style x:Key="NoteBodyBox" TargetType="RichTextBox">
            <Setter Property="Foreground" Value="{DynamicResource Ink_FF}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Ink_FF}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="AcceptsTab" Value="True"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Hidden"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RichTextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Background="Transparent" Focusable="False"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1"/>
        </Grid.LayoutTransform>

        <!-- A ilha: pendurada na borda superior, cresce a partir do centro -->
        <Border x:Name="Island"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                Width="190" Height="34" Background="Transparent" CornerRadius="0,0,14,14"
                AllowDrop="True"
                MouseEnter="Island_MouseEnter" MouseLeave="Island_MouseLeave"
                MouseLeftButtonDown="Island_MouseLeftButtonDown"
                DragEnter="Island_DragOver" DragOver="Island_DragOver"
                DragLeave="Island_DragLeave" Drop="Island_Drop">
            <Grid>
                <!-- Material: cor (sólida ou translúcida sobre o desfoque), brilho e borda de luz -->
                <Border x:Name="IslandFill" CornerRadius="{Binding CornerRadius, ElementName=Island}" Background="Black"/>
                <!-- Luz ambiente: a capa da música, bem pequena e esticada, vira um brilho colorido atrás de tudo -->
                <Grid x:Name="AmbientLayer" IsHitTestVisible="False" Opacity="0">
                    <Border x:Name="AmbientArt" Width="1100" Height="560" HorizontalAlignment="Center" VerticalAlignment="Top"
                            Margin="0,-150,0,0" RenderOptions.BitmapScalingMode="HighQuality">
                        <Border.Background>
                            <ImageBrush x:Name="AmbientBrush" Stretch="Fill"/>
                        </Border.Background>
                    </Border>
                    <Border x:Name="AmbientShade"/>
                </Grid>
                <Border x:Name="IslandSheen" CornerRadius="{Binding CornerRadius, ElementName=Island}"
                        IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#14FFFFFF" Offset="0"/>
                            <GradientStop Color="#04FFFFFF" Offset="0.4"/>
                            <GradientStop Color="#00FFFFFF" Offset="0.75"/>
                            <GradientStop Color="#0AFFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Border x:Name="IslandRim" CornerRadius="{Binding CornerRadius, ElementName=Island}"
                        BorderThickness="1,0,1,1" IsHitTestVisible="False">
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0.3,1">
                            <GradientStop Color="#00FFFFFF" Offset="0"/>
                            <GradientStop Color="#1FFFFFFF" Offset="0.55"/>
                            <GradientStop Color="#4DFFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                </Border>

                <Grid ClipToBounds="True">

                    <!-- Estado recolhido -->
                    <Grid x:Name="CollapsedView" Height="34" VerticalAlignment="Top" Margin="12,0" Opacity="0"
                          IsHitTestVisible="False">
                        <Border x:Name="MiniArt" Width="22" Height="22" CornerRadius="6" HorizontalAlignment="Left"
                                Background="#2A2A2A">
                            <Border CornerRadius="6">
                                <Border.Background>
                                    <ImageBrush x:Name="MiniArtBrush" Stretch="UniformToFill"/>
                                </Border.Background>
                            </Border>
                        </Border>
                        <StackPanel x:Name="Bars" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Rectangle x:Name="Bar1" Width="3" Height="14" Margin="1.5,0" RadiusX="1" RadiusY="1"
                                       Fill="{DynamicResource MediaAccent}" RenderTransformOrigin="0.5,0.5">
                                <Rectangle.RenderTransform><ScaleTransform ScaleY="0.4"/></Rectangle.RenderTransform>
                            </Rectangle>
                            <Rectangle x:Name="Bar2" Width="3" Height="14" Margin="1.5,0" RadiusX="1" RadiusY="1"
                                       Fill="{DynamicResource MediaAccent}" RenderTransformOrigin="0.5,0.5">
                                <Rectangle.RenderTransform><ScaleTransform ScaleY="0.7"/></Rectangle.RenderTransform>
                            </Rectangle>
                            <Rectangle x:Name="Bar3" Width="3" Height="14" Margin="1.5,0" RadiusX="1" RadiusY="1"
                                       Fill="{DynamicResource MediaAccent}" RenderTransformOrigin="0.5,0.5">
                                <Rectangle.RenderTransform><ScaleTransform ScaleY="0.5"/></Rectangle.RenderTransform>
                            </Rectangle>
                            <Rectangle x:Name="Bar4" Width="3" Height="14" Margin="1.5,0" RadiusX="1" RadiusY="1"
                                       Fill="{DynamicResource MediaAccent}" RenderTransformOrigin="0.5,0.5">
                                <Rectangle.RenderTransform><ScaleTransform ScaleY="0.6"/></Rectangle.RenderTransform>
                            </Rectangle>
                        </StackPanel>
                        <TextBlock x:Name="CollapsedTimerText" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"
                                   Typography.NumeralAlignment="Tabular"/>
                    </Grid>

                    <!-- Aviso rápido (volume, carregando, nova música) -->
                    <DockPanel x:Name="PeekView" Height="34" VerticalAlignment="Top" Margin="12,0" Opacity="0"
                               IsHitTestVisible="False" LastChildFill="True">
                        <Grid DockPanel.Dock="Left" Width="22" VerticalAlignment="Center">
                            <local:Glyph x:Name="PeekGlyph" Size="16" Filled="True"/>
                            <local:Glyph x:Name="PeekGlyph2" Size="16"/>
                            <Border x:Name="PeekArt" Width="22" Height="22" CornerRadius="6" Visibility="Collapsed">
                                <Border.Background>
                                    <ImageBrush x:Name="PeekArtBrush" Stretch="UniformToFill"/>
                                </Border.Background>
                            </Border>
                        </Grid>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid x:Name="PeekBar" Width="70" Height="5" VerticalAlignment="Center">
                                <Border CornerRadius="1.5" Background="{DynamicResource Ink_33}"/>
                                <Border x:Name="PeekBarFill" CornerRadius="1.5" Background="{DynamicResource Ink_FF}"
                                        HorizontalAlignment="Left" Width="35"/>
                            </Grid>
                            <TextBlock x:Name="PeekValue" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0"
                                       Typography.NumeralAlignment="Tabular" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="PeekText" FontSize="12.5" FontWeight="Medium" Margin="10,0,10,0"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>

                    <!-- Estado expandido (tamanho fixo; a ilha revela a partir do centro) -->
                    <Grid x:Name="ExpandedView" Width="660" Height="244"
                          HorizontalAlignment="Center" VerticalAlignment="Top"
                          Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="0.5,0">
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="ExpandedScale" ScaleX="0.97" ScaleY="0.97"/>
                                <TranslateTransform x:Name="ExpandedShift" Y="-6"/>
                            </TransformGroup>
                        </Grid.RenderTransform>
                        <!-- Ilha flutuante: canto para redimensionar com o mouse -->
                        <Grid x:Name="ResizeGrip" Width="18" Height="18" Margin="0,0,5,5" Background="Transparent"
                              HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE"
                              ToolTip="{local:T 'Arraste para redimensionar'}" Visibility="Collapsed"
                              MouseLeftButtonDown="ResizeGrip_MouseDown" MouseMove="ResizeGrip_MouseMove"
                              MouseLeftButtonUp="ResizeGrip_MouseUp" LostMouseCapture="ResizeGrip_LostCapture">
                            <Path Data="M15 7 7 15 M15 11.5 11.5 15" Stroke="{DynamicResource Ink_73}" StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Grid>
                        <!-- Conteúdo: em tamanhos pequenos (ilha flutuante) encolhe por igual, sem cortar -->
                        <Grid x:Name="ContentRoot" Margin="20,14,20,16" HorizontalAlignment="Left" VerticalAlignment="Top"
                              Width="626" Height="214">
                            <Grid.LayoutTransform>
                                <ScaleTransform x:Name="ContentScale" ScaleX="1" ScaleY="1"/>
                            </Grid.LayoutTransform>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="RailCol" Width="36"/>
                                <ColumnDefinition x:Name="RailGapCol" Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Trilho de abas (ou, com abas no topo, elas vão para o cabeçalho) -->
                            <Grid x:Name="RailHost">
                                <!-- Abas + destaque que desliza até a aba escolhida -->
                                <Grid x:Name="TabStrip" VerticalAlignment="Top" HorizontalAlignment="Left">
                                <Border x:Name="TabIndicator" Background="{DynamicResource Ink_FF}" Opacity="0.13" CornerRadius="9"
                                        HorizontalAlignment="Left" VerticalAlignment="Top" Width="36" Height="30" IsHitTestVisible="False">
                                    <Border.RenderTransform><TranslateTransform x:Name="TabIndicatorShift"/></Border.RenderTransform>
                                </Border>
                                <StackPanel x:Name="TabBar">
                                    <RadioButton x:Name="TabHome" Style="{StaticResource TabButton}" Tag="home"
                                                 ToolTip="{local:T 'Início'}" IsChecked="True" Checked="Tab_Checked">
                                        <local:Glyph x:Name="HomeTabGlyph" Data="{StaticResource FillHome}" Size="17" Filled="True" Thickness="0"/>
                                    </RadioButton>
                                    <RadioButton x:Name="TabShelf" Style="{StaticResource TabButton}" Tag="shelf"
                                                 ToolTip="{local:T 'Prateleira'}" Checked="Tab_Checked">
                                        <local:Glyph Data="{StaticResource IcoTray}" Size="16" Thickness="1.9"/>
                                    </RadioButton>
                                    <RadioButton x:Name="TabAgenda" Style="{StaticResource TabButton}" Tag="agenda"
                                                 ToolTip="{local:T 'Agenda'}" Checked="Tab_Checked">
                                        <local:Glyph Data="{StaticResource FillCalendar}" Size="17" Filled="True" Thickness="0"/>
                                    </RadioButton>
                                    <RadioButton x:Name="TabTasks" Style="{StaticResource TabButton}" Tag="tasks"
                                                 ToolTip="{local:T 'Tarefas do dia'}" Checked="Tab_Checked">
                                        <local:Glyph Data="{StaticResource FillTasks}" Size="17" Filled="True" Thickness="0"/>
                                    </RadioButton>
                                    <RadioButton x:Name="TabNotes" Style="{StaticResource TabButton}" Tag="notes"
                                                 ToolTip="{local:T 'Notas'}" Checked="Tab_Checked">
                                        <local:Glyph Data="{StaticResource FillNotes}" Size="17" Filled="True" Thickness="0"/>
                                    </RadioButton>
                                    <RadioButton x:Name="TabTimer" Style="{StaticResource TabButton}" Tag="timer"
                                                 ToolTip="{local:T 'Foco (timer)'}" Checked="Tab_Checked">
                                        <local:Glyph Data="{StaticResource FillTimer}" Size="17" Filled="True" Thickness="0"/>
                                    </RadioButton>
                                    <RadioButton x:Name="TabClipboard" Style="{StaticResource TabButton}" Tag="clipboard"
                                                 ToolTip="{local:T 'Área de transferência'}" Checked="Tab_Checked">
                                        <local:Glyph Data="{StaticResource FillClip}" Size="17" Filled="True" Thickness="0"/>
                                    </RadioButton>
                                    <RadioButton x:Name="TabMirror" Style="{StaticResource TabButton}" Tag="mirror"
                                                 ToolTip="{local:T 'Espelho (câmera)'}" Checked="Tab_Checked">
                                        <local:Glyph Data="{StaticResource FillCamera}" Size="17" Filled="True" Thickness="0"/>
                                    </RadioButton>
                                    <RadioButton x:Name="TabPrompter" Style="{StaticResource TabButton}" Tag="prompter"
                                                 ToolTip="{local:T 'Teleprompter'}" Checked="Tab_Checked">
                                        <local:Glyph Data="{StaticResource FillPrompter}" Size="17" Filled="True" Thickness="0"/>
                                    </RadioButton>
                                    <Button x:Name="AddTabButton" Style="{StaticResource IconButton}" Width="36" Height="26" Foreground="{DynamicResource Ink_73}"
                                            Click="AddFeatures_Click" ToolTip="{local:T 'Escolher recursos'}">
                                        <local:Glyph Data="{StaticResource IcoPlus}" Size="13" Thickness="2.4"/>
                                    </Button>
                                </StackPanel>
                                </Grid>
                            </Grid>

                            <!-- Linha fina separando o trilho do conteúdo -->
                            <Border x:Name="RailLine" Grid.Column="1" Width="1" HorizontalAlignment="Center" Margin="0,4"
                                    Background="{DynamicResource Hairline}"/>

                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition x:Name="HeaderRow" Height="26"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Cabeçalho (na ilha flutuante, arrastar por aqui move a ilha) -->
                                <Grid x:Name="HeaderBar" Background="Transparent"
                                      MouseLeftButtonDown="Header_MouseLeftButtonDown">
                                <DockPanel LastChildFill="False">
                                    <local:Glyph x:Name="GripGlyph" Data="{StaticResource IcoGrip}" Size="14" Thickness="3.2"
                                                 Foreground="{DynamicResource Ink_66}" Margin="-3,0,4,0" VerticalAlignment="Center"
                                                 Cursor="SizeAll" ToolTip="{local:T 'Arraste para mover a ilha'}"/>
                                    <TextBlock x:Name="ClockText" FontSize="15.5" FontWeight="Medium" VerticalAlignment="Center"
                                               Typography.NumeralAlignment="Tabular"/>
                                    <TextBlock x:Name="DateText" FontSize="12" Foreground="{DynamicResource Tertiary}"
                                               Margin="9,1,0,0" VerticalAlignment="Center"/>

                                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="28" Height="26"
                                            Margin="10,0,-4,0" Foreground="{DynamicResource Ink_A6}"
                                            Click="Settings_Click" ToolTip="{local:T 'Configurações'}">
                                        <local:Glyph Data="{StaticResource FillSettings}" Size="16" Filled="True" Thickness="0"/>
                                    </Button>
                                    <Button x:Name="PinButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                                            Width="28" Height="26" Margin="6,0,0,0" Foreground="{DynamicResource Ink_A6}"
                                            Click="Pin_Click">
                                        <local:Glyph x:Name="PinGlyph" Data="{StaticResource IcoPin}" Size="15"/>
                                    </Button>
                                    <StackPanel x:Name="BatteryPanel" DockPanel.Dock="Right" Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <TextBlock x:Name="BatteryText" FontSize="12" Foreground="{DynamicResource Secondary}"
                                                   VerticalAlignment="Center" Margin="0,0,6,0"
                                                   Typography.NumeralAlignment="Tabular"/>
                                        <Grid Width="25" Height="12" VerticalAlignment="Center">
                                            <Border Width="22" HorizontalAlignment="Left" CornerRadius="3.5"
                                                    BorderBrush="{DynamicResource Ink_73}" BorderThickness="1"/>
                                            <Border x:Name="BatteryFill" Width="18" HorizontalAlignment="Left"
                                                    Margin="2,2,0,2" CornerRadius="1.6" Background="{DynamicResource Ink_FF}"/>
                                            <Border Width="2" Height="4" HorizontalAlignment="Right" Margin="0,0,0.5,0"
                                                    CornerRadius="0,1,1,0" Background="{DynamicResource Ink_73}"/>
                                            <local:Glyph x:Name="ChargingIcon" Data="{StaticResource IcoBolt}" Filled="True"
                                                         Size="9" HorizontalAlignment="Left" Margin="6.5,0,0,0"
                                                         Foreground="{DynamicResource InkInverse}"/>
                                        </Grid>
                                    </StackPanel>
                                    <Button x:Name="UpdateButton" DockPanel.Dock="Right" Style="{StaticResource ChipButton}"
                                            Margin="0,0,12,0" Padding="10,3" Foreground="{DynamicResource Accent}"
                                            Visibility="Collapsed" VerticalAlignment="Center"
                                            Click="UpdateButton_Click" Content="{local:T 'Atualizar'}"/>
                                </DockPanel>
                                <Border x:Name="TopTabsHost" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        CornerRadius="12" Padding="3" Background="{DynamicResource Ink_0D}"
                                        Visibility="Collapsed"/>
                                </Grid>

                                <Grid x:Name="Pages" Grid.Row="1" Margin="0,12,0,0" ClipToBounds="True">

                                    <!-- ── Início: mídia + sistema + prateleira ── -->
                                    <Grid x:Name="PageHome">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition x:Name="HomeMediaCol" Width="*"/>
                                            <ColumnDefinition x:Name="HomeGap1" Width="12"/>
                                            <ColumnDefinition x:Name="HomeStatsCol" Width="118"/>
                                            <ColumnDefinition x:Name="HomeGap2" Width="12"/>
                                            <ColumnDefinition x:Name="HomeShelfCol" Width="150"/>
                                        </Grid.ColumnDefinitions>

                                        <Grid x:Name="MediaArea">
                                            <Grid x:Name="MediaDetails">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Capa grande, com um brilho da própria cor por baixo -->
                                                <Grid VerticalAlignment="Center" Margin="2,0,20,0">
                                                    <Border x:Name="ArtGlow" Width="{Binding Width, ElementName=ArtBox}"
                                                            Height="{Binding Height, ElementName=ArtBox}" CornerRadius="18" Opacity="0.5"
                                                            Background="{DynamicResource MediaAccent}" IsHitTestVisible="False"
                                                            RenderTransformOrigin="0.5,0.5">
                                                        <Border.RenderTransform>
                                                            <TransformGroup>
                                                                <ScaleTransform ScaleX="0.86" ScaleY="0.86"/>
                                                                <TranslateTransform Y="9"/>
                                                            </TransformGroup>
                                                        </Border.RenderTransform>
                                                        <Border.Effect>
                                                            <BlurEffect Radius="20" RenderingBias="Performance"/>
                                                        </Border.Effect>
                                                    </Border>
                                                    <Border x:Name="ArtBox" Width="100" Height="100" CornerRadius="16"
                                                            RenderTransformOrigin="0.5,0.5">
                                                        <Border.RenderTransform><ScaleTransform x:Name="ArtScale"/></Border.RenderTransform>
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                <GradientStop Color="#33FFFFFF" Offset="0"/>
                                                                <GradientStop Color="#0DFFFFFF" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                        <Grid>
                                                            <local:Glyph x:Name="ArtFallback" Data="{StaticResource IcoMusic}" Size="26"
                                                                         Foreground="{DynamicResource Ink_66}"/>
                                                            <Border CornerRadius="{Binding CornerRadius, ElementName=ArtBox}">
                                                                <Border.Background>
                                                                    <ImageBrush x:Name="ArtBrush" Stretch="UniformToFill"/>
                                                                </Border.Background>
                                                            </Border>
                                                            <!-- Fio de luz na borda da capa -->
                                                            <Border CornerRadius="{Binding CornerRadius, ElementName=ArtBox}" BorderThickness="1"
                                                                    IsHitTestVisible="False">
                                                                <Border.BorderBrush>
                                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                        <GradientStop Color="#59FFFFFF" Offset="0"/>
                                                                        <GradientStop Color="#0DFFFFFF" Offset="0.5"/>
                                                                        <GradientStop Color="#1AFFFFFF" Offset="1"/>
                                                                    </LinearGradientBrush>
                                                                </Border.BorderBrush>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </Grid>

                                                <Grid Grid.Column="1" VerticalAlignment="Center">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <DockPanel>
                                                        <Button x:Name="LikeButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                                                                Width="30" Height="28" VerticalAlignment="Top" Margin="6,-2,0,0"
                                                                Foreground="{DynamicResource Ink_A6}" Visibility="Collapsed" Click="Like_Click"
                                                                ToolTip="{local:T 'Curtir no Spotify (salva em Músicas Curtidas)'}">
                                                            <local:Glyph x:Name="LikeGlyph" Data="{StaticResource IcoHeart}" Size="16"/>
                                                        </Button>
                                                        <StackPanel VerticalAlignment="Top">
                                                            <TextBlock x:Name="TitleText" FontSize="15" FontWeight="Medium"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock x:Name="ArtistText" FontSize="12.5"
                                                                       Foreground="{DynamicResource Secondary}"
                                                                       TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                                            <TextBlock x:Name="SourceText" FontSize="10" FontWeight="Medium"
                                                                       Foreground="{DynamicResource Tertiary}"
                                                                       TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/>
                                                        </StackPanel>
                                                    </DockPanel>

                                                    <Grid x:Name="ProgressRow" Grid.Row="1" Margin="0,12,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" MinWidth="30"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto" MinWidth="30"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock x:Name="PositionText" FontSize="10.5" VerticalAlignment="Center" Margin="0,0,8,0"
                                                                   Foreground="{DynamicResource Tertiary}"
                                                                   Typography.NumeralAlignment="Tabular"/>
                                                        <Grid x:Name="ProgressHit" Grid.Column="1" Height="14" Background="Transparent"
                                                              Cursor="Hand" MouseLeftButtonDown="Progress_MouseDown"
                                                              MouseEnter="Progress_MouseEnter" MouseLeave="Progress_MouseLeave">
                                                            <Border x:Name="ProgressTrack" Height="3" CornerRadius="1.5"
                                                                    Background="{DynamicResource Ink_1F}" VerticalAlignment="Center"/>
                                                            <Border x:Name="ProgressFill" Height="3" CornerRadius="1.5"
                                                                    Background="{DynamicResource Ink_E6}" VerticalAlignment="Center"
                                                                    HorizontalAlignment="Left" Width="0"/>
                                                        </Grid>
                                                        <TextBlock x:Name="DurationText" Grid.Column="2" FontSize="10.5" Margin="8,0,0,0"
                                                                   VerticalAlignment="Center" HorizontalAlignment="Right"
                                                                   Foreground="{DynamicResource Tertiary}"
                                                                   Typography.NumeralAlignment="Tabular"/>
                                                    </Grid>

                                                    <StackPanel x:Name="MediaButtons" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <Button x:Name="ShuffleButton" Style="{StaticResource IconButton}" Width="30" Height="30"
                                                                Margin="0,0,6,0" Foreground="{DynamicResource Ink_73}"
                                                                Click="Shuffle_Click" ToolTip="{local:T 'Aleatório'}">
                                                            <Grid>
                                                                <local:Glyph Data="{StaticResource IcoShuffle}" Size="15" Thickness="1.9"/>
                                                                <Border x:Name="ShuffleDot" Width="3.5" Height="3.5" CornerRadius="1.75"
                                                                        Background="{DynamicResource Accent}" VerticalAlignment="Bottom"
                                                                        HorizontalAlignment="Center" Margin="0,0,0,-6" Visibility="Hidden"/>
                                                            </Grid>
                                                        </Button>
                                                        <Button x:Name="PrevButton" Style="{StaticResource IconButton}" Width="40" Height="36"
                                                                Foreground="{DynamicResource Ink_D9}"
                                                                Click="Previous_Click" ToolTip="{local:T 'Anterior'}">
                                                            <local:Glyph Data="{StaticResource IcoPrev}" Filled="True" Size="18"/>
                                                        </Button>
                                                        <Button x:Name="PlayPauseButton" Style="{StaticResource IconButton}"
                                                                Width="46" Height="40" Margin="8,0" Click="PlayPause_Click"
                                                                ToolTip="{local:T 'Tocar/Pausar'}">
                                                            <local:Glyph x:Name="PlayPauseGlyph" Data="{StaticResource IcoPlay}"
                                                                         Filled="True" Size="25"/>
                                                        </Button>
                                                        <Button x:Name="NextButton" Style="{StaticResource IconButton}" Width="40" Height="36"
                                                                Foreground="{DynamicResource Ink_D9}"
                                                                Click="Next_Click" ToolTip="{local:T 'Próxima'}">
                                                            <local:Glyph Data="{StaticResource IcoNext}" Filled="True" Size="18"/>
                                                        </Button>
                                                        <Button x:Name="RepeatButton" Style="{StaticResource IconButton}" Width="30" Height="30"
                                                                Margin="6,0,0,0" Foreground="{DynamicResource Ink_73}"
                                                                Click="Repeat_Click" ToolTip="{local:T 'Repetir'}">
                                                            <Grid>
                                                                <local:Glyph x:Name="RepeatGlyph" Data="{StaticResource IcoRepeat}" Size="15" Thickness="1.9"/>
                                                                <Border x:Name="RepeatDot" Width="3.5" Height="3.5" CornerRadius="1.75"
                                                                        Background="{DynamicResource Accent}" VerticalAlignment="Bottom"
                                                                        HorizontalAlignment="Center" Margin="0,0,0,-6" Visibility="Hidden"/>
                                                            </Grid>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Grid>

                                            <StackPanel x:Name="NoMediaPanel" VerticalAlignment="Center"
                                                        HorizontalAlignment="Center">
                                                <local:Glyph Data="{StaticResource IcoMusic}" Size="28" Foreground="{DynamicResource Ink_4D}"/>
                                                <TextBlock Text="{local:T 'Nada tocando'}" FontSize="13" Foreground="{DynamicResource Secondary}"
                                                           Margin="0,10,0,0" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{local:T 'Toque algo no Spotify, YouTube…'}" FontSize="11.5"
                                                           Foreground="{DynamicResource Tertiary}" Margin="0,2,0,0"
                                                           HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Sistema: processador e memória -->
                                        <Grid x:Name="StatsCard" Grid.Column="2">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="12"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <Border Style="{StaticResource Card}" Padding="13,11,13,0" ClipToBounds="True">
                                                <DockPanel>
                                                    <DockPanel DockPanel.Dock="Top">
                                                        <TextBlock Text="{local:T 'CPU'}" Style="{StaticResource Label}"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock x:Name="CpuValue" FontSize="13" FontWeight="SemiBold"
                                                                   HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular"/>
                                                    </DockPanel>
                                                    <Grid x:Name="CpuGraph" Margin="-13,6,-13,0">
                                                        <Path x:Name="CpuArea" Opacity="0.35" Fill="{DynamicResource Accent}"
                                                              OpacityMask="{StaticResource GraphFade}"/>
                                                        <Path x:Name="CpuLine" StrokeThickness="1.5" Stroke="{DynamicResource Accent}"
                                                              StrokeLineJoin="Round"/>
                                                    </Grid>
                                                </DockPanel>
                                            </Border>
                                            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="13,11,13,0" ClipToBounds="True">
                                                <DockPanel>
                                                    <DockPanel DockPanel.Dock="Top">
                                                        <TextBlock Text="{local:T 'RAM'}" Style="{StaticResource Label}"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock x:Name="MemValue" FontSize="13" FontWeight="SemiBold"
                                                                   HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular"/>
                                                    </DockPanel>
                                                    <Grid x:Name="MemGraph" Margin="-13,6,-13,0">
                                                        <Path x:Name="MemArea" Opacity="0.35" Fill="#FFC861"
                                                              OpacityMask="{StaticResource GraphFade}"/>
                                                        <Path x:Name="MemLine" StrokeThickness="1.5" Stroke="#FFC861"
                                                              StrokeLineJoin="Round"/>
                                                    </Grid>
                                                </DockPanel>
                                            </Border>
                                        </Grid>


                                    </Grid>

                                    <!-- ── Prateleira (aba própria) ── -->
                                    <Grid x:Name="PageShelf" Visibility="Collapsed">
                                        <!-- Prateleira -->
                                        <Border x:Name="ShelfZone" Style="{StaticResource Card}">
                                            <Grid>
                                                <TextBlock Text="{local:T 'PRATELEIRA'}" Style="{StaticResource Label}" FontSize="10"
                                                           Margin="14,12,0,0" IsHitTestVisible="False"/>
                                                <StackPanel x:Name="ShelfHint" VerticalAlignment="Center"
                                                            HorizontalAlignment="Center" IsHitTestVisible="False" Margin="0,10,0,0">
                                                    <local:Glyph Data="{StaticResource IcoTray}" Size="22" Thickness="1.6"
                                                                 Foreground="{DynamicResource Ink_73}" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{local:T 'Solte arquivos aqui'}" FontSize="12"
                                                               Foreground="{DynamicResource Tertiary}"
                                                               Margin="0,10,0,0" HorizontalAlignment="Center"/>
                                                </StackPanel>

                                                <ScrollViewer VerticalScrollBarVisibility="Hidden"
                                                              HorizontalScrollBarVisibility="Disabled" Margin="5,24,5,24">
                                                    <ItemsControl x:Name="ShelfItems">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border x:Name="Root" Width="46" Height="56" Margin="1"
                                                                        CornerRadius="9" Background="Transparent" Cursor="Hand"
                                                                        ToolTip="{Binding Path}"
                                                                        PreviewMouseLeftButtonDown="ShelfItem_MouseDown"
                                                                        MouseMove="ShelfItem_MouseMove">
                                                                    <Grid>
                                                                        <Image Source="{Binding Icon}" Width="28" Height="28"
                                                                               VerticalAlignment="Top" Margin="0,5,0,0"/>
                                                                        <TextBlock Text="{Binding Name}" FontSize="10.5"
                                                                                   Foreground="{DynamicResource Secondary}"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   TextAlignment="Center"
                                                                                   VerticalAlignment="Bottom" Margin="2,0,2,4"/>
                                                                        <Button x:Name="RemoveButton"
                                                                                Style="{StaticResource IconButton}"
                                                                                Width="16" Height="16" Background="#80000000"
                                                                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                                                                Margin="0,1,1,0"
                                                                                Visibility="Hidden" Click="ShelfRemove_Click"
                                                                                ToolTip="{local:T 'Remover da prateleira'}">
                                                                            <local:Glyph Data="{StaticResource IcoClose}" Size="10"
                                                                                         Thickness="3"/>
                                                                        </Button>
                                                                    </Grid>
                                                                </Border>
                                                                <DataTemplate.Triggers>
                                                                    <Trigger SourceName="Root" Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="RemoveButton" Property="Visibility"
                                                                                Value="Visible"/>
                                                                        <Setter TargetName="Root" Property="Background"
                                                                                Value="{DynamicResource Ink_17}"/>
                                                                    </Trigger>
                                                                </DataTemplate.Triggers>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>

                                                <Button x:Name="ClearShelfButton" Style="{StaticResource IconButton}"
                                                        Width="24" Height="22" Margin="0,0,5,4"
                                                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                        Click="ClearShelf_Click" ToolTip="{local:T 'Limpar prateleira'}">
                                                    <local:Glyph Data="{StaticResource IcoTrash}" Size="13" Foreground="{DynamicResource Ink_A6}"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </Grid>

                                    <!-- ── Agenda: dias que deslizam de lado + lembretes do dia ── -->
                                    <Grid x:Name="PageAgenda" Visibility="Collapsed">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <Grid Height="58">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Margin="2,0,12,0" MinWidth="50">
                                                <TextBlock x:Name="CalMonth" FontSize="24" FontWeight="SemiBold"/>
                                                <Grid Margin="1,2,0,0">
                                                    <TextBlock x:Name="CalYear" Style="{StaticResource Label}"/>
                                                    <Button x:Name="TodayButton" Style="{StaticResource ChipButton}" Margin="-1,0,0,0"
                                                            Padding="7,1" FontSize="10.5" HorizontalAlignment="Left"
                                                            Visibility="Collapsed" Click="AgendaToday_Click"
                                                            Content="{local:T 'Hoje'}"/>
                                                </Grid>
                                            </StackPanel>
                                            <!-- Os dias passam de lado: rolar o mouse ou clicar num dia -->
                                            <Canvas x:Name="DayStrip" Grid.Column="1" ClipToBounds="True" Background="Transparent"
                                                    MouseWheel="DayStrip_MouseWheel">
                                                <Canvas.OpacityMask>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#00000000" Offset="0"/>
                                                        <GradientStop Color="#FF000000" Offset="0.18"/>
                                                        <GradientStop Color="#FF000000" Offset="0.82"/>
                                                        <GradientStop Color="#00000000" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Canvas.OpacityMask>
                                                <StackPanel x:Name="DayStripItems" Orientation="Horizontal" Height="58">
                                                    <StackPanel.RenderTransform><TranslateTransform x:Name="DayStripShift"/></StackPanel.RenderTransform>
                                                </StackPanel>
                                            </Canvas>
                                        </Grid>

                                        <Border x:Name="TodoPanel" Grid.Row="1" Margin="0,10,0,0" Style="{StaticResource Card}"
                                                Padding="14,10,12,10"
                                                MouseEnter="NotesArea_MouseEnter" MouseLeave="NotesArea_MouseLeave">
                                            <DockPanel>
                                                <DockPanel x:Name="TodoHeader" DockPanel.Dock="Top" Margin="0,0,0,4">
                                                    <TextBlock x:Name="TodoCount" DockPanel.Dock="Right" Style="{StaticResource Label}"
                                                               VerticalAlignment="Bottom" Typography.NumeralAlignment="Tabular"/>
                                                    <TextBlock x:Name="AgendaWeekday" Style="{StaticResource Label}"
                                                               Foreground="{DynamicResource Accent}" TextTrimming="CharacterEllipsis"/>
                                                </DockPanel>

                                                <Border DockPanel.Dock="Bottom" CornerRadius="9" Background="{DynamicResource Ink_12}"
                                                        Padding="10,0,3,0" Height="28" Margin="0,6,0,0">
                                                    <DockPanel>
                                                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                                                                Width="24" Height="24" Click="TodoAdd_Click" ToolTip="{local:T 'Adicionar lembrete'}">
                                                            <local:Glyph Data="{StaticResource IcoPlus}" Size="14"
                                                                         Foreground="{DynamicResource Accent}"/>
                                                        </Button>
                                                        <Grid VerticalAlignment="Center">
                                                            <TextBlock x:Name="TodoPlaceholder" Text="{local:T 'Novo lembrete…'}" FontSize="12.5"
                                                                       Foreground="{DynamicResource Tertiary}" IsHitTestVisible="False"
                                                                       Margin="2,0,0,0"/>
                                                            <TextBox x:Name="TodoInput" Style="{StaticResource LineBox}"
                                                                     PreviewMouseLeftButtonDown="TextInput_PreviewMouseDown"
                                                                     TextChanged="TodoInput_TextChanged"
                                                                     PreviewKeyDown="TodoInput_PreviewKeyDown"/>
                                                        </Grid>
                                                    </DockPanel>
                                                </Border>

                                                <Grid>
                                                    <TextBlock x:Name="TodoEmpty" Text="{local:T 'Nada marcado para este dia.'}"
                                                               FontSize="12" Foreground="{DynamicResource Tertiary}"
                                                               TextWrapping="Wrap" VerticalAlignment="Center"
                                                               HorizontalAlignment="Left" Margin="2,0"/>
                                                    <ScrollViewer VerticalScrollBarVisibility="Hidden">
                                                        <ItemsControl x:Name="TodoItems">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border x:Name="Row" CornerRadius="7" Padding="4,3,2,3"
                                                                            Background="Transparent">
                                                                        <DockPanel>
                                                                            <Button x:Name="Remove" DockPanel.Dock="Right"
                                                                                    Style="{StaticResource IconButton}"
                                                                                    Width="20" Height="20" Visibility="Hidden"
                                                                                    Click="TodoRemove_Click" ToolTip="{local:T 'Apagar'}">
                                                                                <local:Glyph Data="{StaticResource IcoClose}" Size="10"
                                                                                             Thickness="2.6" Foreground="{DynamicResource Ink_A6}"/>
                                                                            </Button>
                                                                            <Border x:Name="Dot" Width="6" Height="6" CornerRadius="3"
                                                                                    Background="{DynamicResource Accent}" Margin="2,0,10,0"
                                                                                    VerticalAlignment="Center"/>
                                                                            <TextBlock x:Name="Text" Text="{Binding Text}" FontSize="12.5"
                                                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                                        </DockPanel>
                                                                    </Border>
                                                                    <DataTemplate.Triggers>
                                                                        <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource Ink_0F}"/>
                                                                            <Setter TargetName="Remove" Property="Visibility" Value="Visible"/>
                                                                        </Trigger>
                                                                        <DataTrigger Binding="{Binding Done}" Value="True">
                                                                            <Setter TargetName="Text" Property="TextDecorations" Value="Strikethrough"/>
                                                                            <Setter TargetName="Text" Property="Foreground" Value="{DynamicResource Ink_73}"/>
                                                                            <Setter TargetName="Dot" Property="Background" Value="{DynamicResource Ink_4D}"/>
                                                                        </DataTrigger>
                                                                    </DataTemplate.Triggers>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </ScrollViewer>
                                                </Grid>
                                            </DockPanel>
                                        </Border>
                                    </Grid>

                                    <!-- ── Tarefas do dia: lista com check ── -->
                                    <Border x:Name="PageTasks" Visibility="Collapsed" Style="{StaticResource Card}" Padding="14,11,12,10"
                                            MouseEnter="NotesArea_MouseEnter" MouseLeave="NotesArea_MouseLeave">
                                        <DockPanel>
                                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,7">
                                                <TextBlock x:Name="TasksCount" DockPanel.Dock="Right" Style="{StaticResource Label}"
                                                           Typography.NumeralAlignment="Tabular"/>
                                                <TextBlock x:Name="TasksTitle" Text="{local:T 'TAREFAS DE HOJE'}" Style="{StaticResource Label}"/>
                                            </DockPanel>
                                            <Grid DockPanel.Dock="Top" Height="3" Margin="0,0,0,7">
                                                <Border CornerRadius="1.5" Background="{DynamicResource Ink_17}"/>
                                                <Border x:Name="TasksProgress" CornerRadius="1.5" Background="{DynamicResource Accent}"
                                                        HorizontalAlignment="Left" Width="0"/>
                                            </Grid>

                                            <Border DockPanel.Dock="Bottom" CornerRadius="9" Background="{DynamicResource Ink_12}"
                                                    Padding="10,0,3,0" Height="28" Margin="0,6,0,0">
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                                                            Width="24" Height="24" Click="TaskAdd_Click" ToolTip="{local:T 'Adicionar tarefa'}">
                                                        <local:Glyph Data="{StaticResource IcoPlus}" Size="14"
                                                                     Foreground="{DynamicResource Accent}"/>
                                                    </Button>
                                                    <Grid VerticalAlignment="Center">
                                                        <TextBlock x:Name="TaskPlaceholder" Text="{local:T 'Nova tarefa…'}" FontSize="12.5"
                                                                   Foreground="{DynamicResource Tertiary}" IsHitTestVisible="False"
                                                                   Margin="2,0,0,0"/>
                                                        <TextBox x:Name="TaskInput" Style="{StaticResource LineBox}"
                                                                 PreviewMouseLeftButtonDown="TextInput_PreviewMouseDown"
                                                                 TextChanged="TaskInput_TextChanged"
                                                                 PreviewKeyDown="TaskInput_PreviewKeyDown"/>
                                                    </Grid>
                                                </DockPanel>
                                            </Border>

                                            <Grid>
                                                <TextBlock x:Name="TasksEmpty" Text="{local:T 'O que precisa sair hoje? Escreva abaixo.'}"
                                                           FontSize="12" Foreground="{DynamicResource Tertiary}"
                                                           TextWrapping="Wrap" VerticalAlignment="Center"
                                                           HorizontalAlignment="Left" Margin="2,0"/>
                                                <ScrollViewer VerticalScrollBarVisibility="Hidden">
                                                    <ItemsControl x:Name="TaskItems">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border x:Name="Row" CornerRadius="7" Padding="4,3,2,3"
                                                                        Background="Transparent">
                                                                    <DockPanel>
                                                                        <Button x:Name="Remove" DockPanel.Dock="Right"
                                                                                Style="{StaticResource IconButton}"
                                                                                Width="20" Height="20" Visibility="Hidden"
                                                                                Click="TaskRemove_Click" ToolTip="{local:T 'Apagar'}">
                                                                            <local:Glyph Data="{StaticResource IcoClose}" Size="10"
                                                                                         Thickness="2.6" Foreground="{DynamicResource Ink_A6}"/>
                                                                        </Button>
                                                                        <CheckBox Style="{StaticResource TodoCheck}"
                                                                                  IsChecked="{Binding Done, Mode=TwoWay}"
                                                                                  Click="TaskCheck_Click">
                                                                            <TextBlock x:Name="Text" Text="{Binding Text}" FontSize="12.5"
                                                                                       TextTrimming="CharacterEllipsis"/>
                                                                        </CheckBox>
                                                                    </DockPanel>
                                                                </Border>
                                                                <DataTemplate.Triggers>
                                                                    <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource Ink_0F}"/>
                                                                        <Setter TargetName="Remove" Property="Visibility" Value="Visible"/>
                                                                    </Trigger>
                                                                    <DataTrigger Binding="{Binding Done}" Value="True">
                                                                        <Setter TargetName="Text" Property="TextDecorations" Value="Strikethrough"/>
                                                                        <Setter TargetName="Text" Property="Foreground" Value="{DynamicResource Ink_73}"/>
                                                                    </DataTrigger>
                                                                </DataTemplate.Triggers>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </Grid>
                                        </DockPanel>
                                    </Border>

                                    <!-- ── Notas: páginas (como no Notion), cada uma com a sua cor ── -->
                                    <Grid x:Name="PageNotes" Visibility="Collapsed"
                                          MouseEnter="NotesArea_MouseEnter" MouseLeave="NotesArea_MouseLeave">
                                        <!-- Lista de páginas -->
                                        <DockPanel x:Name="NotesListView">
                                            <DockPanel DockPanel.Dock="Top" Margin="2,0,0,8">
                                                <Button DockPanel.Dock="Right" Click="NewNotePage_Click" Cursor="Hand" Focusable="False"
                                                        ToolTip="{local:T 'Nova página'}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Grid x:Name="Root" Width="26" Height="26" RenderTransformOrigin="0.5,0.5">
                                                                <Ellipse x:Name="Bg" Fill="{DynamicResource Ink_1F}"/>
                                                                <local:Glyph Data="{StaticResource IcoPlus}" Size="13" Thickness="2.6"/>
                                                            </Grid>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Bg" Property="Fill" Value="{DynamicResource Ink_33}"/>
                                                                </Trigger>
                                                                <Trigger Property="IsPressed" Value="True">
                                                                    <Setter TargetName="Root" Property="RenderTransform">
                                                                        <Setter.Value><ScaleTransform ScaleX="0.9" ScaleY="0.9"/></Setter.Value>
                                                                    </Setter>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                                <TextBlock Text="{local:T 'PÁGINAS'}" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                                            </DockPanel>
                                            <Grid>
                                                <StackPanel x:Name="NotesEmpty" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <local:Glyph Data="{StaticResource IcoNotes}" Size="22" Thickness="1.6"
                                                                 Foreground="{DynamicResource Ink_4D}" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{local:T 'Nenhuma página ainda. Toque no + para criar.'}" FontSize="12"
                                                               Foreground="{DynamicResource Tertiary}" Margin="0,8,0,0"
                                                               TextAlignment="Center" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <ScrollViewer x:Name="NotePagesScroll" VerticalScrollBarVisibility="Hidden">
                                                    <WrapPanel x:Name="NotePagesPanel"/>
                                                </ScrollViewer>
                                            </Grid>
                                        </DockPanel>

                                        <!-- Página aberta -->
                                        <Border x:Name="NoteEditor" Visibility="Collapsed" Style="{StaticResource Card}" Padding="8,6,8,6">
                                            <DockPanel>
                                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,2">
                                                    <Button Style="{StaticResource IconButton}" Width="26" Height="26" Click="NoteBack_Click"
                                                            ToolTip="{local:T 'Voltar às páginas'}" Foreground="{DynamicResource Ink_A6}">
                                                        <local:Glyph Data="{StaticResource IcoChevronLeft}" Size="15" Thickness="2.2"/>
                                                    </Button>
                                                    <Button x:Name="NoteDeleteButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                                                            Width="26" Height="26" Click="NoteDelete_Click"
                                                            ToolTip="{local:T 'Apagar página'}" Foreground="{DynamicResource Ink_73}">
                                                        <local:Glyph Data="{StaticResource IcoTrash}" Size="13"/>
                                                    </Button>
                                                    <Border x:Name="NoteColorMark" Width="10" Height="10" CornerRadius="3" Margin="4,0,8,0"
                                                            VerticalAlignment="Center"/>
                                                    <Grid VerticalAlignment="Center">
                                                        <TextBlock x:Name="NoteTitlePlaceholder" Text="{local:T 'Sem título'}" FontSize="14"
                                                                   FontWeight="SemiBold" Foreground="{DynamicResource Tertiary}"
                                                                   IsHitTestVisible="False" Margin="2,0,0,0"/>
                                                        <TextBox x:Name="NoteTitle" Style="{StaticResource LineBox}" FontSize="14" FontWeight="SemiBold"
                                                                 PreviewMouseLeftButtonDown="TextInput_PreviewMouseDown"
                                                                 TextChanged="NoteTitle_TextChanged"
                                                                 PreviewKeyDown="NoteTitle_PreviewKeyDown"/>
                                                    </Grid>
                                                </DockPanel>

                                                <!-- Cores e formatação -->
                                                <DockPanel DockPanel.Dock="Bottom" Margin="2,4,0,0">
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                        <Button x:Name="BoldButton" Style="{StaticResource IconButton}" Width="26" Height="24"
                                                                Margin="2,0,0,0" Click="NoteFormat_Click" Tag="b" ToolTip="{local:T 'Negrito (Ctrl+B)'}">
                                                            <TextBlock Text="B" FontSize="13" FontWeight="Bold"/>
                                                        </Button>
                                                        <Button x:Name="ItalicButton" Style="{StaticResource IconButton}" Width="26" Height="24"
                                                                Margin="2,0,0,0" Click="NoteFormat_Click" Tag="i" ToolTip="{local:T 'Itálico (Ctrl+I)'}">
                                                            <TextBlock Text="I" FontSize="13" FontStyle="Italic" FontFamily="Georgia"/>
                                                        </Button>
                                                        <Button x:Name="UnderlineButton" Style="{StaticResource IconButton}" Width="26" Height="24"
                                                                Margin="2,0,0,0" Click="NoteFormat_Click" Tag="u" ToolTip="{local:T 'Sublinhado (Ctrl+U)'}">
                                                            <TextBlock Text="U" FontSize="13" TextDecorations="Underline"/>
                                                        </Button>
                                                    </StackPanel>
                                                    <StackPanel x:Name="NoteColors" Orientation="Horizontal" VerticalAlignment="Center"/>
                                                </DockPanel>

                                                <Grid Margin="4,2,2,0">
                                                    <TextBlock x:Name="NoteBodyPlaceholder" Text="{local:T 'Escreva aqui…'}" FontSize="13.5"
                                                               Foreground="{DynamicResource Tertiary}" IsHitTestVisible="False"
                                                               Margin="2,0,0,0"/>
                                                    <RichTextBox x:Name="NoteBody" Style="{StaticResource NoteBodyBox}"
                                                                 PreviewMouseLeftButtonDown="TextInput_PreviewMouseDown"
                                                                 TextChanged="NoteBody_TextChanged"
                                                                 SelectionChanged="NoteBody_SelectionChanged"
                                                                 PreviewKeyDown="NotesBox_PreviewKeyDown"/>
                                                </Grid>
                                            </DockPanel>
                                        </Border>
                                    </Grid>

                                    <!-- ── Foco (timer) ── -->
                                    <Grid x:Name="PageTimer" Visibility="Collapsed">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Contorno quadrado de cantos suaves que se esvazia com o tempo (encolhe se faltar altura) -->
                                        <Viewbox x:Name="TimerRingBox" StretchDirection="DownOnly" Stretch="Uniform" Margin="0,0,28,0"
                                                 HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Grid Width="156" Height="156">
                                            <Path x:Name="TimerTrack" Stroke="{DynamicResource Ink_17}" StrokeThickness="4"/>
                                            <Path x:Name="TimerRing" Stroke="{DynamicResource Accent}" StrokeThickness="4"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeDashCap="Round"/>
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock x:Name="TimerMode" Text="{local:T 'FOCO'}" Style="{StaticResource Label}"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock x:Name="TimerDisplay" Text="5:00" FontSize="38" FontWeight="Light"
                                                           HorizontalAlignment="Center" Typography.NumeralAlignment="Tabular"
                                                           Margin="0,1,0,1"/>
                                                <TextBlock x:Name="TimerStatus" Text="{local:T 'Pronto'}" FontSize="11.5"
                                                           Foreground="{DynamicResource Secondary}" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>
                                        </Viewbox>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel x:Name="TimerButtonsRow" Orientation="Horizontal" Margin="0,0,0,12">
                                                <Button x:Name="TimerStartButton" Style="{StaticResource ChipButton}"
                                                        Padding="16,8" Margin="0,0,8,0" Click="TimerStartPause_Click"
                                                        Background="{DynamicResource Ink_F2}" Foreground="{DynamicResource InkInverse}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <local:Glyph x:Name="TimerStartGlyph" Data="{StaticResource IcoPlay}"
                                                                     Filled="True" Size="12" Margin="0,0,7,0"/>
                                                        <TextBlock x:Name="TimerStartText" Text="{local:T 'Iniciar'}" FontSize="13" FontWeight="Medium"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button x:Name="TimerResetButton" Style="{StaticResource ChipButton}" Padding="14,8" Margin="0"
                                                        Click="TimerReset_Click" ToolTip="{local:T 'Zerar'}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <local:Glyph x:Name="TimerResetGlyph" Data="{StaticResource IcoReset}" Size="13" Margin="0,0,6,0"/>
                                                        <TextBlock x:Name="TimerResetText" Text="{local:T 'Zerar'}" FontSize="13"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>

                                            <!-- Modos (pomodoro): compactos para caber mesmo com a ilha pequena -->
                                            <StackPanel x:Name="TimerModes" Orientation="Horizontal" Margin="0,0,0,12">
                                                <Button Style="{StaticResource ChipButton}" Tag="25|FOCO" Click="TimerMode_Click" Padding="10,5">
                                                    <TextBlock><Run Text="{local:T 'Foco'}" FontWeight="SemiBold"/><Run Text=" 25" Foreground="{DynamicResource Tertiary}"/></TextBlock>
                                                </Button>
                                                <Button Style="{StaticResource ChipButton}" Tag="5|PAUSA" Click="TimerMode_Click" Padding="10,5">
                                                    <TextBlock><Run Text="{local:T 'Pausa'}" FontWeight="SemiBold"/><Run Text=" 5" Foreground="{DynamicResource Tertiary}"/></TextBlock>
                                                </Button>
                                                <Button Style="{StaticResource ChipButton}" Tag="15|PAUSA LONGA" Click="TimerMode_Click" Padding="10,5">
                                                    <TextBlock><Run Text="{local:T 'Pausa longa'}" FontWeight="SemiBold"/><Run Text=" 15" Foreground="{DynamicResource Tertiary}"/></TextBlock>
                                                </Button>
                                            </StackPanel>

                                            <WrapPanel x:Name="TimerChips">
                                                <Button Style="{StaticResource ChipButton}" Content="1" Tag="1" Click="TimerPreset_Click" Padding="7,4" ToolTip="1 min"/>
                                                <Button Style="{StaticResource ChipButton}" Content="3" Tag="3" Click="TimerPreset_Click" Padding="7,4" ToolTip="3 min"/>
                                                <Button Style="{StaticResource ChipButton}" Content="5" Tag="5" Click="TimerPreset_Click" Padding="7,4" ToolTip="5 min"/>
                                                <Button Style="{StaticResource ChipButton}" Content="10" Tag="10" Click="TimerPreset_Click" Padding="7,4" ToolTip="10 min"/>
                                                <Button Style="{StaticResource ChipButton}" Content="15" Tag="15" Click="TimerPreset_Click" Padding="7,4" ToolTip="15 min"/>
                                                <Button Style="{StaticResource ChipButton}" Content="20" Tag="20" Click="TimerPreset_Click" Padding="7,4" ToolTip="20 min"/>
                                                <Button Style="{StaticResource ChipButton}" Content="25" Tag="25" Click="TimerPreset_Click" Padding="7,4" ToolTip="25 min"/>
                                                <Button Style="{StaticResource ChipButton}" Content="30" Tag="30" Click="TimerPreset_Click" Padding="7,4" ToolTip="30 min"/>
                                                <Button Style="{StaticResource ChipButton}" Content="45" Tag="45" Click="TimerPreset_Click" Padding="7,4" ToolTip="45 min"/>
                                                <Button Style="{StaticResource ChipButton}" Content="1 h" Tag="60" Click="TimerPreset_Click" Padding="7,4"/>
                                                <Button Style="{StaticResource ChipButton}" Content="1 h 30" Tag="90" Click="TimerPreset_Click" Padding="7,4"/>
                                                <Button Style="{StaticResource ChipButton}" Content="+1" Tag="1" Click="TimerAdd_Click" Padding="7,4"
                                                        ToolTip="{local:T 'Mais 1 minuto'}"/>
                                                <Button Style="{StaticResource ChipButton}" Content="+5" Tag="5" Click="TimerAdd_Click" Padding="7,4"
                                                        ToolTip="{local:T 'Mais 5 minutos'}"/>
                                                <Button Style="{StaticResource ChipButton}" Content="−1" Tag="-1" Click="TimerAdd_Click" Padding="7,4"
                                                        ToolTip="{local:T 'Menos 1 minuto'}"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Grid>

                                    <!-- ── Área de transferência ── -->
                                    <Grid x:Name="PageClipboard" Visibility="Collapsed">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Grid Margin="0,0,0,8">
                                            <TextBlock x:Name="ClipboardStatus" Text="{local:T 'Clique em um item para copiar de novo'}"
                                                       FontSize="12" Foreground="{DynamicResource Tertiary}"
                                                       VerticalAlignment="Center"/>
                                            <Button Style="{StaticResource ChipButton}" Content="{local:T 'Limpar'}" Margin="0" Padding="11,3"
                                                    HorizontalAlignment="Right" Click="ClipboardClear_Click"/>
                                        </Grid>
                                        <StackPanel x:Name="ClipboardEmpty" Grid.Row="1" HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                            <local:Glyph Data="{StaticResource IcoClipboard}" Size="26" Foreground="{DynamicResource Ink_4D}"/>
                                            <TextBlock Text="{local:T 'Nada copiado ainda'}" FontSize="13" Foreground="{DynamicResource Secondary}"
                                                       Margin="0,8,0,0"/>
                                        </StackPanel>
                                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                                            <ItemsControl x:Name="ClipboardItems">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border x:Name="Row" CornerRadius="10" Background="{DynamicResource Ink_0D}"
                                                                Padding="13,8" Margin="0,0,0,5" Cursor="Hand"
                                                                ToolTip="{Binding Text}"
                                                                MouseLeftButtonUp="ClipItem_Click">
                                                            <DockPanel>
                                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Time}"
                                                                           FontSize="11" Foreground="{DynamicResource Tertiary}"
                                                                           Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding Preview}" FontSize="12.5"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </DockPanel>
                                                        </Border>
                                                        <DataTemplate.Triggers>
                                                            <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Ink_22}"/>
                                                            </Trigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>

                                    <!-- ── Teleprompter: o texto passa logo abaixo da câmera ── -->
                                    <Grid x:Name="PagePrompter" Visibility="Collapsed"
                                          MouseEnter="NotesArea_MouseEnter" MouseLeave="NotesArea_MouseLeave">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Topo: roteiro, editar, travar -->
                                        <DockPanel Margin="0,0,0,6">
                                            <Button x:Name="PrompterLock" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="28" Height="24"
                                                    Foreground="{DynamicResource Ink_A6}" Click="PrompterLock_Click"
                                                    ToolTip="{local:T 'Travar: a ilha fica aberta e o texto não rola sem querer'}">
                                                <local:Glyph x:Name="PrompterLockGlyph" Data="{StaticResource IcoLock}" Size="14"/>
                                            </Button>
                                            <Button x:Name="PrompterEdit" DockPanel.Dock="Right" Style="{StaticResource ChipButton}" Margin="0,0,6,0"
                                                    Padding="10,3" Click="PrompterEdit_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <local:Glyph Data="{StaticResource IcoEdit}" Size="12" Margin="0,0,6,0"/>
                                                    <TextBlock x:Name="PrompterEditText" Text="{local:T 'Editar'}"/>
                                                </StackPanel>
                                            </Button>
                                            <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Width="24" Height="24"
                                                    Tag="-1" Click="PrompterPage_Click" ToolTip="{local:T 'Roteiro anterior'}">
                                                <local:Glyph Data="{StaticResource IcoChevronLeft}" Size="13"/>
                                            </Button>
                                            <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Width="24" Height="24"
                                                    Tag="1" Click="PrompterPage_Click" ToolTip="{local:T 'Próximo roteiro'}">
                                                <local:Glyph Data="{StaticResource IcoChevronRight}" Size="13"/>
                                            </Button>
                                            <TextBlock x:Name="PrompterTitle" FontSize="12.5" FontWeight="SemiBold" Margin="6,0,8,0"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>

                                        <!-- Texto -->
                                        <Border Grid.Row="1" CornerRadius="12" Background="{DynamicResource Ink_0A}" ClipToBounds="True">
                                            <Grid>
                                                <Canvas x:Name="PrompterViewport" ClipToBounds="True">
                                                    <StackPanel x:Name="PrompterLines" Margin="16,0">
                                                        <StackPanel.RenderTransform><TranslateTransform x:Name="PrompterShift"/></StackPanel.RenderTransform>
                                                    </StackPanel>
                                                </Canvas>
                                                <TextBox x:Name="PrompterBox" Style="{StaticResource NotesBox}" Margin="14,10" Visibility="Collapsed"
                                                         PreviewMouseLeftButtonDown="TextInput_PreviewMouseDown"
                                                         TextChanged="PrompterBox_TextChanged" PreviewKeyDown="NotesBox_PreviewKeyDown"/>
                                                <!-- Antes de começar -->
                                                <StackPanel x:Name="PrompterIntro" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                            IsHitTestVisible="False">
                                                    <TextBlock Text="{local:T 'Aperte Iniciar e leia junto'}" FontSize="13" FontWeight="Medium"
                                                               HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{local:T 'Uma contagem de 3 segundos te dá tempo de se preparar'}" FontSize="11.5"
                                                               Foreground="{DynamicResource Tertiary}" HorizontalAlignment="Center" TextAlignment="Center"
                                                               TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <!-- Contagem 3, 2, 1 -->
                                                <TextBlock x:Name="PrompterCount" FontSize="52" FontWeight="SemiBold" Opacity="0"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                                                           RenderTransformOrigin="0.5,0.5">
                                                    <TextBlock.RenderTransform><ScaleTransform x:Name="PrompterCountScale"/></TextBlock.RenderTransform>
                                                </TextBlock>
                                            </Grid>
                                        </Border>

                                        <!-- Rodapé: início, iniciar/pausar, tempo, velocidade, página -->
                                        <DockPanel Grid.Row="2" Margin="0,6,0,0" LastChildFill="False">
                                            <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Width="26" Height="26"
                                                    Click="PrompterRestart_Click" ToolTip="{local:T 'Voltar ao início'}">
                                                <local:Glyph Data="{StaticResource IcoReset}" Size="13"/>
                                            </Button>
                                            <Button x:Name="PrompterStart" DockPanel.Dock="Left" Style="{StaticResource ChipButton}" Margin="6,0,0,0"
                                                    Padding="13,5" Background="{DynamicResource Ink_F2}" Foreground="{DynamicResource InkInverse}" Click="PrompterStart_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <local:Glyph x:Name="PrompterStartGlyph" Data="{StaticResource IcoPlay}" Filled="True" Size="10" Margin="0,0,6,0"/>
                                                    <TextBlock x:Name="PrompterStartText" Text="{local:T 'Iniciar'}" FontWeight="Medium"/>
                                                </StackPanel>
                                            </Button>
                                            <TextBlock x:Name="PrompterLeft" DockPanel.Dock="Left" FontSize="11.5" Foreground="{DynamicResource Tertiary}"
                                                       VerticalAlignment="Center" Margin="10,0,0,0" Typography.NumeralAlignment="Tabular"/>

                                            <TextBlock x:Name="PrompterPageText" DockPanel.Dock="Right" FontSize="11.5" Foreground="{DynamicResource Tertiary}"
                                                       VerticalAlignment="Center" Margin="8,0,0,0" Typography.NumeralAlignment="Tabular"/>
                                            <StackPanel x:Name="PrompterSpeedRow" DockPanel.Dock="Right" Orientation="Horizontal">
                                                <Button Style="{StaticResource IconButton}" Width="24" Height="24" Tag="-0.1" Click="PrompterSpeed_Click"
                                                        ToolTip="{local:T 'Mais devagar'}">
                                                    <local:Glyph Data="{StaticResource IcoMinus}" Size="12"/>
                                                </Button>
                                                <TextBlock x:Name="PrompterSpeedText" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                                                           MinWidth="34" TextAlignment="Center" Typography.NumeralAlignment="Tabular"/>
                                                <Button Style="{StaticResource IconButton}" Width="24" Height="24" Tag="0.1" Click="PrompterSpeed_Click"
                                                        ToolTip="{local:T 'Mais rápido'}">
                                                    <local:Glyph Data="{StaticResource IcoPlus}" Size="12"/>
                                                </Button>
                                            </StackPanel>
                                        </DockPanel>
                                    </Grid>

                                    <!-- ── Espelho (câmera) ── -->
                                    <Grid x:Name="PageMirror" Visibility="Collapsed">
                                        <Border x:Name="MirrorFrame" Width="180" Height="180" Style="{StaticResource Card}" CornerRadius="90"
                                                HorizontalAlignment="Center" ClipToBounds="True">
                                            <Grid>
                                                <Border x:Name="MirrorImage" CornerRadius="90" RenderTransformOrigin="0.5,0.5">
                                                    <Border.RenderTransform>
                                                        <ScaleTransform ScaleX="-1"/>
                                                    </Border.RenderTransform>
                                                    <Border.Background>
                                                        <ImageBrush x:Name="MirrorBrush" Stretch="UniformToFill"/>
                                                    </Border.Background>
                                                </Border>
                                                <StackPanel x:Name="MirrorPlaceholder" VerticalAlignment="Center"
                                                            HorizontalAlignment="Center" Margin="16,0">
                                                    <local:Glyph Data="{StaticResource IcoMirror}" Size="26" Foreground="{DynamicResource Ink_73}"/>
                                                    <TextBlock x:Name="MirrorStatus" Text="{local:T 'Ligando a câmera…'}" FontSize="12"
                                                               Foreground="{DynamicResource Secondary}" TextWrapping="Wrap"
                                                               TextAlignment="Center" Margin="0,8,0,0"/>
                                                    <Button x:Name="MirrorRetry" Style="{StaticResource ChipButton}" Content="{local:T 'Tentar de novo'}"
                                                            HorizontalAlignment="Center" Margin="0,10,0,0"
                                                            Visibility="Collapsed" Click="MirrorRetry_Click"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Grid>
